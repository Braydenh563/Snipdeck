<?xml version="1.0" encoding="utf-8"?>
<!--
  Snipdeck MSIX manifest TEMPLATE. Do not build from this file as it is.

  Fill the {{PLACEHOLDER}} tokens on a COPY (see packaging/msix/README.md). The Store build takes the
  identity values from Partner Center (Product management > Product identity). A sideload test build
  takes Publisher from the subject of the test certificate. Keep the filled copy out of git.

  Start with Windows: the Store build declares the StartupTask below (TaskId SnipdeckStartup, disabled
  until the user turns it on). The app calls the WinRT StartupTask API for it; the HKCU Run value that the
  portable and Setup builds use is ignored by a packaged app.

  Data: AppData virtualisation is ON (the default; no unvirtualizedResources). The Store build's data is
  per package and is removed when the app is uninstalled; Windows 10 1903+ redirects new AppData files
  into the package's own folder. Do not declare unvirtualizedResources to change that.

  The Assets\ paths below must match the files scripts/make_msix_assets.py writes to packaging\msix\Assets\.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop rescap">

  <!-- {{IDENTITY_NAME}}: the reserved package name, for example YourPublisher.Snipdeck. Copy from Partner Center. -->
  <!-- {{PUBLISHER}}: the CN=... string. Must match exactly what the package is signed with. -->
  <!-- {{ARCH}}: x64 or arm64 (the arch option of scripts/msix_manifest.py). One package per architecture. -->
  <!-- {{VERSION}}: four parts, for example 0.1.0.0. Raise it for every upload. Keep the last part 0 for the Store. -->
  <Identity Name="{{IDENTITY_NAME}}"
            Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}"
            ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>Snipdeck</DisplayName>
    <!-- {{PUBLISHER_DISPLAY_NAME}}: the publisher name from Partner Center. -->
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- MinVersion: the oldest Windows build the app supports (1903, for AppData redirection).
         MaxVersionTested: the newest build the app was run on. 26300 is the owner's Windows 11 PC
         (docs/spikes/windows-results-20261017.md). Raise it only after a run on a newer build. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26300.0" />
  </Dependencies>

  <Resources>
    <!-- One per shipped UI language: English plus every folder in crates/snipdeck-ui/lang/
         (scripts/test_msix_manifest.py checks the two match). -->
    <Resource Language="en-us" />
    <Resource Language="de" />
    <Resource Language="es" />
    <Resource Language="fr" />
    <Resource Language="ja" />
    <Resource Language="pt-BR" />
    <Resource Language="zh-Hans" />
  </Resources>

  <Applications>
    <Application Id="Snipdeck" Executable="snipdeck.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Snipdeck"
                          Description="Sticky-note snippet deck: keep reusable text in cards and paste it into any app."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- File type, URL scheme and command-line alias, from packaging/registration.json (scripts/installer_check.py
             keeps this and snipdeck.iss equal to it). The app takes the file or URL as its first argument. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="snipdeck">
            <uap:DisplayName>Snipdeck archive</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.snipdeck</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="snipdeck">
            <uap:DisplayName>Snipdeck</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="snipdeck.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="snipdeck.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="snipdeck.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="SnipdeckStartup" Enabled="false" DisplayName="Snipdeck" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A Win32 (desktop) app needs full trust: global hotkeys, the tray icon and paste into other apps. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
