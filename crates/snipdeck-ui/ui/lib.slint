// Entry point compiled by `build.rs`: what Rust sees. Components are imported through
// `components.slint` so no unused-export warnings fire; only globals the Rust side sets and the
// gallery windows (rendered by the screenshot tests) are exported.
import { Button } from "components.slint";
export { SystemLook, Palette, Fonts } from "theme.slint";

export { ButtonGallery } from "gallery/buttons.slint";
export { I18nProbe } from "gallery/i18n_probe.slint";

export { PrimitivesGallery, SurfacesGallery, MenuGallery } from "gallery/primitives.slint";

export { TabItem, HotkeyState, TemplateFieldKind, DialogVariant, EmptyStateKind } from "components.slint";
export { InputsGallery, TabsGallery, FormGallery, DialogGallery, EmptyStateGallery } from "gallery/inputs.slint";

export { DeckGallery, DeckScaleGallery, DeckPartsGallery, DeckCjkProbe } from "gallery/deck.slint";
export { ReviewProbe } from "gallery/review_probe.slint";
import { ItemCard, DeckEdge, PinnedStrip, SidebarItem, BoardSwitcher } from "components.slint";

export { PanelWindow, PanelRow, PanelView, ResizeEdge } from "panel.slint";
export { TrayTexts } from "tray_texts.slint";
export { ItemKind, ItemCardVariant, ToastKind, ToastPhase, MenuEntry, PinnedItem } from "components.slint";

export { MainWindow, MainRow, MainSection, MainView, SelectMode, ItemAction, ChoiceEntry } from "main_window.slint";

export { ItemEditor, ListEditor, BoardEditor, TagManager } from "editors.slint";
export { SettingsPage, HotkeySetting, BackupRow } from "settings.slint";
export { FormControlsGallery } from "gallery/forms.slint";
export { PickerWindow, PickerRow, PickerScope } from "picker.slint";
export { TemplateFillWindow, FormField } from "template_fill.slint";
