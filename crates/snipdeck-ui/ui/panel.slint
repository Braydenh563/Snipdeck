// The Panel window (DESIGN.md §5 Panel, ADR-0003, ADR-0008): the compact always-on-top deck the user
// pastes from. It never takes the OS caption: it draws its own header with a drag region, a pin
// (keep on top), a kebab menu and a close button, and its keyboard focus lives in the search field so
// typing always filters. Data comes in as plain structs and models that mirror `snipdeck-app`'s
// `PanelModel` (rows, tabs, footer, use label); every gesture leaves as a callback. Nothing here talks
// to the OS: not the window drag (`drag-requested`), nor the resize (`resize-requested`, fired by
// invisible 6px grips on the four edges and corners), nor the menus (drawn inside the Panel, filled and
// answered by the host).
//
// Keyboard (all handled in `capture-key-pressed` on the window's FocusScope, so they work whichever
// control has focus):
//   type            filters; a printable key typed while another control has focus moves into the search
//   Up / Down       move the selection (PageUp / PageDown a page); Enter uses it, Shift+Enter copies
//   1-9             use the Nth row while the search is empty (digits are text once a query exists)
//   Ctrl+Tab        next list, Ctrl+Shift+Tab previous; Ctrl+F focuses and selects the search
//   Menu, Shift+F10 context menu of the selected row (on the focused kebab button: the Panel menu)
//   Ctrl+K          all commands (the Main window's palette); Ctrl+/ the keyboard shortcuts; F1 the user guide
//   Ctrl+D          duplicate the selected row
//   Ctrl+E, F2      edit / rename the selected row (also a double-click on a row edits it)
//   Delete          delete the selected row while the search is empty (with a query it edits the text)
//   Esc             closes an open menu; else clears the search; with nothing to clear, asks the host to hide the Panel
//
// Tooltips: every icon-only control reports hover and keyboard focus here; the Panel shows one
// `Tooltip` after 500ms, and swaps it instantly while the pointer moves between controls.
import { ListView } from "std-widgets.slint";
import { Theme, Type, Space, Radius, Fonts, SystemLook, Palette } from "theme.slint";
import { Icons } from "icons.slint";
import { ItemCard, ItemKind, ItemCardVariant } from "components/item-card.slint";
import { DeckEdge, DeckEdgePosition } from "components/deck-edge.slint";
import { PinnedStrip, PinnedItem } from "components/pinned-strip.slint";
import { BoardSwitcher } from "components/board-switcher.slint";
import { ListTabBar, TabItem, ClockTab } from "components/tab.slint";
import { Chooser, ChoiceEntry } from "components/chooser.slint";
import { SearchField } from "components/text_field.slint";
import { EmptyState, EmptyStateKind } from "components/empty_state.slint";
import { Toast, ToastKind, ToastPhase, Skeleton, SkeletonKind, Tooltip } from "components/feedback.slint";
import { Menu, MenuEntry } from "components/menu.slint";
import { Button, ButtonVariant, ButtonSize } from "components/button.slint";
import { IconButton } from "components/icon-button.slint";
import { Keycap, KeyCombo } from "components/keycap.slint";
import { DockHandle } from "components/dock-handle.slint";

// One row of the list, as `snipdeck-app`'s `Row`. The quick-use number is the row's position
// (1-9 for the first nine); `masked-preview` stands in for a sensitive item's preview.
export struct PanelRow {
    kind: ItemKind,
    title: string,
    preview: string,
    masked-preview: string,
    extension: string,
    // Mixed views (search): the list the row lives in, with its colour.
    list-name: string,
    list-color: color,
    // The item's colour label (-1 none, else 0 to 7 in the order of `ItemLabel`) and its name.
    label: int,
    label-name: string,
    image: image,
    // 1-based place in the paste stack; 0 = not marked.
    stack-position: int,
}

// One entry of the Recent inbox (SPEC 5.6), as `snipdeck-app`'s `RecentRowView`: the start of the copied text, the
// app it came from (empty = unknown) and whole minutes since the copy.
export struct RecentRow {
    preview: string,
    app: string,
    age-minutes: int,
}

// Per-list view choice (SPEC 5.1): one-line rows or cards with a two-line preview.
export enum PanelView { compact, comfortable }

// The window edge or corner a resize grip sits on; the host starts the OS resize from it.
export enum ResizeEdge { left, right, top, bottom, top-left, top-right, bottom-left, bottom-right }

// An invisible strip that reports a left-button press as a resize from its `edge`.
component ResizeGrip inherits TouchArea {
    in property <ResizeEdge> edge;
    callback resize(ResizeEdge);

    mouse-cursor: root.edge == ResizeEdge.left || root.edge == ResizeEdge.right ? MouseCursor.ew-resize
        : root.edge == ResizeEdge.top || root.edge == ResizeEdge.bottom ? MouseCursor.ns-resize
        : root.edge == ResizeEdge.top-right || root.edge == ResizeEdge.bottom-left ? MouseCursor.nesw-resize
        : MouseCursor.nwse-resize;

    pointer-event(event) => {
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
            root.resize(root.edge);
        }
    }
}

export component PanelWindow inherits Window {
    title: @tr("Snipdeck");
    no-frame: true;
    always-on-top: root.topmost;
    background: Theme.bg-app;
    // A collapsed dock is a strip a few pixels thick: the Panel's minimum size does not apply.
    min-width: root.dock-collapsed ? 0px : 260px;
    max-width: 480px;
    min-height: root.dock-collapsed ? 0px : 240px;
    preferred-width: 320px;
    preferred-height: 480px;

    // ---- State in -----------------------------------------------------------------------------
    in property <bool> dark: false;
    in property <string> board-name;
    in property <[TabItem]> tabs;
    in property <[PinnedItem]> pinned;
    in property <[PanelRow]> rows;
    // The Recent inbox (SPEC 5.6): `recent-available` while clipboard history is on shows the clock tab at the far left
    // of the tab row. `recent-open` is the clock tab being the selected one (the panel sets it; the host is told).
    in property <bool> recent-available: false;
    in-out property <bool> recent-open: false;
    in property <bool> recent-paused: false;
    in property <[RecentRow]> recent-rows;
    // The lists "Save to…" offers.
    in property <[ChoiceEntry]> recent-targets;
    in-out property <int> recent-selected: 0;
    in property <PanelView> view: PanelView.compact;
    // True while the app is loading: skeleton rows replace the empty state.
    in property <bool> loading: false;
    // The sensitive row held revealed by the app (-1 = none).
    in property <int> revealed-index: -1;
    // The window that will receive a paste: empty means a click copies. `target-title` is its caption.
    in property <string> target-name;
    in property <string> target-title;
    // The board menu, drawn inside the Panel; the app fills it and reports its choice.
    in property <bool> board-menu-open: false;
    in property <[MenuEntry]> board-menu-entries;
    // The kebab menu, drawn the same way: the host fills it, sets `app-menu-open` on `app-menu-requested`
    // and clears it on `app-menu-activated` or `app-menu-dismissed`.
    in-out property <bool> app-menu-open: false;
    in property <[MenuEntry]> app-menu-entries;
    // The context menu of a card or pinned chip: the host fills it on `context-menu-requested` /
    // `pinned-context-menu-requested`; the Panel places it at the pointer (`item-menu-x`, `item-menu-y`).
    in property <bool> item-menu-open: false;
    in property <[MenuEntry]> item-menu-entries;
    // The context menu of a list tab (right-click, Menu, Shift+F10, F2 or a double-click edits): the host sets
    // `list-menu-open` on `list-menu-requested`; its rows are fixed here ("Edit list…", "Delete list…").
    in property <bool> list-menu-open: false;
    property <length> list-menu-x: 0px;
    property <length> list-menu-y: 0px;
    property <[MenuEntry]> list-menu-entries: [
        { text: @tr("Edit list…"), icon: Icons.pencil-simple },
        { text: @tr("Delete list…"), icon: Icons.trash, destructive: true },
    ];
    property <length> item-menu-x: 0px;
    property <length> item-menu-y: 0px;
    // Toast: empty text hides it. The app owns its timing (Toast documents the phases).
    in property <string> toast-text;
    in property <ToastKind> toast-kind: ToastKind.neutral;
    in property <ToastPhase> toast-phase: ToastPhase.hold;
    in property <string> toast-undo-label;

    // The edge dock (SPEC 5.1): while `dock-collapsed` the whole window is a `DockHandle`, whose colour is the
    // list on show (`dock-list-color`, when it has an accent) and whose grabber runs along the edge it is on.
    in property <bool> dock-collapsed: false;
    in property <bool> dock-vertical: true;
    in property <bool> dock-has-list-color: false;
    in property <color> dock-list-color: transparent;

    // ---- State both ways ----------------------------------------------------------------------
    in-out property <int> current-tab: 0;
    in-out property <string> query <=> search.text;
    // The keyboard-selected row. The panel moves it itself and reports `selection-moved`; the app
    // writes it back (it resets to 0 when the query changes).
    in-out property <int> selected-index: 0;
    // Keep on top (the pin button).
    in-out property <bool> on-top: true;
    // Whether the window is topmost now (the host: pinned, and no Snipdeck window of the regular kind is active, so
    // the Main window can cover the Panel). Drives the window's `always-on-top`.
    in property <bool> topmost: true;

    // ---- Gestures out -------------------------------------------------------------------------
    callback query-changed(string);
    // Enter, a click, or a quick-use key used row `index`.
    callback row-activated(int);
    // Shift+Enter or Shift+click: copy only.
    callback row-copied(int);
    // Digit 1-9 pressed on an empty search (the app resolves it with `PanelModel::quick_use`).
    callback quick-use(int);
    callback selection-moved(int);
    callback context-menu-requested(int, length, length);
    callback reveal-requested(int, bool);
    callback tab-selected(int);
    // The clock tab was chosen (true) or left for a list tab or by closing it (false).
    callback recent-toggled(bool);
    // Enter or a click on entry `index`: copies its text. Remove: Delete or the menu. Saved: entry, then target.
    callback recent-copied(int);
    callback recent-deleted(int);
    callback recent-saved(int, int);
    callback add-list-requested();
    callback new-item-requested();
    callback settings-requested();
    callback add-from-clipboard();
    callback pinned-used(int);
    callback pinned-copied(int);
    callback pinned-context-menu-requested(int, length, length);
    callback board-menu-requested();
    callback board-menu-activated(int);
    callback board-menu-dismissed();
    callback app-menu-requested();
    // F1: the user guide.
    callback help-requested();
    // Ctrl+K: all commands, in the Main window's palette.
    callback commands-requested();
    // Ctrl+/: the keyboard shortcuts.
    callback shortcuts-requested();
    // The configured Picker hotkey as key caps and spoken, for the footer hint (empty = the hotkey is off).
    in property <[string]> picker-keys;
    in property <string> picker-spoken;
    callback app-menu-activated(int);
    callback app-menu-dismissed();
    // The paste stack (SPEC 5.1): items marked from the item menu, then "Start stack" makes Paste next walk them.
    in property <bool> stack-visible: false;
    in property <bool> stack-running: false;
    in property <int> stack-count: 0;
    in property <int> stack-position: 0;
    in property <string> stack-next-title: "";
    callback stack-started();
    callback stack-ended();
    callback item-menu-activated(int);
    callback item-menu-dismissed();
    callback list-menu-requested(int);
    callback list-menu-activated(int);
    callback list-menu-dismissed();
    callback list-edit-requested(int);
    // Quick edit of row `index`: Ctrl+E or a double-click, F2, Delete (SPEC 5.1). A double-click has
    // already used the row once (the first click); the host decides what the second means.
    callback edit-requested(int);
    // Ctrl+D on row `index`: a copy of the item right after it.
    callback duplicate-requested(int);
    callback rename-requested(int);
    callback delete-requested(int);
    // Pointer down on a resize grip: the host starts the OS resize from that edge or corner.
    callback resize-requested(ResizeEdge);
    callback pin-toggled(bool);
    callback toast-undo();
    callback toast-hover-changed(hovered: bool);
    // Ctrl+Z: undo the delete the toast offers to undo.
    callback undo-requested();
    callback close-requested();
    // Pointer down on the header: the host starts the OS window drag.
    callback drag-requested();
    // The edge dock: the pointer entered or left the collapsed handle, the handle was clicked, and the pointer
    // entered or left the open Panel.
    callback handle-hovered(bool);
    callback handle-clicked();
    callback panel-hovered(bool);

    // ---- Public -------------------------------------------------------------------------------
    // Holds row `index` in its pulled (used) state for the card's 700ms (keyboard use; a click pulls itself).
    public function mark-used(index: int) {
        root.used-index = index;
        used-timer.running = true;
    }
    public function focus-search() {
        search.focus();
    }
    // Scroll offset of the list (<= 0), for tests and for the app to persist.
    out property <length> scroll-y: list.content-y;
    out property <bool> search-focused: search.has-focus;
    // The text of the tooltip on screen (empty = none), for tests and assistive checks.
    out property <string> tooltip-shown: root.tip-open && !root.board-menu-open && !root.app-menu-open && !root.item-menu-open && !root.list-menu-open ? root.tip : "";

    // ---- Internals ----------------------------------------------------------------------------
    property <bool> pastes: root.target-name != "";
    property <string> use-label: root.pastes ? @tr("Paste") : @tr("Copy");
    property <bool> searching: root.query != "";
    // Space is held down to reveal the selected sensitive row.
    property <bool> held-reveal: false;
    // The host hid the text again without a key release (the window lost the focus while Space was
    // held, Alt+Tab): the key is no longer held, so the next press must reveal again.
    changed revealed-index => {
        if (self.revealed-index < 0) {
            self.held-reveal = false;
        }
    }
    property <bool> no-lists: root.tabs.length == 0;
    property <int> sel: root.rows.length == 0 ? -1 : min(max(root.selected-index, 0), root.rows.length - 1);
    property <int> used-index: -1;
    // The Recent list's selection, clamped, and its menus (the row they act on, and where the menu goes).
    property <int> rsel: root.recent-rows.length == 0 ? -1 : min(max(root.recent-selected, 0), root.recent-rows.length - 1);
    property <bool> recent-menu-open: false;
    property <bool> recent-save-open: false;
    property <int> recent-menu-row: 0;
    property <length> recent-menu-x: 0px;
    property <length> recent-menu-y: 0px;
    property <length> header-h: max(Space.s8 + Space.s2, max(Space.hit, Type.line-base + Space.s2) + Space.s2);
    property <length> edge-h: 10px;
    property <length> row-gap: root.view == PanelView.comfortable ? Space.s1 + Space.s0-5 : 0px;
    property <length> avg-row-h: root.rows.length == 0 ? Space.hit : max(Space.hit, list.content-height / root.rows.length);
    property <int> page-rows: max(1, floor(list.height / root.avg-row-h) - 1);

    // The footer drops its route hints below 300px (more at larger text sizes). Set from `changed`
    // handlers, not bound to `root.width`: a window's width follows its layout, so reading it inside
    // the layout would be a binding loop.
    property <length> grip: 6px;
    property <length> grip-corner: Space.s2;

    // Tooltip state (DESIGN.md §4): the control that owns it reports hover or focus through `tip-set`;
    // the text shows after the Tooltip's `show-delay`, but at once when it was just showing another one
    // (`tip-warm`, for a quarter second after one closes).
    property <string> tip;
    property <length> tip-cx;
    property <length> tip-bottom;
    property <bool> tip-open: false;
    property <bool> tip-warm: false;
    function tip-set(text: string, cx: length, bottom: length, on: bool) {
        if (on) {
            root.tip = text;
            root.tip-cx = cx;
            root.tip-bottom = bottom;
            tip-warm-timer.running = false;
            if (root.tip-open || root.tip-warm) {
                tip-timer.running = false;
                root.tip-open = true;
            } else if (!tip-timer.running) {
                tip-timer.running = true;
            }
        } else if (text == root.tip) {
            tip-timer.running = false;
            if (root.tip-open) {
                root.tip-open = false;
                root.tip-warm = true;
                tip-warm-timer.running = true;
            }
        }
    }
    tip-timer := Timer {
        interval: tooltip.show-delay;
        running: false;
        triggered => {
            self.running = false;
            root.tip-open = true;
        }
    }
    tip-warm-timer := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            self.running = false;
            root.tip-warm = false;
        }
    }

    property <bool> narrow: false;
    property <float> text-scale: SystemLook.text-scale;
    function update-narrow() {
        root.narrow = root.width < 300px * root.text-scale;
    }

    init => {
        Palette.dark = root.dark;
        root.update-narrow();
        search.focus();
    }
    changed dark => {
        Palette.dark = root.dark;
    }
    // A closed menu leaves no focused control behind: typing goes to the search again.
    changed app-menu-open => {
        if (!root.app-menu-open) {
            search.focus();
        }
    }
    changed item-menu-open => {
        if (!root.item-menu-open) {
            search.focus();
        }
    }
    changed list-menu-open => {
        if (!root.list-menu-open) {
            search.focus();
        }
    }
    changed board-menu-open => {
        if (!root.board-menu-open) {
            search.focus();
        }
    }
    changed width => {
        root.update-narrow();
    }
    changed text-scale => {
        root.update-narrow();
    }
    // A jump of more than a page lands on a row the ListView has not instantiated yet, so its position
    // is unknown: estimate it from the average row height. Once the row exists, `reveal` places it exactly.
    property <int> last-sel: 0;
    changed sel => {
        let jump = abs(root.sel - root.last-sel) > root.page-rows;
        root.last-sel = root.sel;
        if (root.sel == 0) {
            list.content-y = 0px;
        } else if (root.sel > 0 && jump) {
            let centred = root.sel * root.avg-row-h - (list.height - root.avg-row-h) / 2;
            list.content-y = min(0px, max(list.height - list.content-height, -centred));
        }
    }

    used-timer := Timer {
        interval: 700ms;
        running: false;
        triggered => {
            self.running = false;
            root.used-index = -1;
        }
    }

    // 1-9 -> n, anything else -> 0.
    pure function digit(text: string) -> int {
        return text == "1" ? 1 : text == "2" ? 2 : text == "3" ? 3 : text == "4" ? 4 : text == "5" ? 5
            : text == "6" ? 6 : text == "7" ? 7 : text == "8" ? 8 : text == "9" ? 9 : 0;
    }

    // A key that produces a character: not a control, not one of Slint's private-use special keys.
    pure function printable(text: string) -> bool {
        if (text.character-count != 1) {
            return false;
        }
        return text >= " " && !(text >= "\u{7f}" && text <= "\u{9f}") && !(text >= "\u{e000}" && text <= "\u{f8ff}");
    }

    // Scrolls so that the row [y, y + h) is fully visible, clear of the 10px deck edges.
    function reveal(y: length, h: length) {
        let top = root.sel == 0 ? 0px : root.edge-h;
        let bottom = root.sel == root.rows.length - 1 ? 0px : root.edge-h;
        if (root.sel == 0) {
            list.content-y = 0px;
        } else if (y + list.content-y < top) {
            list.content-y = top - y;
        } else if (y + h + list.content-y > list.height - bottom) {
            list.content-y = list.height - bottom - y - h;
        }
    }

    function move-selection(delta: int) {
        if (root.rows.length == 0) {
            return;
        }
        let next = min(max(root.sel + delta, 0), root.rows.length - 1);
        if (next != root.sel) {
            let actual = next - root.sel;
            root.selected-index = next;
            root.selection-moved(actual);
        }
    }

    function use-selected(copy-only: bool) {
        if (root.sel < 0) {
            return;
        }
        root.mark-used(root.sel);
        if (copy-only) {
            root.row-copied(root.sel);
        } else {
            root.row-activated(root.sel);
        }
    }

    function quick(n: int) {
        if (n < 1 || n > root.rows.length) {
            return;
        }
        root.selected-index = n - 1;
        root.mark-used(n - 1);
        root.quick-use(n);
    }

    pure function ago(minutes: int) -> string {
        return minutes < 1 ? @tr("Just now")
            : minutes < 60 ? @tr("{} min ago", minutes)
            : minutes < 1440 ? @tr("{} h ago", floor(minutes / 60))
            : @tr("{} d ago", floor(minutes / 1440));
    }

    function open-recent() {
        if (!root.recent-available || root.recent-open) {
            return;
        }
        root.recent-open = true;
        root.recent-selected = 0;
        root.recent-toggled(true);
    }

    function close-recent() {
        if (!root.recent-open) {
            return;
        }
        root.recent-open = false;
        root.recent-menu-open = false;
        root.recent-save-open = false;
        root.recent-toggled(false);
    }

    function move-recent(delta: int) {
        if (root.recent-rows.length > 0) {
            root.recent-selected = min(max(root.rsel + delta, 0), root.recent-rows.length - 1);
        }
    }

    function recent-menu-at(row: int, x: length, y: length) {
        root.recent-menu-row = row;
        root.recent-menu-x = x;
        root.recent-menu-y = y;
        root.recent-selected = row;
        root.recent-menu-open = true;
    }

    function recent-save-at(row: int, x: length, y: length) {
        root.recent-menu-row = row;
        root.recent-menu-x = x;
        root.recent-menu-y = y;
        root.recent-selected = row;
        root.recent-menu-open = false;
        root.recent-save-open = true;
    }

    function pick-tab(index: int) {
        root.close-recent();
        root.current-tab = index;
        // A list switch leaves the board-wide search.
        if (root.query != "") {
            root.query = "";
            root.query-changed("");
        }
        root.selected-index = 0;
        list.content-y = 0px;
        root.tab-selected(index);
    }

    function cycle-tab(dir: int) {
        if (root.tabs.length > 1) {
            root.pick-tab(mod(root.current-tab + dir + root.tabs.length, root.tabs.length));
        }
    }

    function clear-query() {
        root.query = "";
        root.selected-index = 0;
        list.content-y = 0px;
        root.query-changed("");
    }

    // Moves a typed character into the search field when another control has focus.
    function type-into-search(text: string) {
        search.focus();
        root.query = root.query + text;
        // Past the end clamps to the end of the text.
        search.set-cursor(1000000);
        root.selected-index = 0;
        list.content-y = 0px;
        root.query-changed(root.query);
    }

    // History switched off (Settings) while the clock tab is open: the tab goes, so its list does too.
    changed recent-available => {
        if (!root.recent-available) {
            root.recent-open = false;
            root.recent-menu-open = false;
            root.recent-save-open = false;
        }
    }

    // Reports the pointer being over the open Panel (anywhere in it, grips and menus included) without
    // taking any click: a TouchArea that is an ancestor sees pointer moves before its children do and
    // forwards them, so every control inside works as before. The edge dock collapses on its leaving.
    panel-area := TouchArea {
        visible: !root.dock-collapsed;
        changed has-hover => { root.panel-hovered(self.has-hover); }

        scope := FocusScope {
            forward-focus: search;

            capture-key-pressed(event) => {
                if (root.board-menu-open || root.app-menu-open || root.item-menu-open || root.list-menu-open || root.recent-menu-open || root.recent-save-open) {
                    // The menu owns the keyboard; Esc closes it.
                    if (event.text == Key.Escape) {
                        root.recent-menu-open = false;
                        root.recent-save-open = false;
                        if (root.item-menu-open) {
                            root.item-menu-dismissed();
                        }
                        if (root.list-menu-open) {
                            root.list-menu-dismissed();
                        }
                        if (root.app-menu-open) {
                            root.app-menu-dismissed();
                        }
                        if (root.board-menu-open) {
                            root.board-menu-dismissed();
                        }
                        return accept;
                    }
                    return reject;
                }
                if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                    if (event.text == Key.Tab && !event.modifiers.shift) {
                        root.cycle-tab(1);
                        return accept;
                    }
                    if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                        root.cycle-tab(-1);
                        return accept;
                    }
                    if (event.text == "f" || event.text == "F") {
                        search.focus();
                        search.select-all();
                        return accept;
                    }
                    if (event.text == "k" || event.text == "K") {
                        root.commands-requested();
                        return accept;
                    }
                    if (event.text == "n" || event.text == "N") {
                        if (event.modifiers.shift) {
                            root.add-list-requested();
                        } else {
                            root.new-item-requested();
                        }
                        return accept;
                    }
                    if (event.text == ",") {
                        root.settings-requested();
                        return accept;
                    }
                    if ((event.text == "w" || event.text == "W") && !event.modifiers.shift) {
                        root.close-requested();
                        return accept;
                    }
                    // Typed text in the search field undoes itself; with an empty field Ctrl+Z is the toast's Undo.
                    if ((event.text == "z" || event.text == "Z") && !event.modifiers.shift && root.query == "") {
                        root.undo-requested();
                        return accept;
                    }
                    if (event.text == "/") {
                        root.shortcuts-requested();
                        return accept;
                    }
                    if ((event.text == "e" || event.text == "E") && root.sel >= 0 && !root.recent-open) {
                        root.edit-requested(root.sel);
                        return accept;
                    }
                    if ((event.text == "d" || event.text == "D") && root.sel >= 0 && !root.recent-open) {
                        root.duplicate-requested(root.sel);
                        return accept;
                    }
                    return reject;
                }
                if (event.modifiers.alt || event.modifiers.meta || search.composing) {
                    return reject;
                }
                if (event.text == Key.F1) {
                    root.help-requested();
                    return accept;
                }
                if (event.text == Key.Escape) {
                    if (root.searching) {
                        root.clear-query();
                    } else if (root.stack-visible) {
                        root.stack-ended();
                    } else {
                        root.close-requested();
                    }
                    return accept;
                }
                if (kebab.has-focus && (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10))) {
                    root.app-menu-requested();
                    return accept;
                }
                if (root.recent-open && !switcher.has-focus) {
                    // The Recent list has its own selection; none of the item shortcuts below apply to it.
                    if (event.text == Key.DownArrow) {
                        root.move-recent(1);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.move-recent(-1);
                        return accept;
                    }
                    if (event.text == Key.PageDown) {
                        root.move-recent(root.page-rows);
                        return accept;
                    }
                    if (event.text == Key.PageUp) {
                        root.move-recent(-root.page-rows);
                        return accept;
                    }
                }
                if (root.recent-open && search.has-focus && root.rsel >= 0) {
                    if (event.text == Key.Return) {
                        root.recent-copied(root.rsel);
                        return accept;
                    }
                    if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                        root.recent-menu-at(root.rsel, Space.s6, deck.absolute-position.y + Space.s8);
                        return accept;
                    }
                    if (event.text == Key.Delete && !root.searching) {
                        root.recent-deleted(root.rsel);
                        return accept;
                    }
                }
                if (event.text == Key.F2 && root.sel >= 0 && !tab-bar.has-focus && !root.recent-open) {
                    root.rename-requested(root.sel);
                    return accept;
                }
                // With a query, Delete is a text key of the search field.
                if (event.text == Key.Delete && root.sel >= 0 && !root.searching && !root.recent-open) {
                    root.delete-requested(root.sel);
                    return accept;
                }
                if (!switcher.has-focus && !root.recent-open) {
                    if (event.text == Key.DownArrow) {
                        root.move-selection(1);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.move-selection(-1);
                        return accept;
                    }
                    if (event.text == Key.PageDown) {
                        root.move-selection(root.page-rows);
                        return accept;
                    }
                    if (event.text == Key.PageUp) {
                        root.move-selection(-root.page-rows);
                        return accept;
                    }
                }
                if (search.has-focus && !root.recent-open) {
                    if (event.text == Key.Return) {
                        root.use-selected(event.modifiers.shift);
                        return accept;
                    }
                    if ((event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) && root.sel >= 0) {
                        root.item-menu-x = Space.s6;
                        root.item-menu-y = deck.absolute-position.y + Space.s8;
                        root.context-menu-requested(root.sel, Space.s6, Space.s8);
                        return accept;
                    }
                }
                // Hold Space on the selected sensitive row reveals it (the cards are not
                // focusable, so their own Space handling never sees the key). With a query,
                // Space is a text key of the search field.
                if (search.has-focus && event.text == " " && !root.searching && root.sel >= 0 && root.sel < root.rows.length && root.rows[root.sel].kind == ItemKind.sensitive && !root.recent-open) {
                    if (!root.held-reveal) {
                        root.held-reveal = true;
                        root.reveal-requested(root.sel, true);
                    }
                    return accept;
                }
                // Digits are quick-use only while there is no query; with one they are search text.
                if (!root.searching && !event.modifiers.shift && root.digit(event.text) > 0 && !root.recent-open) {
                    root.quick(root.digit(event.text));
                    return accept;
                }
                if (!search.has-focus && event.text != " " && root.printable(event.text)) {
                    root.type-into-search(event.text);
                    return accept;
                }
                return reject;
            }

            capture-key-released(event) => {
                if (event.text == " " && root.held-reveal) {
                    root.held-reveal = false;
                    root.reveal-requested(root.sel, false);
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                // ---- Header: board switcher, drag region, keep-on-top, close ----------------------
                Rectangle {
                    height: root.header-h;

                    // Behind the controls: pressing anywhere else starts the window drag.
                    TouchArea {
                        mouse-cursor: MouseCursor.default;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.drag-requested();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: Space.s2;
                        padding-right: Space.s2;
                        padding-top: Space.s1;
                        padding-bottom: Space.s1;
                        spacing: Space.s1;
                        switcher := BoardSwitcher {
                            horizontal-stretch: 0;
                            board-name: root.board-name;
                            menu-open: root.board-menu-open;
                            a11y-label: @tr("Board: {}", root.board-name);
                            y: (parent.height - self.height) / 2;
                            menu-requested => { root.board-menu-requested(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Always-on-top toggle. A diagonal tack (`push-pin-simple`), not the `push-pin`
                        // used on pinned snippets, so it does not read as "pin this item".
                        pin := IconButton {
                            icon: Icons.push-pin-simple;
                            tooltip: @tr("Keep panel on top");
                            active: root.on-top;
                            accessible-checkable: true;
                            accessible-checked: root.on-top;
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                root.on-top = !root.on-top;
                                root.pin-toggled(root.on-top);
                            }
                            changed has-hover => { root.tip-set(self.tooltip, self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height, self.has-hover || self.has-focus); }
                            changed has-focus => { root.tip-set(self.tooltip, self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height, self.has-hover || self.has-focus); }
                        }
                        kebab := IconButton {
                            icon: Icons.dots-three;
                            tooltip: @tr("More");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.app-menu-requested(); }
                            changed has-hover => { root.tip-set(self.tooltip, self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height, self.has-hover || self.has-focus); }
                            changed has-focus => { root.tip-set(self.tooltip, self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height, self.has-hover || self.has-focus); }
                        }
                        close := IconButton {
                            icon: Icons.x;
                            tooltip: @tr("Close panel (Esc)");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.close-requested(); }
                            changed has-hover => { root.tip-set(self.tooltip, self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height, self.has-hover || self.has-focus); }
                            changed has-focus => { root.tip-set(self.tooltip, self.absolute-position.x + self.width / 2, self.absolute-position.y + self.height, self.has-hover || self.has-focus); }
                        }
                    }
                }

                // ---- Search -------------------------------------------------------------------------
                HorizontalLayout {
                    padding-left: Space.s2;
                    padding-right: Space.s2;
                    padding-bottom: Space.s2;
                    search := SearchField {
                        placeholder: @tr("Search snippets");
                        label: @tr("Search snippets");
                        clear-label: @tr("Clear search");
                        edited(text) => {
                            root.selected-index = 0;
                            list.content-y = 0px;
                            root.query-changed(text);
                        }
                    }
                }

                // ---- Lists ----------------------------------------------------------------------------
                HorizontalLayout {
                    padding-left: Space.s2;
                    padding-right: Space.s2;
                    spacing: Space.s0-5;
                    // The Recent inbox, at the far left, while history is on.
                    if root.recent-available: clock-tab := ClockTab {
                        label: @tr("Recent");
                        selected: root.recent-open;
                        clicked => {
                            if (root.recent-open) {
                                root.close-recent();
                            } else {
                                root.open-recent();
                            }
                        }
                    }
                    tab-bar := ListTabBar {
                        none-selected: root.recent-open;
                        tabs: root.tabs;
                        current <=> root.current-tab;
                        label: @tr("Lists");
                        add-label: @tr("Add list");
                        menu-hint: @tr("Right-click or press Menu for list actions");
                        // The "+" is the last 28px of the bar.
                        changed add-active => { root.tip-set(self.add-label, self.absolute-position.x + self.width - Space.hit / 2, self.absolute-position.y + self.height, self.add-active); }
                        selected(index) => { root.pick-tab(index); }
                        add-clicked => { root.add-list-requested(); }
                        menu-requested(index, x, y) => {
                            root.list-menu-x = x;
                            root.list-menu-y = y;
                            root.list-menu-requested(index);
                        }
                        edit-requested(index) => { root.list-edit-requested(index); }
                    }
                }

                if root.pinned.length > 0 && !root.searching && !root.recent-open: HorizontalLayout {
                    padding-left: Space.s2;
                    padding-right: Space.s2;
                    strip := PinnedStrip {
                        items: root.pinned;
                        accessible-role: AccessibleRole.list;
                        accessible-label: @tr("Pinned snippets");
                        scroll-left-label: @tr("Scroll left");
                        scroll-right-label: @tr("Scroll right");
                        tip(text, cx, bottom, on) => { root.tip-set(text, cx, bottom, on); }
                        use(i) => { root.pinned-used(i); }
                        copy(i) => { root.pinned-copied(i); }
                        context-menu-requested(i, x, y) => {
                            // `x` is within the chip: the menu opens under the strip's left end.
                            root.item-menu-x = self.absolute-position.x + Space.s2;
                            root.item-menu-y = self.absolute-position.y + self.height;
                            root.pinned-context-menu-requested(i, x, y);
                        }
                    }
                }

                // ---- The deck ---------------------------------------------------------------------------
                deck := Rectangle {
                    vertical-stretch: 1;
                    min-height: Space.s12;
                    clip: true;

                    // Inset by the focus ring's reach (4px) so the viewport never clips the ring of the selected card.
                    list := ListView {
                        x: Space.s2 - Space.s1;
                        y: 0px;
                        width: parent.width - 2 * Space.s2 + 2 * Space.s1;
                        height: parent.height;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        accessible-label: @tr("Snippets");
                        visible: root.rows.length > 0 && !root.recent-open;

                        for row[i] in root.rows: Rectangle {
                            property <bool> is-selected: i == root.sel;
                            height: card.preferred-height + root.row-gap + (i == root.rows.length - 1 ? 2 * Space.s1 : 0px);

                            init => {
                                if (self.is-selected) { root.reveal(self.y, self.height); }
                            }
                            changed is-selected => {
                                if (self.is-selected) { root.reveal(self.y, self.height); }
                            }
                            changed y => {
                                if (self.is-selected) { root.reveal(self.y, self.height); }
                            }

                            card := ItemCard {
                                x: Space.s1;
                                y: Space.s1;
                                width: parent.width - 2 * Space.s1;
                                height: self.preferred-height;
                                variant: root.view == PanelView.compact ? ItemCardVariant.compact : ItemCardVariant.comfortable;
                                kind: row.kind;
                                number: i < 9 ? i + 1 : 0;
                                title: row.title;
                                preview: row.preview;
                                masked-preview: row.masked-preview;
                                extension: row.extension;
                                image: row.image;
                                list-name: row.list-name;
                                list-color: row.list-color;
                                label: row.label;
                                label-name: row.label-name;
                                stack-position: row.stack-position;
                                selected: i == root.sel;
                                use-label: root.use-label;
                                masked-hint: @tr("Hidden. Hold Space to reveal.");
                                show-use-label: i == root.sel;
                                revealed: i == root.revealed-index;
                                pulling: i == root.used-index;
                                keyboard-focusable: false;
                                use => {
                                    root.selected-index = i;
                                    root.row-activated(i);
                                }
                                copy => {
                                    root.selected-index = i;
                                    root.row-copied(i);
                                }
                                double-clicked => {
                                    root.selected-index = i;
                                    root.edit-requested(i);
                                }
                                context-menu-requested(x, y) => {
                                    root.item-menu-x = self.absolute-position.x + x;
                                    root.item-menu-y = self.absolute-position.y + y;
                                    root.context-menu-requested(i, x, y);
                                }
                                reveal-requested(on) => { root.reveal-requested(i, on); }
                            }
                        }
                    }

                    // More cards below (or above) the fold: two card edges, never a fade.
                    if root.rows.length > 0 && !root.recent-open && list.content-y < -1px: DeckEdge {
                        position: DeckEdgePosition.top;
                        x: Space.s2;
                        y: Space.s1;
                        width: parent.width - 2 * Space.s2;
                    }
                    if root.rows.length > 0 && !root.recent-open && list.content-height + list.content-y > list.height + 1px: DeckEdge {
                        position: DeckEdgePosition.bottom;
                        x: Space.s2;
                        y: parent.height - self.height;
                        width: parent.width - 2 * Space.s2;
                    }

                    // ---- The Recent inbox: what was copied lately; click copies, "Save to…" keeps it in a list --------
                    if root.recent-open: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        recent-list := ListView {
                            x: Space.s2 - Space.s1;
                            y: 0px;
                            width: parent.width - 2 * Space.s2 + 2 * Space.s1;
                            height: parent.height;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            accessible-label: @tr("Recent copies");
                            visible: root.recent-rows.length > 0;

                            for entry[i] in root.recent-rows: Rectangle {
                                height: rcard.preferred-height + root.row-gap + (i == root.recent-rows.length - 1 ? 2 * Space.s1 : 0px);

                                rcard := ItemCard {
                                    x: Space.s1;
                                    y: Space.s1;
                                    width: parent.width - 2 * Space.s1;
                                    height: self.preferred-height;
                                    variant: root.view == PanelView.compact ? ItemCardVariant.compact : ItemCardVariant.comfortable;
                                    kind: ItemKind.text;
                                    preview: entry.preview;
                                    list-name: entry.app == "" ? root.ago(entry.age-minutes) : entry.app + " · " + root.ago(entry.age-minutes);
                                    list-color: transparent;
                                    selected: i == root.rsel;
                                    use-label: @tr("Copy");
                                    show-use-label: i == root.rsel;
                                    keyboard-focusable: false;
                                    use => {
                                        root.recent-selected = i;
                                        root.recent-copied(i);
                                    }
                                    copy => {
                                        root.recent-selected = i;
                                        root.recent-copied(i);
                                    }
                                    double-clicked => {
                                        root.recent-save-at(i, self.absolute-position.x + Space.s6, self.absolute-position.y + self.height);
                                    }
                                    context-menu-requested(x, y) => {
                                        root.recent-menu-at(i, self.absolute-position.x + x, self.absolute-position.y + y);
                                    }
                                }
                            }
                        }
                        if root.recent-rows.length == 0: EmptyState {
                            x: Space.s2;
                            width: parent.width - 2 * Space.s2;
                            height: parent.height;
                            kind: EmptyStateKind.inbox;
                            heading: root.recent-paused ? @tr("History is paused") : @tr("Nothing copied yet");
                            body: root.recent-paused ? @tr("Resume it from the tray icon, then copy some text.")
                                : @tr("Text you copy shows up here for a week. Save the useful ones to a list.");
                            action-text: "";
                        }
                    }

                    if root.loading: VerticalLayout {
                        x: Space.s2;
                        y: Space.s1;
                        width: parent.width - 2 * Space.s2;
                        alignment: start;
                        for n in [0, 1, 2, 3, 4, 5]: Skeleton {
                            kind: SkeletonKind.row;
                            label: n == 0 ? @tr("Loading") : "";
                        }
                    }

                    if root.rows.length == 0 && !root.loading && !root.recent-open: EmptyState {
                        x: Space.s2;
                        width: parent.width - 2 * Space.s2;
                        height: parent.height;
                        kind: root.no-lists ? EmptyStateKind.board : root.searching ? EmptyStateKind.search : EmptyStateKind.list;
                        heading: root.no-lists ? @tr("No lists yet")
                            : root.searching ? @tr("No matches") : @tr("This list is empty");
                        body: root.no-lists ? @tr("A list keeps related snippets together, like replies or addresses.")
                            : root.searching ? @tr("Nothing on this board matches “{}”.", root.query)
                            : @tr("Copy something, then save it here from the clipboard.");
                        action-text: root.no-lists ? @tr("New list") : root.searching ? "" : @tr("Save from clipboard");
                        action => {
                            if (root.no-lists) {
                                root.add-list-requested();
                            } else {
                                root.add-from-clipboard();
                            }
                        }
                    }

                    if root.toast-text != "": Toast {
                        text: root.toast-text;
                        kind: root.toast-kind;
                        phase: root.toast-phase;
                        undo-label: root.toast-undo-label;
                        width: min(self.preferred-width, parent.width - 2 * Space.s2);
                        height: self.preferred-height;
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - Space.s2;
                        undo => { root.toast-undo(); }
                        hover-changed(h) => { root.toast-hover-changed(h); }
                    }
                }

                // ---- Paste stack: the marked items, and Start / End ---------------------------------------
                if root.stack-visible: Rectangle {
                    height: max(Space.s8, Type.line-sm + Space.s3);
                    background: Theme.accent-subtle;
                    accessible-role: AccessibleRole.text;
                    accessible-label: root.stack-running
                        ? @tr("Paste stack, item {} of {}, next: {}", root.stack-position + 1, root.stack-count, root.stack-next-title)
                        : @tr("Paste stack, {} marked", root.stack-count);
                    HorizontalLayout {
                        padding-left: Space.s3;
                        padding-right: Space.s2;
                        spacing: Space.s2;
                        Text {
                            horizontal-stretch: 1;
                            text: root.stack-running
                                ? @tr("{} of {} · next: {}", root.stack-position + 1, root.stack-count, root.stack-next-title)
                                : @tr("Paste stack: {} marked", root.stack-count);
                            font-family: Fonts.sans;
                            font-size: Type.sm;
                            color: Theme.accent-text;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: AccessibleRole.none;
                        }
                        if !root.stack-running: Button {
                            text: @tr("Start stack");
                            size: ButtonSize.sm;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.stack-started(); }
                        }
                        Button {
                            text: root.stack-running ? @tr("End stack") : @tr("Clear");
                            variant: ButtonVariant.ghost;
                            size: ButtonSize.sm;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.stack-ended(); }
                        }
                    }
                }

                // ---- Target footer (DESIGN.md §5): always shows where a click goes -----------------------
                Rectangle {
                    height: max(Space.s8, Type.line-sm + Space.s3);
                    accessible-role: AccessibleRole.text;
                    accessible-label: root.pastes
                        ? (root.target-title != "" ? @tr("Pastes into {} · {}", root.target-name, root.target-title) : @tr("Pastes into {}", root.target-name))
                        : @tr("Copies to clipboard");

                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                    HorizontalLayout {
                        padding-left: Space.s3;
                        padding-right: Space.s3;
                        spacing: Space.s2;
                        Text {
                            horizontal-stretch: 1;
                            text: root.pastes
                                ? (root.target-title != "" ? @tr("Pastes into {} · {}", root.target-name, root.target-title) : @tr("Pastes into {}", root.target-name))
                                : @tr("Copies to clipboard");
                            font-family: Fonts.sans;
                            font-size: Type.sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: AccessibleRole.none;
                        }
                        // Route hints: Enter uses, and Shift+Enter always copies. Hidden when the Panel is narrow.
                        if !root.narrow: HorizontalLayout {
                            spacing: Space.s1;
                            Rectangle {
                                width: hint-keys.min-width;
                                hint-keys := KeyCombo {
                                    keys: root.pastes ? ["Shift", "↵"] : ["↵"];
                                    label: root.pastes ? @tr("Shift Enter") : @tr("Enter");
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            Text {
                                text: @tr("Copy");
                                font-family: Fonts.sans;
                                font-size: Type.sm;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                accessible-role: AccessibleRole.none;
                            }
                        }
                        // The Picker's hotkey, as the user set it: a hint that it works anywhere, not only here.
                        if !root.narrow && root.picker-keys.length > 0: HorizontalLayout {
                            spacing: Space.s1;
                            Rectangle {
                                width: picker-caps.min-width;
                                picker-caps := KeyCombo {
                                    keys: root.picker-keys;
                                    label: root.picker-spoken;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            Text {
                                text: @tr("Picker anywhere");
                                font-family: Fonts.sans;
                                font-size: Type.sm;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                accessible-role: AccessibleRole.text;
                            }
                        }
                    }
                }
            }
        }

        // ---- The board menu: a scrim that dismisses on click, and the menu under the header ----------
        if root.board-menu-open: TouchArea {
            clicked => { root.board-menu-dismissed(); }
        }
        if root.board-menu-open: Menu {
            x: Space.s2;
            y: root.header-h - Space.s1;
            entries: root.board-menu-entries;
            label: @tr("Boards");
            icons: false;
            init => { self.focus-menu(); }
            activated(i) => { root.board-menu-activated(i); }
            dismissed => { root.board-menu-dismissed(); }
        }

        // ---- The Panel menu (kebab): right-aligned under the button, kept inside the window --------------
        if root.app-menu-open: TouchArea {
            clicked => { root.app-menu-dismissed(); }
        }
        if root.app-menu-open: Menu {
            x: min(max(Space.s2, kebab.absolute-position.x + kebab.width - self.width), root.width - self.width - Space.s2);
            y: root.header-h - Space.s1;
            entries: root.app-menu-entries;
            label: @tr("Panel menu");
            init => { self.focus-menu(); }
            activated(i) => { root.app-menu-activated(i); }
            dismissed => { root.app-menu-dismissed(); }
        }

        // ---- The item menu (right-click, Menu key, Shift+F10 on a card or chip): at the pointer, kept inside the window.
        if root.item-menu-open: TouchArea {
            clicked => { root.item-menu-dismissed(); }
        }
        if root.item-menu-open: Menu {
            x: min(max(Space.s2, root.item-menu-x), root.width - self.width - Space.s2);
            y: min(max(Space.s2, root.item-menu-y), root.height - self.height - Space.s2);
            entries: root.item-menu-entries;
            label: @tr("Item actions");
            icons: false;
            init => { self.focus-menu(); }
            activated(i) => { root.item-menu-activated(i); }
            dismissed => { root.item-menu-dismissed(); }
        }

        // ---- The list menu (right-click, Menu, Shift+F10 on a list tab): at the pointer, kept inside the window.
        if root.list-menu-open: TouchArea {
            clicked => { root.list-menu-dismissed(); }
        }
        if root.list-menu-open: Menu {
            x: min(max(Space.s2, root.list-menu-x), root.width - self.width - Space.s2);
            y: min(max(Space.s2, root.list-menu-y), root.height - self.height - Space.s2);
            entries: root.list-menu-entries;
            label: @tr("List actions");
            init => { self.focus-menu(); }
            activated(i) => { root.list-menu-activated(i); }
            dismissed => { root.list-menu-dismissed(); }
        }

        // ---- The Recent entry menu (right-click, Menu, Shift+F10) and its "Save to…" chooser: at the pointer.
        if root.recent-menu-open || root.recent-save-open: TouchArea {
            clicked => {
                root.recent-menu-open = false;
                root.recent-save-open = false;
            }
        }
        if root.recent-menu-open: Menu {
            x: min(max(Space.s2, root.recent-menu-x), root.width - self.width - Space.s2);
            y: min(max(Space.s2, root.recent-menu-y), root.height - self.height - Space.s2);
            entries: [
                { text: @tr("Save to…"), icon: Icons.folder },
                { text: @tr("Copy"), icon: Icons.copy },
                { text: @tr("Remove from Recent"), icon: Icons.trash, destructive: true },
            ];
            label: @tr("Recent entry actions");
            init => { self.focus-menu(); }
            activated(i) => {
                root.recent-menu-open = false;
                if (i == 0) {
                    root.recent-save-open = true;
                } else if (i == 1) {
                    root.recent-copied(root.recent-menu-row);
                } else {
                    root.recent-deleted(root.recent-menu-row);
                }
            }
            dismissed => { root.recent-menu-open = false; }
        }
        if root.recent-save-open: Chooser {
            x: min(max(Space.s2, root.recent-menu-x), root.width - self.width - Space.s2);
            y: min(max(Space.s2, root.recent-menu-y), root.height - self.height - Space.s2);
            width: min(240px, root.width - 2 * Space.s2);
            entries: root.recent-targets;
            label: @tr("Save to…");
            empty-text: @tr("No lists yet");
            init => {
                self.current = 0;
                self.focus-chooser();
            }
            chosen(i) => {
                root.recent-save-open = false;
                root.recent-saved(root.recent-menu-row, i);
            }
            dismissed => { root.recent-save-open = false; }
        }

        // The tooltip of whichever icon-only control is hovered or focused, centred under it and kept
        // inside the window. Above the menus' scrims, below nothing; it never takes pointer or focus.
        tooltip := Tooltip {
            text: root.tip;
            open: root.tooltip-shown != "";
            width: self.preferred-width;
            height: self.preferred-height;
            x: min(max(Space.s2, root.tip-cx - self.width / 2), root.width - self.width - Space.s2);
            y: root.tip-bottom + Space.s1;
        }

        // ---- Resize grips: invisible, last so they sit above the header's drag area and the menus' scrims.
        // Rows start 8px in and the header buttons 8px in from the right, so none of this overlaps a control.
        ResizeGrip {
            edge: ResizeEdge.left;
            x: 0px;
            y: root.grip-corner;
            width: root.grip;
            height: root.height - 2 * root.grip-corner;
            resize(e) => { root.resize-requested(e); }
        }
        ResizeGrip {
            edge: ResizeEdge.right;
            x: root.width - root.grip;
            y: root.grip-corner;
            width: root.grip;
            height: root.height - 2 * root.grip-corner;
            resize(e) => { root.resize-requested(e); }
        }
        ResizeGrip {
            edge: ResizeEdge.top;
            x: root.grip-corner;
            y: 0px;
            width: root.width - 2 * root.grip-corner;
            height: root.grip;
            resize(e) => { root.resize-requested(e); }
        }
        ResizeGrip {
            edge: ResizeEdge.bottom;
            x: root.grip-corner;
            y: root.height - root.grip;
            width: root.width - 2 * root.grip-corner;
            height: root.grip;
            resize(e) => { root.resize-requested(e); }
        }
        ResizeGrip {
            edge: ResizeEdge.top-left;
            x: 0px;
            y: 0px;
            width: root.grip-corner;
            height: root.grip-corner;
            resize(e) => { root.resize-requested(e); }
        }
        ResizeGrip {
            edge: ResizeEdge.top-right;
            x: root.width - root.grip-corner;
            y: 0px;
            width: root.grip-corner;
            height: root.grip-corner;
            resize(e) => { root.resize-requested(e); }
        }
        ResizeGrip {
            edge: ResizeEdge.bottom-left;
            x: 0px;
            y: root.height - root.grip-corner;
            width: root.grip-corner;
            height: root.grip-corner;
            resize(e) => { root.resize-requested(e); }
        }
        ResizeGrip {
            edge: ResizeEdge.bottom-right;
            x: root.width - root.grip-corner;
            y: root.height - root.grip-corner;
            width: root.grip-corner;
            height: root.grip-corner;
            resize(e) => { root.resize-requested(e); }
        }

        // The window outline: level 3 is the OS shadow plus a 1px `border-default` (DESIGN.md §6).
        Rectangle {
            border-width: 1px;
            border-color: Theme.border-default;
            background: transparent;
        }
    }

    // The collapsed dock: a strip over the whole window, in the colour of the list on show.
    if root.dock-collapsed: DockHandle {
        width: root.width;
        height: root.height;
        accent: root.dock-has-list-color && !SystemLook.high-contrast ? root.dock-list-color : Theme.accent;
        vertical: root.dock-vertical;
        label: @tr("Snipdeck handle, press the Panel hotkey to open");
        hovered(on) => { root.handle-hovered(on); }
        clicked => { root.handle-clicked(); }
    }
}
