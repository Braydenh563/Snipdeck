// The words of the Troubleshoot checks. The doctor (`snipdeck_app::doctor`) finds facts, and Rust
// cannot reach the translation catalogs, so the Help binding calls these functions and gets the
// label and the sentence in the language selected for the UI. English lives in the copied report only.
export global DoctorTexts {
    // The name of check `index` (the order of `doctor::LABELS`).
    pure public function label(index: int) -> string {
        if (index == 0) { return @tr("Data folder"); }
        if (index == 1) { return @tr("Library"); }
        if (index == 2) { return @tr("Backups"); }
        if (index == 3) { return @tr("Encryption key"); }
        if (index == 4) { return @tr("Shortcuts"); }
        if (index == 5) { return @tr("Tray icon"); }
        if (index == 6) { return @tr("Crash reports"); }
        return @tr("Typed triggers");
    }

    // What a check found: `kind` is `doctor::Detail::code`, `a`, `b` and `c` are its facts.
    pure public function detail(kind: int, a: string, b: string, c: string) -> string {
        if (kind == 0) { return @tr("Snipdeck cannot write to its data folder: {}", a); }
        if (kind == 1) { return @tr("Writable, but only {} MB are free on its drive.", a); }
        if (kind == 2) { return @tr("Writable, with room to spare."); }
        if (kind == 3) { return @tr("The integrity check could not run: {}", a); }
        if (kind == 4) { return @tr("The integrity check found no problems."); }
        if (kind == 5) { return @tr("The integrity check found {} problem(s); the first: {}", a, b); }
        if (kind == 6) { return @tr("The backups cannot be read: {}", a); }
        if (kind == 7) { return @tr("No backup has been made yet."); }
        if (kind == 8) { return @tr("The newest backup is from {}, {} days ago ({} kept).", a, b, c); }
        if (kind == 9) { return @tr("Newest backup {}, {} kept.", a, b); }
        if (kind == 10) { return @tr("The items cannot be read: {}", a); }
        if (kind == 11) { return @tr("No item is marked sensitive."); }
        if (kind == 12) { return @tr("{} sensitive item(s), the key is present.", a); }
        if (kind == 13) { return @tr("{} sensitive item(s) are stored as plain text (no encryption key yet): masked and readable, but not encrypted.", a); }
        if (kind == 14) { return @tr("The key cannot be checked: {}", a); }
        if (kind == 15) { return @tr("All global shortcuts are set."); }
        if (kind == 16) { return @tr("No global shortcut is set."); }
        if (kind == 17) { return @tr("Not set: {}.", a); }
        if (kind == 18) { return @tr("The icon is in the notification area."); }
        if (kind == 19) { return @tr("No icon in the notification area; closing the panel quits Snipdeck."); }
        if (kind == 20) { return @tr("No crash report."); }
        if (kind == 21) { return @tr("The newest crash report is {}.", a); }
        if (kind == 22) { return @tr("Not checked from the command line."); }
        if (kind == 23) { return @tr("No typed trigger was skipped since Snipdeck started."); }
        // The reason a typed trigger was skipped: one English sentence from the controller, not yet translated.
        return a;
    }
}
