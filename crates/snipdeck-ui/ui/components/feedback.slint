import { Theme, Type, Radius, Space, Motion, SystemLook, Fonts } from "../theme.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons.slint";

// Render-only feedback surfaces: Tooltip, Toast, Skeleton (DESIGN.md §4). The host owns timing.

export { Tooltip } from "tooltip.slint";

export enum ToastKind { neutral, success, danger }

// Where the toast is in its life. The host creates it hidden (`exit`), sets `enter` (fades in over
// `Motion.quick`), then `hold` once settled (stays `hold-duration`), then `exit` (fades out in 90ms).
export enum ToastPhase { enter, hold, exit }

// One action button of the ink toast: label in `toast.action`, a 2px ring while it has the keyboard focus.
component ToastButton inherits Rectangle {
    in property <string> label;
    out property <bool> focused: ink-scope.has-focus;
    callback activated();
    width: ink-action.preferred-width + 2 * Space.s2 + Space.s0-5;
    ink-btn := Rectangle {
        width: parent.width;
        height: Space.s6 + Space.s1;
        y: (parent.height - self.height) / 2;
        border-radius: Radius.md;
        background: ink-touch.pressed ? Theme.ink-pressed : ink-touch.has-hover ? Theme.ink-hover : transparent;
        forward-focus: ink-scope;
        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { root.activated(); }
        ink-action := Text {
            x: Space.s2 + Space.s0-5 / 2;
            width: self.preferred-width;
            height: parent.height;
            text: root.label;
            color: Theme.toast-action;
            font-family: Fonts.sans;
            font-size: Type.sm;
            font-weight: Type.medium;
            vertical-alignment: center;
            accessible-role: none;
        }
        Rectangle {
            border-width: ink-scope.has-focus ? 2px : 0px;
            border-color: Theme.toast-action;
            border-radius: Radius.md;
            background: transparent;
        }
        ink-touch := TouchArea { clicked => { root.activated(); } }
        ink-scope := FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == " " || event.text == "\n") {
                    root.activated();
                    return accept;
                }
                return reject;
            }
        }
    }
}

// DESIGN.md §4 Toast, the ink toast (Panel v2 spec 2.8): 40 tall, `ink.default` fill, `text.on-ink`, radius 8, the action
// in `toast.action`. Transient results ("Copied", "Pasted into Notepad"); the kind is carried by an icon only for success
// (check) and danger (warning), neutral has none. A non-empty `undo-label` adds an action button. Announced politely.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <ToastKind> kind: ToastKind.neutral;
    in property <ToastPhase> phase: ToastPhase.hold;
    // Label of the action button, translated by the host. Empty hides the button.
    in property <string> undo-label;
    // Label of the second action button (Edit), translated by the host. Empty hides the button.
    in property <string> edit-label;
    // DESIGN.md §4: the host keeps a toast in `hold` for this long.
    out property <duration> hold-duration: 2500ms;
    callback undo();
    callback edit();
    // The pointer is on the toast or its button has focus: the host keeps the toast up while it is.
    callback hover-changed(hovered: bool);

    // An ancestor TouchArea keeps its hover while the pointer is on a child, so the toast does not
    // flicker as the pointer crosses onto the action, and the button still gets its clicks.
    property <bool> button-focus: root.undo-focus || root.edit-focus;
    property <bool> undo-focus: false;
    property <bool> edit-focus: false;
    property <bool> over: area.has-hover || root.button-focus;
    changed over => { root.hover-changed(root.over); }
    property <bool> has-icon: root.kind != ToastKind.neutral;

    background: Theme.ink;
    border-radius: Radius.lg;
    opacity: root.phase == ToastPhase.exit ? 0.0 : 1.0;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-live-region: polite;

    animate opacity { duration: root.phase == ToastPhase.exit ? Motion.fade : Motion.quick; easing: Motion.out; }

    preferred-width: row.preferred-width;
    preferred-height: Space.s8 + Space.s2;

    area := TouchArea {
        row := HorizontalLayout {
            padding-left: Space.s3;
            padding-right: (root.undo-label != "" || root.edit-label != "") ? Space.s1 : Space.s3;
            spacing: Space.s2;
            if root.has-icon: Rectangle {
                width: 16px;
                Icon {
                    source: root.kind == ToastKind.success ? Icons.check-circle : Icons.warning;
                    tint: Theme.text-on-ink;
                    y: (parent.height - self.height) / 2;
                }
            }
            Text {
                text: root.text;
                color: Theme.text-on-ink;
                font-family: Fonts.sans;
                font-size: Type.sm;
                vertical-alignment: center;
                wrap: TextWrap.no-wrap;
                overflow: elide;
            }
            // Each button's wrapper takes the layout's full height so the button inside centres on the message (a layout ignores `y`).
            if root.undo-label != "": undo-button := ToastButton {
                label: root.undo-label;
                activated => { root.undo(); }
                changed focused => { root.undo-focus = self.focused; }
            }
            if root.edit-label != "": edit-button := ToastButton {
                label: root.edit-label;
                activated => { root.edit(); }
                changed focused => { root.edit-focus = self.focused; }
            }
        }
    }
}

export enum SkeletonKind { row, tile }

// DESIGN.md §4 Skeleton: placeholder matching the final shape. `row` is a compact 28px item row;
// `tile` is a main-window grid card. A gentle opacity pulse, off under reduced motion (the shape
// alone says "loading"). `label` is the spoken status ("Loading"); the host translates it.
export component Skeleton inherits Rectangle {
    in property <SkeletonKind> kind: SkeletonKind.row;
    in property <string> label;

    // 1.0 under reduced motion; otherwise a slow sine between 0.65 and 1.0 (1.6s period).
    out property <float> pulse: SystemLook.reduced-motion
        ? 1.0
        : 0.825 + 0.175 * sin(animation-tick() / 1600ms * 360deg);

    // Bars: `bg-hover` is too faint on dark surfaces, so dark uses `bg-overlay-hover`.
    property <color> bar: Theme.dark ? Theme.bg-overlay-hover : Theme.border-subtle;

    min-width: 120px;
    height: root.kind == SkeletonKind.row ? 28px : 104px;
    background: root.kind == SkeletonKind.tile ? Theme.bg-surface : transparent;
    border-radius: Radius.lg;
    border-width: root.kind == SkeletonKind.tile ? 1px : 0px;
    border-color: Theme.border-subtle;
    opacity: root.pulse;
    accessible-role: progress-indicator;
    accessible-label: root.label;

    if root.kind == SkeletonKind.row: Rectangle {
        x: Space.s2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        background: root.bar;
        border-radius: Radius.sm;
        border-width: Theme.hc-border != transparent ? 1px : 0px;
        border-color: Theme.hc-border;
    }
    if root.kind == SkeletonKind.row: Rectangle {
        x: Space.s2 + 16px + Space.s2;
        y: (parent.height - self.height) / 2;
        width: (parent.width - self.x - Space.s2) * 0.55;
        height: 10px;
        background: root.bar;
        border-radius: Radius.sm;
        border-width: Theme.hc-border != transparent ? 1px : 0px;
        border-color: Theme.hc-border;
    }
    if root.kind == SkeletonKind.tile: Rectangle {
        x: Space.s3;
        y: Space.s3;
        width: (parent.width - 2 * Space.s3) * 0.6;
        height: 12px;
        background: root.bar;
        border-radius: Radius.sm;
        border-width: Theme.hc-border != transparent ? 1px : 0px;
        border-color: Theme.hc-border;
    }
    if root.kind == SkeletonKind.tile: Rectangle {
        x: Space.s3;
        y: Space.s3 + 12px + Space.s3;
        width: parent.width - 2 * Space.s3;
        height: 8px;
        background: root.bar;
        border-radius: Radius.sm;
        border-width: Theme.hc-border != transparent ? 1px : 0px;
        border-color: Theme.hc-border;
    }
    if root.kind == SkeletonKind.tile: Rectangle {
        x: Space.s3;
        y: Space.s3 + 12px + Space.s3 + 8px + Space.s2;
        width: (parent.width - 2 * Space.s3) * 0.85;
        height: 8px;
        background: root.bar;
        border-radius: Radius.sm;
        border-width: Theme.hc-border != transparent ? 1px : 0px;
        border-color: Theme.hc-border;
    }
    if root.kind == SkeletonKind.tile: Rectangle {
        x: Space.s3;
        y: Space.s3 + 12px + Space.s3 + 8px + Space.s2 + 8px + Space.s2;
        width: (parent.width - 2 * Space.s3) * 0.4;
        height: 8px;
        background: root.bar;
        border-radius: Radius.sm;
        border-width: Theme.hc-border != transparent ? 1px : 0px;
        border-color: Theme.hc-border;
    }
}
