import { Theme, Type, Space, Radius, Motion, Fonts, SystemLook } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "icon.slint";

export enum SidebarItemKind { board, list, tag, system }

// DESIGN.md §4 SidebarItem: main-window navigation. board = stack glyph, list = 8px square mark in the
// list colour, tag = tag glyph, system (Recent, Pinned, Trash...) = the `icon` the app passes.
// The row is 28px tall (hit target); the count is tabular `type.xs`.
// `rail` is the 48px icon rail the sidebar collapses to below 720px (DESIGN.md §8): only the glyph or mark is
// drawn, centred; the label stays the accessible name. A list that owns the keyboard cursor itself (the
// sidebar's roving focus) sets `keyboard-focusable: false` and draws the ring with `show-focus`.
export component SidebarItem inherits Rectangle {
    in property <SidebarItemKind> kind: SidebarItemKind.list;
    in property <string> label;
    // Hidden when negative.
    in property <int> count: -1;
    // System items: the glyph. Lists: their own icon, drawn after the colour mark (an empty image is none).
    // Tags and boards ignore it.
    in property <image> icon;
    // List items: the list colour (the 8px mark).
    in property <color> mark-color;
    in property <bool> selected: false;
    // Nested rows (lists under a board) indent by one step.
    in property <bool> indented: false;
    in property <bool> rail: false;
    in property <bool> keyboard-focusable: true;
    in property <bool> show-focus: false;
    // A dragged row or list hovers over this one: it would land here.
    in property <bool> drop-target: false;
    callback clicked();
    callback context-menu-requested(length, length);

    property <length> mark-size: Space.s2 * SystemLook.text-scale;
    property <length> glyph-size: Space.s4 * SystemLook.text-scale;
    property <bool> list-icon-shown: root.kind == SidebarItemKind.list && root.icon.width > 0;
    property <length> lead-width: root.glyph-size + (root.list-icon-shown ? Space.s1 + root.glyph-size : 0px);
    property <bool> hovered: touch.has-hover;
    property <bool> focused: scope.has-focus || root.show-focus;
    property <image> glyph: root.kind == SidebarItemKind.board ? Icons.stack
        : root.kind == SidebarItemKind.tag ? Icons.tag : root.icon;

    height: max(Space.hit, Type.line-base + Space.s2);
    border-radius: Radius.md;
    background: touch.pressed ? Theme.bg-sunken : root.selected ? Theme.bg-selected : root.hovered ? Theme.bg-hover : transparent;
    border-width: root.drop-target ? 2px : Theme.hc-border != transparent ? 1px : 0px;
    border-color: root.drop-target ? Theme.focus-ring : Theme.hc-border;
    forward-focus: scope;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-value: root.count >= 0 ? "\{root.count}" : "";
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    animate background { duration: Motion.instant; easing: Motion.out; }

    HorizontalLayout {
        padding-left: root.rail ? 0px : Space.s2 + (root.indented ? Space.s4 : 0px);
        padding-right: root.rail ? 0px : Space.s2;
        spacing: Space.s2;

        Rectangle {
            width: root.rail ? root.width : root.lead-width;
            if root.kind == SidebarItemKind.list: HorizontalLayout {
                alignment: root.rail ? center : start;
                spacing: Space.s1;
                Rectangle {
                    width: root.rail ? root.mark-size : root.glyph-size;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.mark-size;
                        height: root.mark-size;
                        background: root.mark-color;
                    }
                }
                if root.list-icon-shown: Rectangle {
                    width: root.glyph-size;
                    Icon {
                        source: root.icon;
                        tint: root.selected ? Theme.accent-on-selected : Theme.text-secondary;
                        size: root.glyph-size;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            if root.kind != SidebarItemKind.list && root.glyph.width > 0: Icon {
                source: root.glyph;
                tint: root.selected ? Theme.accent-on-selected : Theme.text-secondary;
                size: root.glyph-size;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        if !root.rail: Text {
            text: root.label;
            font-family: Fonts.sans;
            font-size: Type.base;
            font-weight: root.selected ? Type.medium : Type.regular;
            color: root.selected ? Theme.text-on-selected : Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.rail && root.count >= 0: Text {
            horizontal-stretch: 0;
            text: "\{root.count}";
            font-family: Fonts.mono;
            font-size: Type.xs;
            color: root.selected ? Theme.text-secondary-on-selected : Theme.text-secondary;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    // 2px ring, 2px offset (DESIGN.md §2), keyboard focus only.
    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-width: root.focused ? 2px : 0px;
        border-color: Theme.focus-ring;
        border-radius: Radius.md + 2px;
        background: transparent;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                if (event.button == PointerEventButton.left) {
                    if (touch.mouse-x >= 0 && touch.mouse-x <= touch.width && touch.mouse-y >= 0 && touch.mouse-y <= touch.height) {
                        root.clicked();
                    }
                } else if (event.button == PointerEventButton.right) {
                    root.context-menu-requested(touch.mouse-x, touch.mouse-y);
                }
            }
        }
    }

    scope := FocusScope {
        enabled: root.keyboard-focusable;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                root.context-menu-requested(0px, root.height);
                return accept;
            }
            return reject;
        }
    }
}
