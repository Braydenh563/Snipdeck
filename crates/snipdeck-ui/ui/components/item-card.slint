        visible: false;
        text: root.list-name;
        font-family: Fonts.sans;
        font-size: Type.xs;
    }
    m-ext := Text {
        visible: false;
        text: root.extension;
        font-family: Fonts.mono;
        font-size: Type.xs;
    }
