    property <length> qr-actions-w: ((root.copy-action ? 1 : 0) + (root.edit-action ? 1 : 0) + 1) * root.q-box;
    property <bool> qr-actions-shown: root.q && root.has-menu && !root.pick-mode && (root.hovered || root.show-actions || root.focused);
    property <length> qr-stack-w: root.stack-position > 0 ? 36px + Space.s1 : 0px;
    property <length> qr-trail-w: root.qr-eye-w + (root.qr-actions-shown ? root.qr-actions-w : 0px) + root.qr-stack-w;
    // The preview gives way to the trailing controls (and keeps 6px clear of them); the title never does (Compact: only
