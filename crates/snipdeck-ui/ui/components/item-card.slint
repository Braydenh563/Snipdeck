import { Theme, Type, Space, Radius, Motion, Fonts, SystemLook, ListHue, ListAccent } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "icon.slint";
import { CardDepth, CardShadow } from "card-depth.slint";
import { StateColor } from "state-color.slint";

export enum ItemKind { text, template, code, link, image, file, sensitive }
export enum ItemCardVariant { compact, comfortable, tile }

// The quick-use number cell (DESIGN.md §4 "Number gutter"): 1-9 in mono `type.xs` tertiary; 0 and 10+
// leave it empty. While the card is pulled the number becomes a check in `accent-text`.
component ItemGutter inherits Rectangle {
    in property <int> number;
    in property <bool> checked;
    // The card is selected: the fill is `bg-selected` (the system highlight in high contrast), so the glyphs
    // switch to the colours meant for that fill.
    in property <bool> selected;
    // The vertical band the number is centred in (the title row).
    in property <length> row-y;
    in property <length> row-h;
    // The cell: 24px with the index-card rule beside it, 16px in the quiet Panel row.
    in property <length> cell-w: Space.s6;
    width: root.cell-w;

    if !root.checked && root.number >= 1 && root.number <= 9: Text {
        x: 0;
        y: root.row-y;
        width: parent.width;
        height: root.row-h;
        text: "\{root.number}";
        // Read as the key that uses the row: the badge has no tooltip of its own.
        accessible-label: @tr("Alt+{}", root.number);
        font-family: Fonts.mono;
        font-size: Type.xs;
        color: root.selected ? Theme.text-secondary-on-selected : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.checked: Icon {
        source: Icons.check;
        tint: root.selected ? Theme.accent-on-selected : Theme.accent-text;
        size: Space.s3 * SystemLook.text-scale;
        x: (parent.width - self.width) / 2;
        y: root.row-y + (root.row-h - self.height) / 2;
    }
}

// The list label of mixed views (picker, search, Recent): a 6px mark in the list colour and the
// list name in `type.xs`. The colour is on the mark only, never behind text (DESIGN.md §2).
component ListLabel inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    in property <color> mark;
    // Natural width of the name, measured by the card.
    in property <length> text-w;
    in property <length> max-w;
    property <length> mark-size: (Space.s1 + Space.s0-5) * SystemLook.text-scale;
    out property <length> natural-w: root.mark-size + Space.s1 + root.text-w;
    width: root.name == "" ? 0px : min(root.natural-w, root.max-w);
    height: Type.line-xs;
    visible: root.name != "" && root.max-w >= root.mark-size + Space.s1 + Type.xs * 2;

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: root.mark-size;
        height: root.mark-size;
        background: root.mark;
    }
    Text {
        x: root.mark-size + Space.s1;
        width: max(0px, parent.width - root.mark-size - Space.s1);
        height: parent.height;
        text: root.name;
        font-family: Fonts.sans;
        font-size: Type.xs;
        color: root.selected ? Theme.text-secondary-on-selected : Theme.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
}

// "Paste ↵" / "Copy ↵": a ghost button in `type.sm` 500 that does what Enter does on the row (O33). It is
// not a Tab stop: the row itself is the keyboard path (Enter uses, Shift+Enter copies) and the label shows
// while the row has focus. A click here is its own: it never selects the row instead of using it.
// The Enter glyph is the Phosphor `arrow-bend-down-left` icon, not the character U+21B5: IBM Plex has no
// glyph for it, so the character would come from whichever system font the machine falls back to.
component UseLabel inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> shown;
    // Colour behind the label so it never mixes with the preview text under it.
    in property <color> backing;
    in property <length> text-w;
    // The item the button acts on: the accessible name is "Paste <title>" / "Copy <title>".
    in property <string> item-title;
    // The pointer is on the button (it keeps the row hovered, so the label stays). A binding, not a
    // `changed` callback: the row's own touch area loses its hover the moment the pointer crosses onto
    // the button, and a deferred callback would let the button vanish under the press.
    out property <bool> hovered: touch.has-hover;
    property <bool> pressed: touch.pressed;
    callback clicked();
    // The Enter glyph is as tall as the label text.
    out property <length> glyph-size: Type.sm;
    property <color> ink: root.selected ? Theme.text-on-selected : Theme.text-primary;
    width: root.text-w + Space.s1 + root.glyph-size + 2 * Space.s2;
    height: Type.line-sm + Space.s1;
    border-radius: Radius.sm;
    background: root.pressed ? StateColor.pressed() : root.backing;
    // Hover and pressed read on every row fill (hovered, selected, lifted): a hairline in the text colour.
    border-width: root.hovered || root.pressed ? 1px : 0px;
    border-color: root.ink;
    opacity: root.shown ? 1.0 : 0.0;
    visible: root.text != "";
    animate opacity { duration: Motion.fade; easing: Motion.out; }

    Text {
        x: Space.s2;
        width: root.text-w;
        height: parent.height;
        text: root.text;
        font-family: Fonts.sans;
        font-size: Type.sm;
        font-weight: Type.medium;
        color: root.ink;
        vertical-alignment: center;
        accessible-role: AccessibleRole.none;
    }
    Icon {
        source: Icons.arrow-bend-down-left;
        tint: root.ink;
        size: root.glyph-size;
        x: Space.s2 + root.text-w + Space.s1;
        y: (parent.height - self.height) / 2;
    }
    // Only while shown does it take the pointer and count as a button for assistive technology: hidden,
    // the row's own touch area under it gets the click. The target is at least `Space.hit-min` in both
    // directions (WCAG 2.5.8), centred on the label, which stays its own size.
    property <length> hit-w: max(root.width, Space.hit-min);
    property <length> hit-h: max(root.height, Space.hit-min);
    touch := TouchArea {
        enabled: root.shown;
        mouse-cursor: pointer;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.hit-w;
        height: root.hit-h;
        clicked => { root.clicked(); }
    }
    if root.shown: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.hit-w;
        height: root.hit-h;
        accessible-role: button;
        accessible-label: root.item-title == "" ? root.text : root.text + " " + root.item-title;
        accessible-action-default => { root.clicked(); }
    }
}

// A row action of the quiet Panel row (Copy, Edit, More): a 28px ghost icon button (radius 6, glyph 16) in a 32px hit
// box. Hover is `bg-overlay-hover` plus a hairline, because on a hovered row that fill equals `bg-hover` in light.
// A click is its own: it never uses the row.
component RowAction inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> shown;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    // The pointer (or focus) came or went: the card turns it into a tooltip request.
    callback tip(bool);
    // The hit box: 32 in a row, 28 in a card (the glyph button inside is 28 either way).
    in property <length> box: Space.s8;
    width: root.box;
    height: root.box;
    visible: root.shown;
    changed hovered => { root.tip(root.hovered); }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Space.hit;
        height: Space.hit;
        border-radius: Radius.md;
        background: touch.pressed ? Theme.bg-selected : root.hovered ? Theme.bg-overlay-hover : transparent;
        border-width: root.hovered || Theme.hc-border != transparent ? 1px : 0px;
        border-color: root.hovered ? Theme.border-default : Theme.hc-border;
        Icon {
            source: root.icon;
            size: Space.s4;
            tint: Theme.text-primary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    touch := TouchArea {
        enabled: root.shown;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.shown: Rectangle {
        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { root.clicked(); }
    }
}

// DESIGN.md §4 ItemCard: the core object you click to use. Three variants (compact 28px row,
// comfortable <= 3 lines, tile) and seven content kinds with a content-aware leading element.
// Click (or Enter) uses, Shift+click (or Shift+Enter) copies, right-click or the Menu key opens the
// context menu. Everything else (Edit, Pin, Delete) is the app's menu, not this component.
//
// Limitation: a template's `{placeholders}` are shown as plain preview text; only the `{ }` glyph is
// in `accent-text` (Slint 1.18 has no stable rich text). Highlighting needs per-span Text elements.
export component ItemCard inherits Rectangle {
    in property <ItemCardVariant> variant: ItemCardVariant.comfortable;
    in property <ItemKind> kind: ItemKind.text;
    // Quick-use number: 1-9 shown, 0 (none) and 10+ leave the gutter empty.
    in property <int> number: 0;
    // False where nothing is ever numbered (the Main window): the gutter and its rule are left out.
    in property <bool> numbered: true;
    in property <string> title;
    // Search (Panel v2 spec 2.3): the first match in the title, as the text before it and the match itself. A span
    // of `search.mark` is drawn behind the match (never an underline). Both empty = no mark.
    in property <string> mark-before;
    in property <string> mark-text;
    in property <string> preview;
    // Search: the match in the preview's first line, as the text before it and the match. `preview` is then that
    // line cut to a window around the match. Never drawn for a sensitive item (the app does not send it either).
    in property <string> preview-before;
    in property <string> preview-match;
    // Search: the name of the tag that matched when the title and the preview show no match; the preview line
    // then reads "tag: <name>". Ignored for a sensitive item.
    in property <string> tag-hit;
    // Sensitive items show this (e.g. "•••• •••• 7f3a") until revealed.
    in property <string> masked-preview;
    // Spoken while a sensitive item is masked, e.g. "Hidden. Hold Space to reveal." (the app translates it).
    in property <string> masked-hint;
    // File items: the extension next to the file glyph (e.g. "PDF").
    in property <string> extension;
    // Image items: the thumbnail (56x36 in the comfortable card). An empty image shows a placeholder glyph.
    in property <image> image;
    // Mixed views: the list the item belongs to (6px mark + name at the right).
    in property <string> list-name;
    in property <color> list-color;
    // The colour label the user gave the item: -1 none, else 0 to 7 in the order blue, teal, green, amber, orange,
    // red, violet, slate. The bar is drawn only when `label-name` is also set: colour is never the only cue, and
    // the name is spoken as part of the description.
    in property <int> label: -1;
    in property <string> label-name;
    // 1-based place in the paste stack (SPEC 5.1); 0 = not marked. Drawn as an icon plus a number, never colour alone.
    in property <int> stack-position: 0;
    in property <bool> selected: false;
    // "Paste" when a target is known, otherwise "Copy"; the card adds the Enter glyph. Shown on hover or keyboard focus.
    in property <string> use-label;
    // The use label itself copies (no paste target): the separate Copy icon is hidden while the label shows, so the row has one copy button.
    in property <bool> use-copies: false;
    // Forces the use label visible (tests and galleries; hover cannot be forced headlessly).
    in property <bool> show-use-label: false;
    // Forces a sensitive item revealed (the app's own "show" toggle). Press-and-hold also reveals.
    in property <bool> revealed: false;
    // Holds the card in its pulled (used) state; the card also pulls itself on use.
    in property <bool> pulling: false;
    // False in a list that keeps keyboard focus elsewhere (the Panel's search field drives the
    // selection): the card is then not a Tab stop. It stays operable through assistive technology.
    in property <bool> keyboard-focusable: true;
    // Selection mode (the main window): a click reports `picked(shift, control)` instead of using the item, and a
    // double click uses it. The panel leaves this off: one click uses.
    in property <bool> pick-mode: false;
    // A Ctrl (Cmd) click reports `picked` even outside `pick-mode`: the Panel's way into a selection.
    in property <bool> modifier-picks: false;
    // Draws the keyboard focus ring although the card is not the focus owner (the list's cursor row).
    in property <bool> show-focus: false;
    // False where no row menu exists (the Picker): no kebab is drawn and its slot is not kept.
    in property <bool> has-menu: true;
    // The quiet row of Panel v2 (DESIGN.md §4 ItemCard anatomy; spec 2.5 and 3): a type tile, no Paste button, and Copy / Edit /
    // More as hover actions. It has three shapes picked by `variant`: comfortable = the List row (56, tile 32, actions on the
    // preview line), compact = the Compact row (36, tile 24, preview inline, actions at the right end), tile = a Card
    // (149 x 96, tile 24 and number on top, actions bottom-right). The Main window and the Picker leave it off.
    in property <bool> quiet: false;
    // Quiet row: the Edit action is offered (the Compact row in a narrow Panel leaves it to the More menu).
    in property <bool> edit-action: true;
    // Quiet row: the Copy action is offered (there is a paste target; without one the click already copies).
    in property <bool> copy-action: true;
    // Forces the quiet row's actions visible (the selected row; tests and galleries, as hover cannot be forced headlessly).
    in property <bool> show-actions: false;
    // Quiet row: the row's tooltip ("Click to paste into Outlook. Shift+click copies.").
    in property <string> row-tip;

    callback use();
    callback copy();
    // Quiet row: the Edit action.
    callback edit();
    // Quiet row: a tooltip should open (or close) for `text`, centred on x (window coordinates) above y.
    callback tip(string, length, length, bool);
    // A second press within the double-click interval (the first one already fired `use`).
    callback double-clicked();
    // Position inside the card, for the app to anchor the menu.
    callback context-menu-requested(length, length);
    // A sensitive item's press-and-hold began (true) or ended (false).
    callback reveal-requested(bool);
    // `pick-mode` only: a plain click, with the Shift and Ctrl (Cmd) modifiers held at the click.
    callback picked(bool, bool);

    // The used feedback: lift 2px over `Motion.quick`, number becomes a check, settle back over
    // `Motion.settle` after the hold. Reduced motion: no translation, the check swap only.
    public function pull() {
        root.pulled = true;
    }

    // DESIGN.md §4 Tooltip delay: a press held this long reveals a sensitive item.
    property <duration> reveal-hold: 500ms;
    // DESIGN.md §8 Motion: the pulled state is held for 700ms before it settles.
    property <duration> pull-hold: 700ms;
    // DESIGN.md §4 ItemCard: leading thumbnail size.
    property <length> thumb-w: 56px;
    property <length> thumb-h: 36px;
    property <length> tile-thumb-h: 64px;

    property <bool> compact: root.variant == ItemCardVariant.compact;
    property <bool> comfortable: root.variant == ItemCardVariant.comfortable;
    property <bool> tile: root.variant == ItemCardVariant.tile;
    property <bool> sensitive: root.kind == ItemKind.sensitive;
    property <bool> is-image: root.kind == ItemKind.image;
    // The quiet row: `qr` List, `qc` Compact, `qt` Card; `q` is any of them.
    property <bool> q: root.quiet;
    property <bool> qr: root.quiet && root.comfortable;
    property <bool> qc: root.quiet && root.compact;
    property <bool> qt: root.quiet && root.tile;

    property <bool> pulled: false;
    property <bool> lifted: root.pulling || root.pulled;
    // The deeper shadow: a pulled card, and a hovered Card (spec 3: "Hover = depth 2").
    property <bool> deep: root.lift-visual || (root.qt && root.hovered);
    property <bool> lift-visual: root.lifted && !SystemLook.reduced-motion;
    property <bool> held-reveal: false;
    property <bool> reveal-armed: false;
    property <bool> shown: !root.sensitive || root.revealed || root.held-reveal;
    property <bool> hovered: touch.has-hover || root.more-hover || root.copy-hover || use-btn.hovered
        || act-copy.hovered || act-edit.hovered || act-more.hovered || eye-hover;
    property <bool> more-hover: false;
    property <bool> copy-hover: false;
    property <bool> eye-hover: false;
    // The "More" (⋯) button is the context menu for a pointer that does not right-click. It is always drawn,
    // muted until the card is hovered or focused, so pen and touch users can find it (WCAG 2.2 sweep F6).
    // It is not a Tab stop: the keyboard opens the same menu with the Menu key or Shift+F10 on the card.
    property <bool> more-emphasised: root.hovered || root.focused;
    property <length> more-side: Space.hit-min;
    // The trailing slot every variant keeps for the Copy button and the kebab: the list and use labels sit left of it, and the
    // title and preview never run under it.
    property <length> more-reserve: root.has-menu && !root.q ? 2 * root.more-side + 2 * Space.s1 : 0px;
    property <bool> focused: scope.has-focus || root.show-focus;
    // A compact row's hint gives way when it would push the title under its 12-character floor
    // (large text scale in a narrow panel); the hint is also in the Panel's footer.
    property <bool> use-label-fits: !root.compact || root.row-w - root.use-w - Space.s2 >= root.min-title-w;
    property <bool> label-visible: !root.q && root.use-label != "" && root.use-label-fits && (root.hovered || root.focused || root.show-use-label);
    property <bool> mono-preview: (root.kind == ItemKind.code || root.kind == ItemKind.link || root.sensitive) && root.tag-hit == "";
    // The Panel's quiet row shows twelve dots and no trailing characters: it is always on top and visible in screen shares.
    property <string> shown-preview: root.sensitive && !root.shown ? (root.q ? "••••••••••••" : root.masked-preview) : root.tag-hit != "" ? @tr("tag: {}", root.tag-hit) : root.preview;

    // Leading glyph: none for plain text; images show the thumbnail instead (a small glyph in a compact row).
    property <bool> has-glyph: !root.q && root.kind != ItemKind.text && (!root.is-image || root.compact);
    property <image> glyph: root.kind == ItemKind.text ? Icons.text-t
        : root.kind == ItemKind.template ? Icons.brackets-curly
        : root.kind == ItemKind.code ? Icons.code
        : root.kind == ItemKind.link ? Icons.link
        : root.kind == ItemKind.image ? Icons.image
        : root.kind == ItemKind.file ? Icons.file
        : Icons.lock;
    property <color> glyph-tint: root.kind == ItemKind.template
        ? (root.selected ? Theme.accent-on-selected : Theme.accent-text)
        : (root.selected ? Theme.text-secondary-on-selected : Theme.text-secondary);
    property <bool> has-ext: !root.q && root.kind == ItemKind.file && root.extension != "";
    // The quiet row's type tile (DESIGN.md §4 "Item type tiles"). The name is the tile's tooltip and accessible name.
    property <color> kind-tile: root.kind == ItemKind.text ? Theme.kind-text-tile
        : root.kind == ItemKind.template ? Theme.kind-template-tile
        : root.kind == ItemKind.code ? Theme.kind-code-tile
        : root.kind == ItemKind.link ? Theme.kind-link-tile
        : root.kind == ItemKind.sensitive ? Theme.kind-sensitive-tile
        : root.kind == ItemKind.image ? Theme.kind-image-tile
        : Theme.kind-file-tile;
    property <color> kind-glyph: root.kind == ItemKind.text ? Theme.kind-text-glyph
        : root.kind == ItemKind.template ? Theme.kind-template-glyph
        : root.kind == ItemKind.code ? Theme.kind-code-glyph
        : root.kind == ItemKind.link ? Theme.kind-link-glyph
        : root.kind == ItemKind.sensitive ? Theme.kind-sensitive-glyph
        : root.kind == ItemKind.image ? Theme.kind-image-glyph
        : Theme.kind-file-glyph;
    property <string> kind-name: root.kind == ItemKind.text ? @tr("Text")
        : root.kind == ItemKind.template ? @tr("Template")
        : root.kind == ItemKind.code ? @tr("Code")
        : root.kind == ItemKind.link ? @tr("Link")
        : root.kind == ItemKind.sensitive ? @tr("Sensitive")
        : root.kind == ItemKind.image ? @tr("Image")
        : @tr("File");
    property <length> glyph-size: Space.s4 * SystemLook.text-scale;
    property <length> glyph-group-w: root.has-glyph ? root.glyph-size + (root.has-ext ? Space.s1 + m-ext.preferred-width : 0px) : 0px;

    // Geometry shared by the variants.
    // The quiet row's number cell is 16px plus a 4px gap, and it has no index-card rule.
    property <length> gutter-w: root.tile || !root.numbered ? 0px : root.q ? Space.s5 : Space.s6;
    property <length> rule-w: root.tile || !root.numbered || root.q ? 0px : 1px;
    property <length> pad-x: root.qt ? Space.s2 : root.tile ? Space.s3 : Space.s2;
    property <length> pad-y: root.compact ? 0px : root.tile ? Space.s3 : Space.s2;
    property <length> content-x: root.gutter-w + root.rule-w + root.pad-x;
    property <length> pad-r: root.q && !root.qt ? Space.s1 : root.pad-x;
    property <length> content-w: max(0px, root.width - root.content-x - root.pad-r - root.more-reserve);
    // Space taken left of the title in the compact and comfortable rows (the quiet List row: a 32px tile and a 10px gap; the
    // quiet Compact row: a 24px tile and an 8px gap).
    property <length> lead-w: root.qr ? Space.s8 + 10px : root.qc ? Space.s6 + Space.s2 : root.comfortable && root.is-image ? root.thumb-w + Space.s2 : root.has-glyph && !root.tile ? root.glyph-group-w + Space.s2 : 0px;
    // DESIGN.md §8: the title never truncates below 12 characters; the preview gives way first. Twelve Latin
    // characters are about 7 em; twelve CJK characters are 12 em, so the floor follows the title's own average
    // character width when that is larger.
    property <length> avg-char-w: m-title.preferred-width / max(1, root.title.character-count);
    property <length> min-title-w: min(m-title.preferred-width, max(Type.base * 7, root.avg-char-w * 12));
    property <length> row-w: root.content-w - root.lead-w;
    // Gap between the row's text (title or preview) and its trailing label: one step wider than the
    // inner gaps so the elided preview and the list chip read as two things (owner ask 2026-10-20).
    property <length> label-gap: Space.s4;
    property <length> list-mark-w: (Space.s1 + Space.s0-5) * SystemLook.text-scale + Space.s1;
    // The list label takes what the title leaves (never below ~8 characters), and never so much
    // that the title would drop under its 12-character floor.
    property <length> list-w: root.list-name == "" || root.q ? 0px : min(m-list.preferred-width + root.list-mark-w,
        min(max(0px, root.row-w - root.min-title-w - root.label-gap),
            max(root.row-w - m-title.preferred-width - root.label-gap, Type.xs * 8)));
    property <length> list-reserve: root.list-w > 0px ? root.list-w + root.label-gap : 0px;
    property <length> use-w: m-use.preferred-width + Space.s1 + Type.sm + 2 * Space.s2;
    // A compact row has one trailing slot: the use label replaces the list label while it shows.
    // The quiet Compact row gives its trailing controls (actions, eye, stack mark) the room the preview would take, then the title's.
    property <length> trail-reserve: root.qc ? root.qr-preview-reserve : root.compact && root.label-visible ? root.use-w + root.label-gap : root.list-reserve;
    property <length> title-avail: max(0px, root.row-w - root.trail-reserve);
    property <length> title-w: min(m-title.preferred-width, max(root.title-avail, root.min-title-w));

    property <length> title-h: Type.line-base;
    property <length> top-h: max(root.glyph-size, Type.line-xs);
    property <int> preview-lines: root.qt ? root.qt-prev-lines : root.qr ? 1 : root.comfortable ? 2 : root.is-image ? 1 : 3;
    property <length> preview-text-x: root.compact ? root.content-x + root.lead-w + root.title-w + Space.s2 : root.preview-x;
    property <length> preview-text-y: root.qc ? root.qc-title-y + (root.title-h - Type.line-sm) / 2
        : root.qt ? root.qt-prev-y
        : root.compact ? (root.height - Type.line-sm) / 2
        : root.tile ? root.pad-y + root.top-h + (root.is-image ? Space.s2 + root.tile-thumb-h : 0px) + Space.s1 + root.tile-title-h + Space.s1
        : root.qr ? root.qr-band-y + (root.qr-band-h - Type.line-sm) / 2
