        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.reveal-armed = root.sensitive;
                } else if (event.kind == PointerEventKind.cancel) {
                    root.reveal-armed = false;
                    if (root.held-reveal) {
                        root.held-reveal = false;
                        root.reveal-requested(false);
                    }
                } else if (event.kind == PointerEventKind.up) {
                    root.reveal-armed = false;
                    if (root.held-reveal) {
                        // The release that ends a reveal is not a use.
                        root.held-reveal = false;
                        root.reveal-requested(false);
                    } else if (touch.mouse-x >= 0 && touch.mouse-x <= touch.width && touch.mouse-y >= 0 && touch.mouse-y <= touch.height) {
                        if (root.pick-mode || (root.modifier-picks && (event.modifiers.control || event.modifiers.meta))) {
                            root.picked(event.modifiers.shift, event.modifiers.control || event.modifiers.meta);
                        } else {
                            root.pull();
                            if (event.modifiers.shift) {
                                root.copy();
                            } else {
                                root.use();
                            }
                        }
                    }
                }
            } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context-menu-requested(touch.mouse-x, touch.mouse-y);
            }
        }
    }

    // ---- More (⋯): the context menu for a pointer that does not right-click -----------------------
    // After `touch`, so a click on it is its own and never a use. Compact rows keep the use label to its
    // right; the other variants put it in the top-right corner.
    more := Rectangle {
        visible: root.has-menu && !root.q;
        width: root.more-side;
        height: root.more-side;
        x: root.width - root.pad-x - self.width;
        y: root.compact ? (root.height - self.height) / 2 : Space.s1;
        border-radius: Radius.md;
        background: root.more-hover ? Theme.bg-hover : transparent;
        accessible-role: button;
        accessible-label: @tr("More");
        accessible-action-default => { root.context-menu-requested(self.x, self.y + self.height); }

        Icon {
            // The header's bold glyph at its resting colour (5.47:1 light, 6.33:1 dark); the pale tertiary dots were 2:1.
            source: Icons.dots-three-bold;
            size: 16px;
            tint: root.more-hover ? Theme.text-primary : Theme.text-secondary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        more-touch := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => { root.more-hover = self.has-hover; }
            clicked => { root.context-menu-requested(more.x, more.y + more.height); }
        }
    }

    // ---- Use button: bottom right (centre right in a compact row) on hover, focus or `show-use-label` ---
    // After `touch` like More: a click on it uses the item (O33) and never only selects it in `pick-mode`.
    use-btn := UseLabel {
        selected: root.selected;
        text: root.q ? "" : root.use-label;
        item-title: root.title;
        shown: root.label-visible;
        backing: root.fill;
        text-w: m-use.preferred-width;
        x: root.width - root.pad-x - root.more-reserve - self.width;
        y: root.compact ? (root.height - self.height) / 2
            : root.tile ? root.height - root.pad-y - self.height
            : root.height - Space.s1 - self.height;
        clicked => {
            root.pull();
            root.use();
        }
    }

    // ---- Copy: "Copy without pasting", left of More, drawn the same way ---------------------------
    // Always present, muted until the card is hovered or focused. It fires `copy` (the Shift+click) and never
    // `use` or `pull`, so it is not a use of the card. Not a Tab stop: Shift+Enter copies from the keyboard.
    copy-button := Rectangle {
        // Only where the kebab is: without a menu no trailing slot is reserved and the icon would sit on the label.
        // Hidden while a use label that itself copies shows, so the row has one copy button.
        visible: root.has-menu && !root.q && !(root.use-copies && root.label-visible);
        width: root.more-side;
        height: root.more-side;
        x: more.x - self.width;
        y: more.y;
        border-radius: Radius.md;
        background: root.copy-hover ? Theme.bg-hover : transparent;
        accessible-role: button;
        accessible-label: @tr("Copy without pasting");
        accessible-action-default => { root.copy(); }

        Icon {
            source: Icons.copy;
            size: 16px;
            tint: root.copy-hover ? Theme.text-primary : (root.more-emphasised ? Theme.text-secondary : Theme.text-tertiary);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        copy-touch := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => { root.copy-hover = self.has-hover; }
            clicked => { root.copy(); }
        }
    }

    // ---- Quiet row: Copy, Edit and More on the preview line, and the sensitive eye ---------------------
    // After `touch`, so a click on any of them is its own and never a use. They show on hover and on the selected row
    // (`show-actions`) and are not Tab stops: Shift+Enter, Ctrl+E and the Menu key reach the same actions.
    property <length> act-y: root.qt ? root.qt-h - Space.s1 - root.q-box : root.qc ? root.qc-title-y + (root.title-h - root.q-box) / 2 : root.qr-band-y;
    // The Card's actions sit over its last preview line: a solid fill behind them (no fade), the card's own.
    if root.qt && root.qr-actions-shown: Rectangle {
        x: root.qr-right - root.qr-eye-w - root.qr-actions-w;
        y: root.act-y + Space.s1;
        width: root.qr-actions-w;
        height: root.q-box - Space.s1;
        background: root.fill;
    }
    act-more := RowAction {
        shown: root.qr-actions-shown;
        box: root.q-box;
        icon: Icons.dots-three;
        label: @tr("More");
        x: root.qr-right - root.qr-eye-w - self.width;
        y: root.act-y;
        clicked => { root.context-menu-requested(self.x, self.y + self.height); }
        tip(on) => { root.tip(self.label, root.absolute-position.x + self.x + self.width / 2, root.absolute-position.y + self.y + self.height, on); }
    }
    act-edit := RowAction {
        shown: root.qr-actions-shown && root.edit-action;
        box: root.q-box;
        icon: Icons.pencil-simple;
        label: @tr("Edit");
        x: act-more.x - self.width;
        y: root.act-y;
        clicked => { root.edit(); }
        tip(on) => { root.tip(self.label, root.absolute-position.x + self.x + self.width / 2, root.absolute-position.y + self.y + self.height, on); }
    }
    act-copy := RowAction {
        shown: root.qr-actions-shown && root.copy-action;
        box: root.q-box;
        icon: Icons.copy;
        label: @tr("Copy");
        x: act-more.x - (root.edit-action ? act-edit.width : 0px) - self.width;
        y: root.act-y;
        clicked => { root.copy(); }
        tip(on) => { root.tip(self.label, root.absolute-position.x + self.x + self.width / 2, root.absolute-position.y + self.y + self.height, on); }
    }
    // The eye (a sensitive item): always at the right end of the preview line, press and hold to reveal.
    if root.q && root.sensitive: Rectangle {
        x: root.qr-right - self.width;
        y: root.act-y;
        width: root.q-box;
        height: root.q-box;
        accessible-role: button;
        accessible-label: @tr("Hold to reveal");
        // Assistive technology activates it: the preview shows (a second activation hides it again). The keyboard's
        // way is holding Space on the selected row, which the Panel handles.
        accessible-action-default => { root.reveal-requested(!root.shown); }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Space.hit;
            height: Space.hit;
            border-radius: Radius.md;
            background: eye-touch.pressed ? Theme.bg-selected : root.eye-hover ? Theme.bg-overlay-hover : transparent;
            border-width: root.eye-hover || Theme.hc-border != transparent ? 1px : 0px;
            border-color: root.eye-hover ? Theme.border-default : Theme.hc-border;
            Icon {
                source: root.shown ? Icons.eye-slash : Icons.eye;
                size: Space.s4;
                tint: Theme.text-primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        eye-touch := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => { root.eye-hover = self.has-hover; }
            pointer-event(event) => {
                if (event.button != PointerEventButton.left) { return; }
                if (event.kind == PointerEventKind.down && !root.held-reveal) {
                    root.held-reveal = true;
                    root.reveal-requested(true);
                } else if ((event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && root.held-reveal) {
                    root.held-reveal = false;
                    root.reveal-requested(false);
                }
            }
        }
    }

    // ---- Paste stack mark: the stack glyph and the item's place, left of Copy --------------------
    if root.stack-position > 0: Rectangle {
        width: root.q ? 36px : stack-mark-row.preferred-width + 2 * Space.s1;
        height: root.more-side;
        // Quiet row: on the preview line, left of the actions (or at the right end while they are hidden); in Compact level
        // with the title; on a Card in the top row, left of the number.
        x: root.qt ? root.width - root.pad-x - Space.s4 - Space.s1 - self.width
            : root.q ? root.qr-right - root.qr-eye-w - (root.qr-actions-shown ? root.qr-actions-w : 0px) - self.width
            : copy-button.x - self.width - Space.s1;
        y: root.qt ? root.tile-y + (root.q-tile-size - self.height) / 2
            : root.qc ? (root.card-h - self.height) / 2
            : root.qr ? root.qr-band-y + (root.qr-band-h - self.height) / 2 : more.y;
        border-radius: Radius.md;
        background: Theme.accent-subtle;
        stack-mark-row := HorizontalLayout {
            padding-left: Space.s1;
            padding-right: Space.s1;
            spacing: Space.s0-5;
            alignment: center;
            Icon {
                source: Icons.stack-simple;
                size: 12px;
                tint: Theme.accent-text;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.stack-position;
                font-family: Fonts.sans;
                font-size: Type.xs;
                font-weight: Type.medium;
                color: Theme.accent-text;
                vertical-alignment: center;
                accessible-role: AccessibleRole.none;
            }
        }
    }

    scope := FocusScope {
        enabled: root.keyboard-focusable;
        focus-on-click: false;
        // A secret revealed with the held Space key is hidden again when focus leaves (Tab, a click elsewhere,
        // the window deactivating): the key release would then go to another control and never arrive here.
        focus-lost(reason) => {
            if (root.held-reveal) {
                root.held-reveal = false;
                root.reveal-requested(false);
            }
        }
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.pull();
                if (event.modifiers.shift) {
                    root.copy();
                } else {
                    root.use();
                }
                return accept;
            }
            if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                root.context-menu-requested(max(root.gutter-w, Space.s6), root.height);
                return accept;
            }
            // Keyboard reveal: hold Space (a sensitive item only).
            if (event.text == " " && root.sensitive) {
                if (!root.held-reveal) {
                    root.held-reveal = true;
                    root.reveal-requested(true);
                }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == " " && root.held-reveal) {
                root.held-reveal = false;
                root.reveal-requested(false);
                return accept;
            }
            return reject;
        }
    }
}
