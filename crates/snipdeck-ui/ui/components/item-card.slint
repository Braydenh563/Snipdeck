    property <length> qc-h: root.qr-where ? max(52px, 2 * Space.s2 + root.title-h + Type.line-xs) : max(Space.s8 + Space.s1, root.title-h + 2 * Space.s2);
    property <length> qc-title-y: root.qr-where ? Space.s2 : (root.qc-h - root.title-h) / 2;
    property <length> qt-title-y: Space.s2 + Space.s6;
