import { Theme, Space, Radius, Motion, ListHue, ListAccent, SystemLook } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "icon.slint";
import { Swatch } from "swatch.slint";

// The cell of the colour picker that means "no colour". Same size and states as `Swatch`.
export component NoColour inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> show-focus: false;
    in property <length> cell: Space.hit * SystemLook.text-scale;
    callback clicked();

    width: root.cell;
    height: root.cell;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        border-width: root.selected ? 2px : 0px;
        border-color: Theme.text-primary;
        border-radius: Radius.lg;
        background: transparent;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.cell * (touch.has-hover || touch.pressed ? 22 : 20) / 28;
        height: self.width;
        border-radius: Radius.sm;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: touch.pressed ? Theme.bg-sunken : transparent;
        animate width { duration: Motion.instant; easing: Motion.out; }
        Icon {
            source: Icons.x;
            size: root.cell * 12 / 28;
            tint: Theme.text-secondary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-width: root.show-focus ? 2px : 0px;
        border-color: Theme.focus-ring;
        border-radius: Radius.lg + 2px;
        background: transparent;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// "No colour" and a set of hues as one radio group: one tab stop, Left / Right / Home / End choose. Used for a list's
// colour (the nine list hues) and an item's colour label (eight of them).
// `accent` is -1 for none, else the index into `hues`; `names` are the spoken colour names in that order.
export component ColourPicker inherits Rectangle {
    in property <[ListHue]> hues;
    in property <int> accent: -1;
    in property <string> label;
    in property <string> none-label;
    in property <[string]> names;
    callback chosen(accent: int);
    out property <bool> has-focus: scope.has-focus;

    function move(to: int) {
        if (to >= -1 && to < root.hues.length && to != root.accent) {
            root.chosen(to);
        }
    }

    // The targets grow with the text size, but never past the room the row has: the cell is the 28 px hit target at
    // the least, the text-size scaled one at the most, and what the targets (plus gaps) leave of the width between.
    // Set from `changed` handlers, not bound to `root.width`: the row's width comes from its parent's layout, which
    // also reads its height, which follows the cell.
    property <length> gap: Space.s1 / SystemLook.text-scale;
    property <length> cell: Space.hit * SystemLook.text-scale;
    property <float> text-scale: SystemLook.text-scale;
    function refit() {
        if (root.width > 0px) {
            root.cell = max(Space.hit, min(Space.hit * root.text-scale, (root.width - root.hues.length * root.gap) / (root.hues.length + 1)));
        }
    }
    init => { root.refit(); }
    changed width => { root.refit(); }
    changed text-scale => { root.refit(); }
    height: root.cell;
    forward-focus: scope;
    accessible-role: radio-group;
    accessible-label: root.label;

    HorizontalLayout {
        // The gap shrinks with the text size as the targets grow, and the targets give way when the row is still too
        // narrow: every choice ends inside the row at 2.25x.
        spacing: root.gap;
        alignment: start;
        NoColour {
            cell: root.cell;
            label: root.none-label;
            selected: root.accent == -1;
            show-focus: scope.has-focus && root.accent == -1;
            clicked => { root.move(-1); }
        }
        for h[i] in root.hues: Swatch {
            cell: root.cell;
            hue: h;
            label: root.names[i];
            selected: i == root.accent;
            keyboard-focusable: false;
            show-focus: scope.has-focus && i == root.accent;
            clicked => { root.move(i); }
        }
    }

    scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.move(root.accent + 1);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.move(root.accent - 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.move(-1);
                return accept;
            }
            if (event.text == Key.End) {
                root.move(root.hues.length - 1);
                return accept;
            }
            return reject;
        }
    }
}
