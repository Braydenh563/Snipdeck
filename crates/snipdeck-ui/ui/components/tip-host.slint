import { Space } from "../theme.slint";
import { Tooltip } from "tooltip.slint";

// The window's one tooltip slot (DESIGN.md §4). A control that has rested under the pointer (or holds keyboard focus)
// for `show-delay` calls `show` with its own box in window coordinates; the window's `TipLayer` draws the tooltip.
// The layer is the window's last child, so nothing paints over a tooltip and no container clips it. A global is
// one per window, so each window has its own slot.
export global TipHost {
    out property <string> text;
    out property <bool> open;
    // The anchoring control's box in window coordinates.
    out property <length> left;
    out property <length> top;
    out property <length> box-width;
    out property <length> box-height;
    // Who holds the slot: each `show` hands out a new id, and only that id's `hide` closes the tooltip.
    property <int> owner;

    public function show(text: string, left: length, top: length, box-width: length, box-height: length) -> int {
        self.owner += 1;
        self.text = text;
        self.left = left;
        self.top = top;
        self.box-width = box-width;
        self.box-height = box-height;
        self.open = true;
        return self.owner;
    }
    // Closes the tooltip when `id` still holds the slot (another control may have taken it since).
    public function hide(id: int) {
        if (self.owner == id) {
            self.open = false;
        }
    }
}

// Put this last in every `Window` whose controls use `tooltip` with `own-tooltip`. It covers the window but takes no
// input. The tooltip sits below its control (4px gap), flips above when it would pass the bottom edge, is left
// aligned to the control (right aligned when wider than it), and is shifted to stay 8px inside the window.
export component TipLayer inherits Rectangle {
    accessible-role: AccessibleRole.none;

    if TipHost.open: Tooltip {
        text: TipHost.text;
        open: true;
        limit-width: root.width - 2 * Space.s2;
        width: self.preferred-width;
        height: self.preferred-height;
        x: max(Space.s2, min(TipHost.left + min(0px, TipHost.box-width - self.width), root.width - self.width - Space.s2));
        y: max(Space.s2, TipHost.top + TipHost.box-height + Space.s1 + self.height > root.height - Space.s2
            ? TipHost.top - Space.s1 - self.height
            : TipHost.top + TipHost.box-height + Space.s1);
    }
}
