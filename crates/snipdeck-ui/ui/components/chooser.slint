import { ListNav } from "list-nav.slint";
import { Theme, Type, Radius, Space, Motion, Fonts, SystemLook } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "icon.slint";
import { OverlayScrollbar } from "scrollbar.slint";

// One choice of a Chooser or one navigation entry of the main window's sidebar (a list or a tag): its label, an
// optional count, the list colour (transparent = no mark) and whether it is ticked (tags on the selected items).
export struct ChoiceEntry {
    label: string,
    count: int,
    color: color,
    // A list's icon (an empty image is none).
    icon: image,
    checked: bool,
}

// A floating list of choices: "Move to list" (pick one, closes) or "Tags" (`multi`: each row toggles and stays
// open). Same surface as Menu (`bg-overlay`, 1px border, radius 8). Keyboard once the host calls `focus-chooser()`:
// Up / Down / Home / End move, Enter or Space picks, Esc dismisses. The host places and closes it. Rows are
// list items; in `multi` mode they are checkable and say whether they are ticked. Past 8 rows it scrolls.
export component Chooser inherits Rectangle {
    in property <[ChoiceEntry]> entries;
    // Spoken name ("Move to list").
    in property <string> label;
    // Shown instead of rows when there are none ("No lists yet").
    in property <string> empty-text;
    in property <bool> multi: false;
    in-out property <int> current: 0;
    callback chosen(int);
    callback dismissed();
    // Shift was held on the key that chose the row (read inside `chosen`); false for a click.
    out property <bool> shift: false;

    public function focus-chooser() {
        scope.focus();
    }

    property <length> row-h: max(Space.hit, Type.line-base + Space.s2);
    property <int> max-rows: 8;
    out property <int> count: root.entries.length;

    function reveal(i: int) {
        let top = i * root.row-h;
        if (top + flick.content-y < 0px) {
            flick.content-y = -top;
        } else if (top + root.row-h + flick.content-y > flick.height) {
            flick.content-y = flick.height - top - root.row-h;
        }
    }
    function move(delta: int) {
        if (root.entries.length > 0) {
            root.current = min(max(root.current + delta, 0), root.entries.length - 1);
            root.reveal(root.current);
        }
    }

    // Type-ahead and pages, as in Menu (see `ListNav`).
    property <string> typed: "";
    type-timer := Timer {
        interval: ListNav.pause;
        running: false;
        triggered => {
            self.running = false;
            root.typed = "";
        }
    }
    // The first row from `from` on (wrapping round once) whose label starts with `p`, or -1. Slint has no loops and no
    // recursion, so the scan is a ladder: `row-at` tests one row, each `scanN` asks the one below eight times (8, 64, 512, 4096,
    // 32768 rows). `off` stops it at the last row, so a short list costs a short scan.
    pure function row-at(from: int, off: int, p: string) -> int {
        if (off >= root.entries.length) { return -1; }
        let i = mod(from + off, root.entries.length);
        return ListNav.starts(root.entries[i].label, p) ? i : -1;
    }
    pure function scan8(from: int, off: int, p: string) -> int {
        if (off >= root.entries.length) { return -1; }
        let a = root.row-at(from, off + 0, p);
        if (a >= 0) { return a; }
        let b = root.row-at(from, off + 1, p);
        if (b >= 0) { return b; }
        let c = root.row-at(from, off + 2, p);
        if (c >= 0) { return c; }
        let d = root.row-at(from, off + 3, p);
        if (d >= 0) { return d; }
        let e = root.row-at(from, off + 4, p);
        if (e >= 0) { return e; }
        let f = root.row-at(from, off + 5, p);
        if (f >= 0) { return f; }
        let g = root.row-at(from, off + 6, p);
        if (g >= 0) { return g; }
        let h = root.row-at(from, off + 7, p);
        if (h >= 0) { return h; }
        return -1;
    }
    pure function scan64(from: int, off: int, p: string) -> int {
        if (off >= root.entries.length) { return -1; }
        let a = root.scan8(from, off + 0, p);
        if (a >= 0) { return a; }
        let b = root.scan8(from, off + 8, p);
        if (b >= 0) { return b; }
        let c = root.scan8(from, off + 16, p);
        if (c >= 0) { return c; }
        let d = root.scan8(from, off + 24, p);
        if (d >= 0) { return d; }
        let e = root.scan8(from, off + 32, p);
        if (e >= 0) { return e; }
        let f = root.scan8(from, off + 40, p);
        if (f >= 0) { return f; }
        let g = root.scan8(from, off + 48, p);
        if (g >= 0) { return g; }
        let h = root.scan8(from, off + 56, p);
        if (h >= 0) { return h; }
        return -1;
    }
    pure function scan512(from: int, off: int, p: string) -> int {
        if (off >= root.entries.length) { return -1; }
        let a = root.scan64(from, off + 0, p);
        if (a >= 0) { return a; }
        let b = root.scan64(from, off + 64, p);
        if (b >= 0) { return b; }
        let c = root.scan64(from, off + 128, p);
        if (c >= 0) { return c; }
        let d = root.scan64(from, off + 192, p);
        if (d >= 0) { return d; }
        let e = root.scan64(from, off + 256, p);
        if (e >= 0) { return e; }
        let f = root.scan64(from, off + 320, p);
        if (f >= 0) { return f; }
        let g = root.scan64(from, off + 384, p);
        if (g >= 0) { return g; }
        let h = root.scan64(from, off + 448, p);
        if (h >= 0) { return h; }
        return -1;
    }
    pure function scan4k(from: int, off: int, p: string) -> int {
        if (off >= root.entries.length) { return -1; }
        let a = root.scan512(from, off + 0, p);
        if (a >= 0) { return a; }
        let b = root.scan512(from, off + 512, p);
        if (b >= 0) { return b; }
        let c = root.scan512(from, off + 1024, p);
        if (c >= 0) { return c; }
        let d = root.scan512(from, off + 1536, p);
        if (d >= 0) { return d; }
        let e = root.scan512(from, off + 2048, p);
        if (e >= 0) { return e; }
        let f = root.scan512(from, off + 2560, p);
        if (f >= 0) { return f; }
        let g = root.scan512(from, off + 3072, p);
        if (g >= 0) { return g; }
        let h = root.scan512(from, off + 3584, p);
        if (h >= 0) { return h; }
        return -1;
    }
    pure function scan32k(from: int, off: int, p: string) -> int {
        if (off >= root.entries.length) { return -1; }
        let a = root.scan4k(from, off + 0, p);
        if (a >= 0) { return a; }
        let b = root.scan4k(from, off + 4096, p);
        if (b >= 0) { return b; }
        let c = root.scan4k(from, off + 8192, p);
        if (c >= 0) { return c; }
        let d = root.scan4k(from, off + 12288, p);
        if (d >= 0) { return d; }
        let e = root.scan4k(from, off + 16384, p);
        if (e >= 0) { return e; }
        let f = root.scan4k(from, off + 20480, p);
        if (f >= 0) { return f; }
        let g = root.scan4k(from, off + 24576, p);
        if (g >= 0) { return g; }
        let h = root.scan4k(from, off + 28672, p);
        if (h >= 0) { return h; }
        return -1;
    }
    pure function first-hit(from: int, p: string) -> int {
        return root.scan32k(from, 0, p);
    }
    function type-ahead(ch: string) {
        root.typed = root.typed + ch;
        let hit = root.first-hit(root.typed.character-count == 1 ? root.current + 1 : max(root.current, 0), root.typed);
        if (hit >= 0) {
            root.current = hit;
            root.reveal(hit);
        }
        type-timer.running = false;
        type-timer.running = true;
    }

    min-width: 200px;
    height: 2 * Space.s1 + (root.entries.length == 0 ? root.row-h : min(root.entries.length, root.max-rows) * root.row-h);
    background: Theme.bg-overlay;
    border-radius: Radius.lg;
    border-width: 1px;
    border-color: Theme.border-default;
    accessible-role: list;
    accessible-label: root.label;
    forward-focus: scope;

    scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.move(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move(-1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.move(-root.entries.length);
                return accept;
            }
            if (event.text == Key.End) {
                root.move(root.entries.length);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.move(ListNav.page(root.max-rows));
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.move(-ListNav.page(root.max-rows));
                return accept;
            }
            if ((event.text == Key.Return || event.text == " ") && root.current >= 0 && root.current < root.entries.length) {
                root.shift = event.modifiers.shift;
                root.chosen(root.current);
                root.shift = false;
                return accept;
            }
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            if (ListNav.typed-char(event.text) && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                root.type-ahead(event.text);
                return accept;
            }
            return reject;
        }
    }

    if root.entries.length == 0: Text {
        x: Space.s3;
        width: parent.width - 2 * Space.s3;
        height: parent.height;
        text: root.empty-text;
        font-family: Fonts.sans;
        font-size: Type.base;
        color: Theme.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }

    flick := Flickable {
        x: Space.s1;
        y: Space.s1;
        width: parent.width - 2 * Space.s1;
        height: parent.height - 2 * Space.s1;
        interactive: false;
        content-height: root.entries.length * root.row-h;

        for entry[i] in root.entries: Rectangle {
            x: 0;
            y: i * root.row-h;
            width: flick.width;
            height: root.row-h;
            border-radius: Radius.sm;
            background: root.current == i ? Theme.bg-overlay-hover : transparent;
            border-width: root.current == i && scope.has-focus ? 2px : 0px;
            border-color: Theme.focus-ring;
            accessible-role: list-item;
            accessible-label: entry.label;
            accessible-checkable: root.multi;
            accessible-checked: entry.checked;
            accessible-item-index: i;
            accessible-item-count: root.entries.length;
            accessible-item-selectable: !root.multi;
            accessible-item-selected: !root.multi && root.current == i;
            accessible-action-default => {
                root.chosen(i);
            }

            HorizontalLayout {
                padding-left: Space.s2;
                padding-right: Space.s2;
                spacing: Space.s2;
                Rectangle {
                    width: Space.s4 * SystemLook.text-scale;
                    if entry.color != transparent: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: Space.s2 * SystemLook.text-scale;
                        height: self.width;
                        background: entry.color;
                    }
                    if root.multi && entry.checked: Icon {
                        source: Icons.check;
                        tint: Theme.accent-text;
                        size: Space.s4 * SystemLook.text-scale;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: entry.label;
                    font-family: Fonts.sans;
                    font-size: Type.base;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if entry.count >= 0: Text {
                    horizontal-stretch: 0;
                    text: "\{entry.count}";
                    font-family: Fonts.mono;
                    font-size: Type.xs;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                changed has-hover => {
                    if (self.has-hover) {
                        root.current = i;
                    }
                }
                clicked => {
                    root.chosen(i);
                }
            }
        }
    }

    OverlayScrollbar {
        y: flick.y;
        height: flick.height;
        content-y: flick.content-y;
        content-height: flick.content-height;
        visible-height: flick.height;
        scroll-to(y) => { flick.content-y = y; }
    }
}
