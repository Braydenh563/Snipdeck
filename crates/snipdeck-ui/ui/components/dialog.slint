import { Theme, Type, Radius, Space, Motion, Fonts } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "icon.slint";
import { OverlayScrollbar } from "scrollbar.slint";

export enum DialogVariant { default, destructive }

// DESIGN.md §4 Dialog: confirm, import. Modal: a 40% scrim covers its parent and swallows pointer input.
// Place it as the LAST child of the window (or the panel) so it sits on top. Tab stays inside the card: after the
// last action it comes back to the card itself (the first stop), and Shift+Tab on the card stays put. Disabling what
// is behind while `open` is still good practice (the pointer is blocked by the scrim either way). When the dialog
// closes it emits `closed` so the host can put keyboard focus back on whatever opened it.
//
// The children are the actions row, laid out right-aligned, e.g. a secondary and a primary `Button`. With `fill`
// the children stretch across the card instead (a child that wants the width sets `horizontal-stretch: 1`).
// Keyboard: Esc emits `dismissed`; Enter emits `accepted` (default variant only: in a destructive dialog the
// destructive action is never the Enter default, so Enter on the dialog itself does nothing). A destructive dialog
// starts with focus on its first button, Cancel: the host binds that button's `focus-request` to `cancel-focus`, so
// Enter or Space on the dialog cancels, and Tab reaches the destructive action next (MAIN-44). Esc and Enter react
// to key PRESS only.
//
// The card never grows past its parent (less a margin): when the window is too short for the whole body (a narrow
// Panel at a large text size), the body scrolls (wheel, the overlay bar, or Up/Down/Page Up/Page Down on the card)
// and the title and the actions stay in view.
//
// Slint 1.18 has no `dialog` accessibility role; the focus scope (which holds the focus on open) is exposed as a labelled group (gap, see README).
export component Dialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <string> body;
    in property <DialogVariant> variant: DialogVariant.default;
    // The children fill the card's width (a wide body such as a table) instead of sitting right-aligned.
    in property <bool> fill: false;
    callback dismissed();
    callback accepted();
    // The dialog closed (`open` went false): the host puts keyboard focus back on whatever opened it.
    callback closed();
    // Counts up each time a destructive dialog opens; bind the Cancel button's `focus-request` to it.
    out property <int> cancel-focus: 0;

    // 40% scrim (DESIGN.md §6): dark in both themes; system window colour in high contrast.
    // The body's scroll position (0 or negative) and how far it can scroll, for the keyboard.
    property <length> body-y: 0px;
    property <length> body-max: 0px;

    property <color> scrim: ((Theme.dark || Theme.hc-border != transparent) ? Theme.bg-app : Theme.text-primary).with-alpha(0.4);

    // Closed: not drawn, not hit-testable, not in the accessibility tree, and it holds no keyboard focus.
    visible: root.open;
    changed open => {
        if (root.open) {
            scope.focus();
            if (root.variant == DialogVariant.destructive) { root.cancel-focus += 1; }
        } else {
            scope.clear-focus();
            root.closed();
        }
    }
    init => {
        if (root.open) {
            scope.focus();
            if (root.variant == DialogVariant.destructive) { root.cancel-focus += 1; }
        }
    }

    // The scope holds the focus when the dialog opens, so it carries the name and the words (MAIN-57); a screen reader
    // reads them when the focus enters. Slint 1.18 has no `dialog` accessibility role: the scope is a labelled group.
    scope := FocusScope {
        accessible-role: groupbox;
        accessible-label: root.title;
        accessible-description: root.body;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            if (root.body-max > 0px && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.PageUp || event.text == Key.PageDown)) {
                // A line for the arrows, the whole overflow for the page keys.
                root.body-y = max(-root.body-max, min(0px, root.body-y
                    + ((event.text == Key.UpArrow || event.text == Key.PageUp) ? 1 : -1)
                    * ((event.text == Key.UpArrow || event.text == Key.DownArrow) ? Type.line-base : root.body-max)));
                return accept;
            }
            if (event.text == "\n" && root.variant == DialogVariant.default) {
                root.accepted();
                return accept;
            }
            // Shift+Tab on the card itself (the first stop) would leave the dialog: keep it here. When the
            // focus is on a button the event is the button's to move back to the card, so only act at the top.
            if (scope.has-focus && (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift))) {
                return accept;
            }
            return reject;
        }

        Rectangle {
            background: root.scrim;
            // Modal: nothing behind the scrim receives the pointer.
            TouchArea { }

            card := Rectangle {
                width: min(Space.s12 * 8, parent.width - 2 * Space.s4);
                height: min(content.preferred-height, parent.height - 2 * Space.s4);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.bg-overlay;
                border-radius: Radius.lg;
                border-width: 1px;
                border-color: Theme.border-default;

                content := VerticalLayout {
                    padding: Space.s4;
                    spacing: Space.s3;
                    HorizontalLayout {
                        spacing: Space.s2;
                        alignment: start;
                        if root.variant == DialogVariant.destructive: Icon {
                            source: Icons.warning;
                            tint: Theme.danger-fg;
                            y: (Type.line-lg - self.height) / 2;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.title;
                            color: Theme.text-primary;
                            font-family: Fonts.sans;
                            font-size: Type.lg;
                            font-weight: Type.semibold;
                            wrap: word-wrap;
                            accessible-role: none;
                        }
                    }
                    if root.body != "": Rectangle {
                        // As tall as the text when it fits; squeezed (and scrolling) when the card is capped.
                        preferred-height: body-text.preferred-height;
                        min-height: min(body-text.preferred-height, 2 * Type.line-base);
                        vertical-stretch: 1;
                        changed height => { root.body-max = max(0px, body-text.preferred-height - self.height); root.body-y = max(-root.body-max, root.body-y); }
                        init => { root.body-max = max(0px, body-text.preferred-height - self.height); }
                        body := Flickable {
                            content-width: self.width;
                            content-height: body-text.preferred-height;
                            content-y <=> root.body-y;
                            body-text := Text {
                                width: body.width;
                                text: root.body;
                                color: Theme.text-secondary;
                                font-family: Fonts.sans;
                                font-size: Type.base;
                                wrap: word-wrap;
                                accessible-role: none;
                            }
                        }
                        OverlayScrollbar {
                            content-y: body.content-y;
                            content-height: body.content-height;
                            visible-height: body.height;
                            scroll-to(y) => { root.body-y = y; }
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.s2;
                        alignment: root.fill ? stretch : end;
                        @children
                    }
                }

                // After the last action: Tab lands here and goes straight back to the card, so focus cycles inside.
                FocusScope {
                    width: 0px;
                    height: 0px;
                    focus-on-click: false;
                    focus-gained(reason) => {
                        if (root.open) { scope.focus(); }
                    }
                }
            }
        }
    }
}
