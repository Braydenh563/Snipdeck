import { Theme, Type, Space, Radius, Motion, Fonts, SystemLook } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "icon.slint";

// DESIGN.md §4 BoardSwitcher: a button-like control showing the board name and a caret. It only
// asks for the menu (`menu-requested`); the app owns the Menu and positions it under this control.
export component BoardSwitcher inherits Rectangle {
    in property <string> board-name;
    // The Menu switcher (Panel v2 spec 3) reads "Board · List": the current list's name, secondary, after the board's. Both
    // elide; the list keeps about five characters. Empty = just the board.
    in property <string> list-name;
    // True while the app's menu is open (pressed look, `accessible-expanded`).
    in property <bool> menu-open: false;
    // Spoken label; defaults to the board name. The app translates e.g. "Board: Work".
    in property <string> a11y-label;
    // The Panel's header is 40 tall with 32px controls (Panel v2 spec 2.1); the board picker shrinks, its name elides.
    in property <length> min-h: Space.hit;
    out property <bool> has-focus: scope.has-focus;
    callback menu-requested();

    property <bool> hovered: touch.has-hover;
    m-board := Text {
        visible: false;
        text: root.board-name;
        font-family: Fonts.sans;
        font-size: Type.md;
        font-weight: Type.medium;
    }
    m-list := Text {
        visible: false;
        text: root.list-name;
        font-family: Fonts.sans;
        font-size: Type.md;
    }

    min-width: Space.hit;
    height: max(root.min-h, Type.line-base + Space.s2);
    background: touch.pressed || root.menu-open ? Theme.bg-sunken : root.hovered ? Theme.bg-hover : transparent;
    border-radius: Radius.md;
    border-width: Theme.hc-border != transparent ? 1px : 0px;
    border-color: Theme.hc-border;
    forward-focus: scope;
    accessible-role: button;
    accessible-label: root.a11y-label != "" ? root.a11y-label : root.board-name;
    accessible-expandable: true;
    accessible-expanded: root.menu-open;
    accessible-action-default => {
        root.menu-requested();
    }

    animate background { duration: Motion.instant; easing: Motion.out; }

    HorizontalLayout {
        // Tighter with a list name beside the board: the picker has about 100px at 320 and needs both names and the caret.
        padding-left: root.list-name == "" ? Space.s2 : Space.s1 + Space.s0-5;
        padding-right: root.list-name == "" ? Space.s2 : Space.s1;
        spacing: root.list-name == "" ? Space.s1 : Space.s0-5;
        alignment: root.list-name == "" ? LayoutAlignment.stretch : LayoutAlignment.start;
        Text {
            horizontal-stretch: root.list-name == "" ? 1 : 0;
            // With a list beside it both keep about six characters (the picker has ~135px at 320 with New icon-only).
            min-width: root.list-name == "" ? 0px : min(m-board.preferred-width, Type.md * 3.4);
            text: root.board-name;
            font-family: Fonts.sans;
            font-size: Type.md;
            font-weight: Type.medium;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.list-name != "": Text {
            text: "·";
            font-family: Fonts.sans;
            font-size: Type.md;
            color: Theme.text-tertiary;
            vertical-alignment: center;
            accessible-role: AccessibleRole.none;
        }
        if root.list-name != "": Text {
            horizontal-stretch: 0;
            min-width: min(m-list.preferred-width, Type.md * 3.4);
            text: root.list-name;
            font-family: Fonts.sans;
            font-size: Type.md;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: AccessibleRole.none;
        }
        Rectangle {
            width: Space.s4 * SystemLook.text-scale;
            Icon {
                source: Icons.caret-down;
                tint: Theme.text-secondary;
                size: Space.s3 * SystemLook.text-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    // 2px ring, 2px offset (DESIGN.md §2), keyboard focus only.
    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-width: scope.has-focus ? 2px : 0px;
        border-color: Theme.focus-ring;
        border-radius: Radius.md + 2px;
        background: transparent;
    }

    touch := TouchArea {
        clicked => {
            root.menu-requested();
        }
    }

    scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                root.menu-requested();
                return accept;
            }
            return reject;
        }
    }
}
