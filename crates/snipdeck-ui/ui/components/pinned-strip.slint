import { Theme, Type, Space, Radius, Motion, Fonts, SystemLook } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Icon } from "icon.slint";
import { ItemKind } from "item-card.slint";

export struct PinnedItem {
    title: string,
    kind: ItemKind,
}

// One pinned chip (Panel v2 spec 2.4): 28 tall, radius 6, `bg.hover` fill, the type glyph (16) and the title in
// `type.sm`; the title elides at `max-w`. One click uses the item (Shift+click copies).
component PinnedChip inherits Rectangle {
    in property <string> title;
    in property <ItemKind> kind: ItemKind.text;
    in property <length> max-w;
    callback use();
    callback copy();
    callback context-menu-requested(length, length);

    property <bool> focused: scope.has-focus;
    property <length> icon-size: Space.s4 * SystemLook.text-scale;
    property <length> natural-w: Space.s2 + root.icon-size + Space.s1 + Space.s0-5 + m-title.preferred-width + Space.s2;
    property <image> glyph: root.kind == ItemKind.text ? Icons.text-t
        : root.kind == ItemKind.template ? Icons.brackets-curly
        : root.kind == ItemKind.code ? Icons.code
        : root.kind == ItemKind.link ? Icons.link
        : root.kind == ItemKind.image ? Icons.image
        : root.kind == ItemKind.file ? Icons.file
        : Icons.lock;

    width: min(root.natural-w, root.max-w);
    height: max(Space.s6 + Space.s1, Type.line-sm + Space.s3);
    background: touch.pressed ? Theme.bg-sunken : touch.has-hover ? Theme.bg-overlay-hover : Theme.bg-hover;
    border-radius: Radius.md;
    border-width: Theme.hc-border != transparent ? 1px : 0px;
    border-color: Theme.hc-border;
    forward-focus: scope;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => {
        root.use();
    }

    animate background { duration: Motion.instant; easing: Motion.out; }

    m-title := Text {
        visible: false;
        text: root.title;
        font-family: Fonts.sans;
        font-size: Type.sm;
    }

    Icon {
        source: root.glyph;
        tint: Theme.text-secondary;
        size: root.icon-size;
        x: Space.s2;
        y: (parent.height - self.height) / 2;
    }
    Text {
        x: Space.s2 + root.icon-size + Space.s1 + Space.s0-5;
        width: max(0px, parent.width - self.x - Space.s2);
        height: parent.height;
        text: root.title;
        font-family: Fonts.sans;
        font-size: Type.sm;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }

    // 2px ring, 2px offset (DESIGN.md §2), keyboard focus only.
    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-width: scope.has-focus ? 2px : 0px;
        border-color: Theme.focus-ring;
        border-radius: Radius.md + 2px;
        background: transparent;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                if (event.button == PointerEventButton.left) {
                    if (touch.mouse-x >= 0 && touch.mouse-x <= touch.width && touch.mouse-y >= 0 && touch.mouse-y <= touch.height) {
                        if (event.modifiers.shift) {
                            root.copy();
                        } else {
                            root.use();
                        }
                    }
                } else if (event.button == PointerEventButton.right) {
                    root.context-menu-requested(touch.mouse-x, touch.mouse-y);
                }
            }
        }
    }

    scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                if (event.modifiers.shift) {
                    root.copy();
                } else {
                    root.use();
                }
                return accept;
            }
            if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                root.context-menu-requested(0px, root.height);
                return accept;
            }
            return reject;
        }
    }
}

// DESIGN.md §4 PinnedStrip (Panel v2 spec 2.4): up to two chips, then a visible "+N more" text button that asks the
// host to list the rest. No scrolling, no fade. 36 tall, 8px in on the left and 4px on the right.
export component PinnedStrip inherits Rectangle {
    in property <[PinnedItem]> items;
    // "+{} more" in the app's words.
    in property <string> more-label;
    callback use(int);
    callback copy(int);
    callback context-menu-requested(int, length, length);
    callback more-clicked();
    out property <bool> more-focused: more.has-focus;

    property <int> max-chips: 2;
    property <int> shown: min(root.items.length, root.max-chips);
    property <length> gap: Space.s1 + Space.s0-5;
    // What the chips share: the width less both paddings, the gaps between neighbours and the more button.
    property <length> chip-w: max(0px, (root.width - Space.s3 - (root.items.length > root.max-chips ? more.width + root.gap : 0px) - max(root.shown - 1, 0) * root.gap) / max(root.shown, 1));

    height: Space.s8 + Space.s1;

    // Placed by hand, not in a layout: the chips' widths follow this strip's, and a layout would feed its height
    // back into the Panel's column.
    if root.items.length > 0: Rectangle {
    chip0 := PinnedChip {
        title: root.items[0].title;
        kind: root.items[0].kind;
        max-w: root.chip-w;
        x: Space.s2;
        y: (root.height - self.height) / 2;
        use => { root.use(0); }
        copy => { root.copy(0); }
        context-menu-requested(x, y) => { root.context-menu-requested(0, x, y); }
    }
    if root.items.length > 1: chip1 := PinnedChip {
        title: root.items[1].title;
        kind: root.items[1].kind;
        max-w: root.chip-w;
        x: Space.s2 + chip0.width + root.gap;
        y: (root.height - self.height) / 2;
        use => { root.use(1); }
        copy => { root.copy(1); }
        context-menu-requested(x, y) => { root.context-menu-requested(1, x, y); }
    }
    }

    more := Rectangle {
        out property <bool> has-focus: more-scope.has-focus;
        visible: root.items.length > root.max-chips;
        width: more-text.preferred-width + 2 * Space.s2;
        height: Space.s6 + Space.s1;
        x: root.width - self.width - Space.s1;
        y: (root.height - self.height) / 2;
        border-radius: Radius.md;
        background: more-touch.pressed ? Theme.bg-sunken : more-touch.has-hover ? Theme.bg-hover : transparent;
        forward-focus: more-scope;
        accessible-role: button;
        accessible-label: root.more-label;
        accessible-expandable: true;
        accessible-action-default => { root.more-clicked(); }

        more-text := Text {
            x: Space.s2;
            width: self.preferred-width;
            height: parent.height;
            text: root.more-label;
            font-family: Fonts.sans;
            font-size: Type.sm;
            font-weight: Type.medium;
            color: Theme.accent-text;
            vertical-alignment: center;
            accessible-role: none;
        }
        Rectangle {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            border-width: more-scope.has-focus ? 2px : 0px;
            border-color: Theme.focus-ring;
            border-radius: Radius.md + 2px;
            background: transparent;
        }
        more-touch := TouchArea {
            clicked => { root.more-clicked(); }
        }
        more-scope := FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") {
                    root.more-clicked();
                    return accept;
                }
                return reject;
            }
        }
    }
}
