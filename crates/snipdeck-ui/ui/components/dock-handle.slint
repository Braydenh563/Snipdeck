import { Theme, Space, Radius } from "../theme.slint";

// DESIGN.md §5 Panel: the strip a docked Panel collapses to. The window is exactly this component, a
// few pixels thick (6px, set by the host) along one screen edge. It is a raised tab, like the Panel's
// own surface: `bg-overlay` with a 1px `border-strong` on the inner side and both ends (>= 4:1 against a
// white or a black wallpaper, so the tab is findable on either), the inner corners rounded, the screen
// side open. The accent shows only as the grip, a 2px pill in the middle in the colour of the list on
// show; hovering lengthens it and fills the tab with `bg-overlay-hover`. Hovering it or clicking it
// opens the Panel (the app decides which, from the Dock setting); the handle only reports. It never takes keyboard focus: the
// Panel hotkey is the keyboard way in. The accessible name says what the button does ("Open Snipdeck Panel"). The 6px thickness is the
// design's, an exception to the 24px hit-target rule: the strip sits against the screen edge, where a
// pointer cannot overshoot it. High contrast: Window fill, WindowText border, Highlight grip.
export component DockHandle inherits Rectangle {
    // The grip's colour: a list accent, or the theme accent.
    in property <color> accent: Theme.accent;
    // The strip runs up and down (left and right edges); false across (top and bottom).
    in property <bool> vertical: true;
    // The screen edge it sits on, in Settings' "Dock to" order: 1 left, 2 right, 3 top, 4 bottom.
    in property <int> edge: 2;
    // The accessible name: what this is and how to open it from the keyboard.
    in property <string> label;
    out property <bool> has-hover: touch.has-hover;
    callback hovered(on: bool);
    callback clicked();

    property <length> r: Radius.sm;
    property <length> pill-w: Space.s0-5;
    property <length> pill-l: touch.has-hover ? Space.s8 : Space.s5;

    // Outside the rounded inner corners the window's own background shows.
    background: Theme.bg-app;
    clip: true;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    // The tab overhangs the screen side by its radius, so only the inner corners are rounded and the
    // screen side has no border.
    Rectangle {
        x: root.edge == 1 ? -root.r : 0;
        y: root.edge == 3 ? -root.r : 0;
        width: root.vertical ? root.width + root.r : root.width;
        height: root.vertical ? root.height : root.height + root.r;
        border-radius: root.r;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: touch.has-hover ? Theme.bg-overlay-hover : Theme.bg-overlay;
    }

    Rectangle {
        x: root.vertical ? (root.width - root.pill-w) / 2 : (root.width - root.pill-l) / 2;
        y: root.vertical ? (root.height - root.pill-l) / 2 : (root.height - root.pill-w) / 2;
        width: root.vertical ? root.pill-w : root.pill-l;
        height: root.vertical ? root.pill-l : root.pill-w;
        border-radius: root.pill-w / 2;
        background: root.accent;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}
