import { MenuTexts } from "menu_texts.slint";

// The words of the command palette, one `CommandText` per command, in the order of `snipdeck-app`'s
// `Command::ALL` (a test there checks the length). `words` are the synonyms the filter also matches, so
// "add" finds New item and "hotkeys" finds Settings. The palette itself is drawn from rows the app builds
// from these texts, because the app does the filtering and Rust cannot reach `@tr`.
export struct CommandText {
    label: string,
    words: string,
}

export global CommandTexts {
    // The title of a duplicate: the host passes "{title}" and puts the original's title in its place, so the word order is the translator's.
    pure public function copy-title(title: string) -> string { return @tr("{} copy", title); }
    out property <[CommandText]> all: [
        { label: @tr("New item"), words: @tr("add create item note write") },
        { label: @tr("New list"), words: @tr("add create") },
        { label: @tr("Search"), words: @tr("find filter look") },
        { label: @tr("Show Panel"), words: @tr("open toggle deck hide") },
        { label: @tr("Symbols"), words: @tr("emoji kaomoji icons smiley emoticon insert") },
        { label: @tr("Colours"), words: @tr("color picker palette hex rgb hsl swatch contrast scheme") },
        { label: @tr("Saved colours"), words: @tr("colors palette swatches list library") },
        { label: @tr("Pick a colour from the screen"), words: @tr("eyedropper color pick sample screen") },
        { label: @tr("Open Picker"), words: @tr("quick find paste palette") },
        { label: @tr("Quick capture"), words: @tr("clipboard save grab screenshot") },
        { label: @tr("Paste next item"), words: @tr("stack queue sequence following paste") },
        { label: @tr("Take screenshot"), words: @tr("snip snipping capture screen picture image") },
        { label: @tr("Settings"), words: @tr("preferences options configure hotkeys theme backup") },
        { label: @tr("User guide"), words: @tr("help docs manual how") },
        { label: @tr("Welcome tour"), words: @tr("tutorial intro onboarding basics learn") },
        { label: @tr("Keyboard shortcuts"), words: @tr("hotkeys keys cheat sheet bindings chords") },
        { label: @tr("Troubleshoot…"), words: @tr("diagnose doctor problems fix") },
        { label: @tr("About Snipdeck"), words: @tr("version update") },
        { label: @tr("Support Snipdeck"), words: @tr("donate donation coffee tip") },
        { label: @tr("Main list density: Comfortable"), words: @tr("view mode layout cards rows height spacing switch") },
        { label: @tr("Main list density: Compact"), words: @tr("view mode layout list dense rows height spacing switch") },
        { label: @tr("Tile view"), words: @tr("view mode layout grid switch") },
        { label: @tr("Theme: System"), words: @tr("appearance colour dark light follow windows") },
        { label: @tr("Theme: Light"), words: @tr("appearance colour bright day") },
        { label: @tr("Theme: Dark"), words: @tr("appearance colour night") },
        { label: @tr("Use selected item"), words: @tr("paste insert send") },
        { label: @tr("Copy selected item"), words: @tr("clipboard") },
        { label: @tr("Duplicate selected item"), words: @tr("copy clone twice") },
        { label: @tr("Edit selected item"), words: @tr("change modify rename") },
        { label: @tr("Pin selected item"), words: @tr("favourite favorite keep") },
        { label: @tr("Unpin selected item"), words: @tr("favourite favorite remove") },
        { label: @tr("Move selected item to Trash"), words: @tr("delete remove discard") },
        { label: @tr("Select all items"), words: @tr("every mark choose all") },
        { label: @tr("Go to All items"), words: @tr("everything home show") },
        { label: @tr("Go to Pinned"), words: @tr("favourites favorites show") },
        { label: @tr("Go to Recent"), words: @tr("history clipboard show") },
        { label: @tr("Go to Trash"), words: @tr("deleted restore bin show") },
        { label: @tr("Reset Panel size and position"), words: @tr("window geometry default restore move resize cut off") },
        { label: @tr("Keep Panel open"), words: @tr("pin always on top stay hide click away blur") },
        { label: @tr("Show or hide sidebar"), words: @tr("navigation rail collapse expand lists panel left width") },
        { label: @tr("Group the selected rows"), words: @tr("make new folder together section collect") },
        { label: @tr("Fold or unfold a group"), words: @tr("collapse expand hide show toggle section") },
        { label: @tr("Rename group"), words: @tr("name title change edit section") },
        { label: @tr("Ungroup"), words: @tr("dissolve split remove group keep items section") },
        { label: @tr("Delete group"), words: @tr("remove trash discard section items") },
        { label: @tr("Move the group up"), words: @tr("reorder earlier raise section") },
        { label: @tr("Move the group down"), words: @tr("reorder later lower section") },
        { label: MenuTexts.group-colour(), words: @tr("colour color dot tint hue accent section") },
        { label: MenuTexts.group-nest(), words: @tr("nest under inside child sub subgroup indent parent move out top level section") },
        { label: @tr("Hide Panel"), words: @tr("close toggle deck stow") },
        { label: @tr("Close Panel when I click away"), words: @tr("keep open pin always on top stay hide blur") },
        { label: @tr("Undo"), words: @tr("back revert step history") },
        { label: @tr("Redo"), words: @tr("again forward step history") },
        { label: @tr("New board"), words: @tr("add create workspace group") },
        { label: @tr("Lock Snipdeck"), words: @tr("password secure private hide sensitive") },
        { label: @tr("Quit Snipdeck"), words: @tr("exit close stop end") },
        { label: @tr("Paste selected item as plain text"), words: @tr("unformatted insert send without formatting") },
        { label: @tr("Restore selected item"), words: @tr("bring back undelete trash recover") },
        { label: @tr("Delete selected item for good"), words: @tr("remove erase permanently trash") },
        { label: @tr("Import snippets"), words: @tr("ditto copyq espanso restore bring in file") },
        { label: @tr("Export library"), words: @tr("save file download copy out") },
        { label: @tr("Back up now"), words: @tr("backup copy save safe") },
        { label: @tr("Empty Trash"), words: @tr("delete everything bin permanently") },
    ];
    // Why a listed command cannot run now (shown dimmed on its row).
    out property <string> hint-symbols-off: @tr("Turn on the Symbols tab in Settings");
    out property <string> hint-colours-off: @tr("Turn on the Colours tab in Settings");
    // The rows that go to a board, a list or a tag by name (shown once something is typed).
    pure public function go-to-board(name: string) -> string {
        return @tr("Go to board “{}”", name);
    }
    pure public function go-to-list(name: string, board: string) -> string {
        return @tr("Go to list “{}” on {}", name, board);
    }
    pure public function go-to-tag(name: string) -> string {
        return @tr("Go to tag “{}”", name);
    }
    // The palette's own words.
    out property <string> palette-title: @tr("Commands");
    out property <string> palette-placeholder: @tr("Type a command");
}
