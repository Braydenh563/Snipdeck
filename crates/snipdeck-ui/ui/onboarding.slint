// The welcome tour (V1-PLAN 7a): one regular window, four steps, shown on a first run with an empty library and from
// Help. Welcome (what the Panel, the Picker and the shortcuts do, and the one choice to keep what you copy),
// Shortcuts (the Settings recorders), Panel (one visual choice: floating or docked to the right edge) and Start-up
// (start with Windows, keep running in the tray). Taskbar, hide-on-blur and the other edges are in Settings.
//
// Like Settings, every choice applies at once: the page reports it as a callback and the host stores it. The host owns
// `step`; Back, Next and Skip are callbacks. Skip is on every step; Esc is Back, and Skip on the first step. Closing the window skips too.
// Keyboard: Tab / Shift+Tab move between the controls of the step; a shortcut recorder starts on Enter or Space.
import { Theme, Type, Space, Radius, Fonts, Palette, SystemLook } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "components/icon.slint";
import { Button, ButtonSize, ButtonVariant } from "components/button.slint";
import { Toggle } from "components/choice.slint";
import { HotkeyRecorder } from "components/hotkey_recorder.slint";
import { HotkeyHealthLine } from "components/hotkey_health.slint";
import { FieldError } from "components/text_field.slint";
import { FormSection, SettingRow, Segmented } from "components/form.slint";
import { HotkeySetting } from "settings.slint";

// One thing the welcome step explains: a glyph, a name and a sentence.
component Feature inherits HorizontalLayout {
    in property <image> glyph;
    in property <string> title;
    in property <string> description;

    spacing: Space.s4;
    padding-top: Space.s2;
    padding-bottom: Space.s2;
    accessible-role: groupbox;
    accessible-label: root.title;
    accessible-description: root.description;

    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 40px * SystemLook.text-scale;
            height: 40px * SystemLook.text-scale;
            background: Theme.bg-surface;
            border-radius: Radius.lg;
            border-width: 1px;
            border-color: Theme.border-subtle;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 22px * SystemLook.text-scale;
                source: root.glyph;
                tint: Theme.text-primary;
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        min-width: 0px;
        alignment: start;
        spacing: Space.s0-5;
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-family: Fonts.sans;
            font-size: Type.base;
            font-weight: Type.semibold;
            wrap: word-wrap;
            accessible-role: none;
        }
        Text {
            text: root.description;
            color: Theme.text-secondary;
            font-family: Fonts.sans;
            font-size: Type.sm;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}

// One of the two picture cards of the Panel step: a miniature screen showing where the panel sits, its name and a
// sentence. One tab stop; Space or Enter chooses; the check and the thick border say "chosen" without colour.
component PanelChoice inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    // True draws the panel fixed against the right edge; false draws it loose, away from the edge.
    in property <bool> docked;
    in property <bool> selected;
    callback chosen();

    property <bool> focused: scope.has-focus;

    horizontal-stretch: 1;
    min-width: 0px;
    forward-focus: scope;
    border-radius: Radius.lg;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.text-primary : Theme.border-strong;
    background: touch.pressed ? Theme.bg-sunken : touch.has-hover ? Theme.bg-hover : Theme.bg-surface;
    accessible-role: AccessibleRole.radio-button;
    accessible-label: root.label;
    accessible-description: root.hint;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.chosen(); }

    VerticalLayout {
        padding: Space.s3;
        spacing: Space.s2;
        // The miniature screen: an app window behind, the panel in front.
        Rectangle {
            height: 84px * SystemLook.text-scale;
            background: Theme.bg-sunken;
            border-radius: Radius.md;
            border-width: 1px;
            border-color: Theme.border-subtle;
            Rectangle {
                x: Space.s2;
                y: Space.s2;
                width: parent.width * 0.55;
                height: parent.height - 2 * Space.s2;
                background: Theme.bg-app;
                border-radius: Radius.sm;
                border-width: 1px;
                border-color: Theme.border-default;
            }
            Rectangle {
                x: root.docked ? parent.width - self.width - 1px : parent.width * 0.42;
                y: root.docked ? 1px : parent.height * 0.18;
                width: parent.width * 0.26;
                height: root.docked ? parent.height - 2px : parent.height * 0.6;
                background: Theme.bg-surface;
                border-radius: root.docked ? Radius.sm : Radius.md;
                border-width: 2px;
                border-color: Theme.text-primary;
            }
        }
        HorizontalLayout {
            spacing: Space.s1;
            Text {
                horizontal-stretch: 1;
                text: root.label;
                color: Theme.text-primary;
                font-family: Fonts.sans;
                font-size: Type.base;
                font-weight: Type.semibold;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.selected: Icon {
                source: Icons.check;
                size: Space.s4 * SystemLook.text-scale;
                tint: Theme.text-primary;
            }
        }
        Text {
            text: root.hint;
            color: Theme.text-secondary;
            font-family: Fonts.sans;
            font-size: Type.sm;
            wrap: word-wrap;
            accessible-role: none;
        }
    }

    // 2px ring, 2px offset (DESIGN.md section 2).
    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-width: root.focused ? 2px : 0px;
        border-color: Theme.focus-ring;
        border-radius: Radius.lg + 2px;
        background: transparent;
    }

    touch := TouchArea {
        clicked => { root.chosen(); }
    }

    scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.chosen();
                return accept;
            }
            return reject;
        }
    }
}

export component OnboardingWindow inherits Window {
    title: @tr("Welcome to Snipdeck");
    background: Theme.bg-app;
    min-width: 420px;
    min-height: 360px;
    preferred-width: root.wanted-width;
    preferred-height: root.wanted-height;

    // The size the window opens at; the host cuts it to the screen before the window exists.
    out property <length> wanted-width: 560px;
    out property <length> wanted-height: 540px;

    in property <bool> dark: false;
    // The step shown, 0 to `step-count - 1`: Welcome, Shortcuts, Panel, Start-up.
    in property <int> step: 0;
    in property <int> step-count: 4;
    // In the order of Settings: show or hide the panel, open the picker, capture, paste next.
    in property <[HotkeySetting]> hotkeys;
    in-out property <bool> autostart: false;
    in-out property <bool> close-to-tray: true;
    // Clipboard history (the Recent inbox): on for a new install; the person can turn it off here or in Settings.
    in-out property <bool> recent-history: true;
    // How many copies and how many days the history keeps (the description names them).
    in property <int> recent-max-entries: 200;
    in property <int> recent-max-days: 7;
    in property <int> dock-edge-index: 0;
    // The host puts a refusal here (the start-up entry could not be changed).
    in property <string> notice;

    callback hotkey-recorded(index: int, combo: string);
    callback hotkey-cleared(index: int);
    callback hotkey-test-requested(index: int);
    callback dock-edge-chosen(index: int);
    callback autostart-toggled(on: bool);
    callback close-to-tray-toggled(on: bool);
    callback recent-history-toggled(on: bool);
    callback back-requested();
    callback next-requested();
    callback skip-requested();
    // "See the tips" on the last step: the host opens Help on its Tips tab.
    callback tips-requested();

    property <[string]> hotkey-names: [
        @tr("Show or hide the panel"),
        @tr("Open the picker"),
        @tr("Save the clipboard as an item"),
        @tr("Paste the next item"),
    ];
    property <bool> last: root.step >= root.step-count - 1;

    // The window opens with the focus on its key scope, so Esc skips the tour before any Tab.
    init => {
        Palette.dark = root.dark;
        scope.focus();
    }
    changed dark => { Palette.dark = root.dark; }

    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                // Esc backs out one step; only the first step has nothing before it, so there it skips.
                if (root.step > 0) {
                    root.back-requested();
                } else {
                    root.skip-requested();
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: Space.s6;
            spacing: Space.s4;

            // Which step this is, and its heading.
            VerticalLayout {
                spacing: Space.s1;
                Text {
                    text: @tr("Step {} of {}", root.step + 1, root.step-count);
                    color: Theme.text-secondary;
                    font-family: Fonts.sans;
                    font-size: Type.sm;
                    accessible-role: AccessibleRole.text;
                    accessible-label: self.text;
                }
                Text {
                    text: root.step == 0 ? @tr("Welcome to Snipdeck")
                        : root.step == 1 ? @tr("Your shortcuts")
                        : root.step == 2 ? @tr("Where the panel sits")
                        : @tr("Start-up");
                    color: Theme.text-primary;
                    font-family: Fonts.sans;
                    font-size: Type.xl;
                    font-weight: Type.semibold;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                    accessible-label: self.text;
                    accessible-live-region: polite;
                }
            }

            // The step's content. Only one exists at a time.
            VerticalLayout {
                vertical-stretch: 1;
                alignment: start;
                spacing: Space.s2;

                if root.step == 0: VerticalLayout {
                    spacing: Space.s3;
                    Text {
                        text: @tr("Snipdeck keeps the text you paste again and again, one shortcut away. The basics:");
                        color: Theme.text-secondary;
                        font-family: Fonts.sans;
                        font-size: Type.base;
                        wrap: word-wrap;
                        accessible-role: none;
                    }
                    Feature {
                        glyph: Icons.sidebar-simple;
                        title: @tr("The panel");
                        description: @tr("A strip of your snippets beside the app you are working in. Click one to paste it there.");
                    }
                    Feature {
                        glyph: Icons.magnifying-glass;
                        title: @tr("The picker");
                        description: @tr("Search every board and paste without opening the window.");
                    }
                    Feature {
                        glyph: Icons.keyboard;
                        title: @tr("Shortcuts");
                        description: @tr("Bring up the panel, open the picker, save the clipboard or paste the next item from any app.");
                    }
                    Feature {
                        glyph: Icons.clock;
                        title: @tr("Also keep what I copy?");
                        description: @tr("Recent keeps the text you copy, on this computer only, for the last {} copies or {} days, whichever comes first. Passwords from password managers and Sensitive items are never kept. You can change this any time in Settings.", root.recent-max-entries, root.recent-max-days);
                    }
                    Segmented {
                        label: @tr("Also keep what I copy?");
                        options: [@tr("Yes"), @tr("Not now")];
                        current: root.recent-history ? 0 : 1;
                        chosen(i) => { root.recent-history-toggled(i == 0); }
                    }
                }

                if root.step == 1: FormSection {
                    title: @tr("Shortcuts");
                    for hk[i] in root.hotkeys: SettingRow {
                        title: root.hotkey-names[i];
                        VerticalLayout {
                            spacing: Space.s1;
                            HotkeyRecorder {
                                width: 220px * SystemLook.text-scale;
                                label: root.hotkey-names[i];
                                keys: hk.keys;
                                value: hk.value;
                                conflict: hk.conflict;
                                empty-text: @tr("Not set");
                                recording-text: @tr("Press the new shortcut");
                                clear-label: @tr("Clear the shortcut for {}", root.hotkey-names[i]);
                                recorded(combo) => { root.hotkey-recorded(i, combo); }
                                cleared => { root.hotkey-cleared(i); }
                            }
                            HotkeyHealthLine {
                                width: 220px * SystemLook.text-scale;
                                name: root.hotkey-names[i];
                                state: hk.state;
                                alternatives: hk.alternatives;
                                test => { root.hotkey-test-requested(i); }
                                use-chord(chord) => { root.hotkey-recorded(i, chord); }
                            }
                        }
                    }
                }

                if root.step == 2: VerticalLayout {
                    spacing: Space.s3;
                    Text {
                        text: @tr("Pick how the panel sits. You can change this any time in Settings, along with the other edges, hiding when you switch apps and the taskbar button.");
                        color: Theme.text-secondary;
                        font-family: Fonts.sans;
                        font-size: Type.base;
                        wrap: word-wrap;
                        accessible-role: none;
                    }
                    HorizontalLayout {
                        spacing: Space.s3;
                        PanelChoice {
                            label: @tr("Floating");
                            hint: @tr("A small window you can drag anywhere.");
                            docked: false;
                            selected: root.dock-edge-index == 0;
                            chosen => { root.dock-edge-chosen(0); }
                        }
                        PanelChoice {
                            label: @tr("Docked to the right");
                            hint: @tr("At the right edge of the screen. It tucks into a thin tab and slides out when the pointer comes to it.");
                            docked: true;
                            selected: root.dock-edge-index == 2;
                            chosen => { root.dock-edge-chosen(2); }
                        }
                    }
                }

                if root.step == 3: FormSection {
                    title: @tr("Window behaviour");
                    SettingRow {
                        title: @tr("Start with Windows");
                        description: @tr("Snipdeck waits in the tray so the shortcuts work after you sign in.");
                        Toggle {
                            a11y-label: @tr("Start with Windows");
                            checked <=> root.autostart;
                            toggled(on) => { root.autostart-toggled(on); }
                        }
                    }
                    SettingRow {
                        title: @tr("Keep running in the tray when the window closes");
                        description: @tr("Turn this off and closing the Panel or the Main window quits Snipdeck.");
                        Toggle {
                            a11y-label: @tr("Keep running in the tray when the window closes");
                            checked <=> root.close-to-tray;
                            toggled(on) => { root.close-to-tray-toggled(on); }
                        }
                    }
                    if root.notice != "": FieldError {
                        text: root.notice;
                    }
                }

                if root.step == 3: FormSection {
                    title: @tr("Tips");
                    SettingRow {
                        title: @tr("Ten short tips");
                        description: @tr("What Snipdeck can do, with a picture and a button to try each one. You can open them again from Help.");
                        Button {
                            text: @tr("See the tips");
                            clicked => { root.tips-requested(); }
                        }
                    }
                }
            }

            // Skip is on every step; Back from the second; Next becomes the last step's button.
            HorizontalLayout {
                spacing: Space.s2;
                Button {
                    text: @tr("Skip");
                    variant: ButtonVariant.ghost;
                    clicked => { root.skip-requested(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.step > 0: Button {
                    text: @tr("Back");
                    clicked => { root.back-requested(); }
                }
                Button {
                    text: root.last ? @tr("Get started") : @tr("Next");
                    variant: ButtonVariant.primary;
                    clicked => { root.next-requested(); }
                }
            }
        }
    }
}
