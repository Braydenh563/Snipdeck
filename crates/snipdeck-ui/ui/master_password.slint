// The master password (SPEC 5.7, V1-PLAN C3): the words every window uses for it, the form that sets, changes
// or removes it (a section of the Settings page), and the window that asks for it.
//
// Nothing here knows the password rules or touches the store: the host says what went wrong (`MasterProblem`) and how
// strong a typed password is (a pure callback), and the window words it. Passwords are typed into fields whose
// `input-type` is `password`: drawn as bullets, and not exposed to a screen reader or copied.
import { Theme, Type, Space, Radius, Fonts, Palette } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "components/icon.slint";
import { Button, ButtonVariant } from "components/button.slint";
import { TextField, FieldError } from "components/text_field.slint";

// What the host found wrong with what was typed or done. Never carries the password.
export enum MasterProblem {
    none,
    // The current (or unlock) password field is empty.
    current-empty,
    // The current (or unlock) password is not the one set.
    wrong-password,
    // The new password is empty or shorter than the minimum.
    too-short,
    // The two new passwords differ.
    mismatch,
    // Free plan: a master password is a Supporter feature.
    supporter-only,
    // This PC cannot protect the library key, so there is nothing to put a password on.
    unavailable,
    // The store refused or the key could not be changed; nothing changed.
    failed,
}

// Which action the form is set up for.
export enum MasterMode { closed, set, change, remove }

export global MasterTexts {
    public pure function problem(p: MasterProblem, min-length: int) -> string {
        if (p == MasterProblem.current-empty) {
            return @tr("Enter your password.");
        }
        if (p == MasterProblem.wrong-password) {
            return @tr("That password is not right. Try again.");
        }
        if (p == MasterProblem.too-short) {
            return @tr("Use at least {} characters.", min-length);
        }
        if (p == MasterProblem.mismatch) {
            return @tr("The two passwords are not the same.");
        }
        if (p == MasterProblem.supporter-only) {
            return @tr("A master password is part of Supporter.");
        }
        if (p == MasterProblem.unavailable) {
            return @tr("Snipdeck can't protect a key on this PC, so a master password is not available.");
        }
        if (p == MasterProblem.failed) {
            return @tr("The library could not be unlocked or changed. Nothing was changed.");
        }
        return "";
    }

    // The word for a strength level: 0 weak, 1 fair, 2 good, 3 strong.
    public pure function strength(level: int) -> string {
        if (level <= 0) {
            return @tr("Strength: weak");
        }
        if (level == 1) {
            return @tr("Strength: fair");
        }
        if (level == 2) {
            return @tr("Strength: good");
        }
        return @tr("Strength: strong");
    }

    public pure function recovery-warning() -> string {
        return @tr("If you forget this password, your sensitive items can never be opened again. Snipdeck cannot reset it and keeps no recovery key. Your other items are not affected.");
    }

    public pure function remove-note() -> string {
        return @tr("Your sensitive items will be protected by Windows alone, as on the Free plan.");
    }

    // The status while the key is being worked out, which takes a moment on purpose.
    public pure function saving() -> string {
        return @tr("Saving…");
    }

    public pure function unlocking() -> string {
        return @tr("Unlocking…");
    }

    public pure function title(mode: MasterMode) -> string {
        if (mode == MasterMode.change) {
            return @tr("Change master password");
        }
        if (mode == MasterMode.remove) {
            return @tr("Remove master password");
        }
        return @tr("Set master password");
    }

    public pure function submit(mode: MasterMode) -> string {
        if (mode == MasterMode.change) {
            return @tr("Change password");
        }
        if (mode == MasterMode.remove) {
            return @tr("Remove password");
        }
        return @tr("Set password");
    }
}

// The three fields and the buttons of the set / change / remove form. Esc cancels the form (and nothing else),
// Enter in the last field submits, and the first field takes the focus each time `focus-request` goes up. The
// host reads the typed passwords from the `submitted` callback and clears them by closing the form.
export component MasterPasswordForm inherits VerticalLayout {
    in property <MasterMode> mode: MasterMode.set;
    in property <MasterProblem> problem: MasterProblem.none;
    in property <int> min-length: 8;
    in property <int> focus-request: 0;
    // The host is working out the key (a moment, on purpose): the buttons wait and the status says so.
    in property <bool> busy: false;
    // Counts up when a field takes the focus, so the page can scroll it into view.
    callback revealed(y: length, height: length);
    pure callback strength(password: string) -> int;
    callback submitted(current: string, new: string, again: string);
    callback cancelled();

    in-out property <string> current;
    in-out property <string> new-password;
    in-out property <string> again;

    property <bool> asks-current: root.mode == MasterMode.change || root.mode == MasterMode.remove;
    property <bool> asks-new: root.mode == MasterMode.set || root.mode == MasterMode.change;
    property <int> level: root.strength(root.new-password);
    // Goes up when a button that had the focus is disabled by `busy`: the first field takes it.
    property <int> focus-bump: 0;
    changed busy => {
        if (root.busy && (form-cancel.has-focus || form-submit.has-focus)) {
            root.focus-bump += 1;
        }
    }

    function submit() {
        if (!root.busy) {
            root.submitted(root.current, root.new-password, root.again);
        }
    }

    spacing: Space.s2;
    padding-top: Space.s2;
    accessible-role: groupbox;
    accessible-label: MasterTexts.title(root.mode);
    // The warning is the group's description: its own text is hidden from the tree so it is read once.
    accessible-description: root.mode == MasterMode.remove ? MasterTexts.remove-note() : MasterTexts.recovery-warning();

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (!root.busy) {
                    root.cancelled();
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: Space.s2;
            // The warning is an icon and words, not colour alone.
            HorizontalLayout {
                spacing: Space.s2;
                alignment: start;
                Icon {
                    source: Icons.warning;
                    tint: Theme.danger-fg;
                    y: (Type.line-base - self.height) / 2;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.mode == MasterMode.remove ? MasterTexts.remove-note() : MasterTexts.recovery-warning();
                    color: Theme.text-primary;
                    font-family: Fonts.sans;
                    font-size: Type.base;
                    wrap: word-wrap;
                    accessible-role: none;
                }
            }
            if root.asks-current: TextField {
                text <=> root.current;
                read-only: root.busy;
                focus-request: root.focus-request + root.focus-bump;
                input-type: InputType.password;
                label: @tr("Current password");
                placeholder: @tr("Current password");
                error: root.problem == MasterProblem.current-empty || root.problem == MasterProblem.wrong-password
                    ? MasterTexts.problem(root.problem, root.min-length) : "";
                accepted(t) => { if (!root.asks-new) { root.submit(); } }
                changed has-focus => {
                    if (self.has-focus) { root.revealed(self.absolute-position.y, self.height); }
                }
            }
            if root.asks-new: TextField {
                text <=> root.new-password;
                read-only: root.busy;
                focus-request: root.asks-current ? 0 : root.focus-request + root.focus-bump;
                input-type: InputType.password;
                label: @tr("New password");
                placeholder: @tr("New password");
                error: root.problem == MasterProblem.too-short ? MasterTexts.problem(root.problem, root.min-length) : "";
                changed has-focus => {
                    if (self.has-focus) { root.revealed(self.absolute-position.y, self.height); }
                }
            }
            if root.asks-new: Text {
                // A hint, in words (not a colour or a bar): the minimum length is what the host enforces.
                text: root.new-password == ""
                    ? @tr("At least {} characters. A few unrelated words make a good password.", root.min-length)
                    : MasterTexts.strength(root.level);
                color: Theme.text-secondary;
                font-family: Fonts.sans;
                font-size: Type.sm;
                wrap: word-wrap;
                accessible-role: AccessibleRole.text;
                accessible-live-region: polite;
            }
            if root.asks-new: TextField {
                text <=> root.again;
                read-only: root.busy;
                input-type: InputType.password;
                label: @tr("Repeat the new password");
                placeholder: @tr("Repeat the new password");
                error: root.problem == MasterProblem.mismatch ? MasterTexts.problem(root.problem, root.min-length) : "";
                accepted(t) => { root.submit(); }
                changed has-focus => {
                    if (self.has-focus) { root.revealed(self.absolute-position.y, self.height); }
                }
            }
            if root.problem == MasterProblem.supporter-only || root.problem == MasterProblem.unavailable
                || root.problem == MasterProblem.failed: FieldError {
                text: MasterTexts.problem(root.problem, root.min-length);
            }
            HorizontalLayout {
                spacing: Space.s2;
                Text {
                    horizontal-stretch: 1;
                    text: root.busy ? MasterTexts.saving() : "";
                    color: Theme.text-secondary;
                    font-family: Fonts.sans;
                    font-size: Type.sm;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-live-region: polite;
                }
                form-cancel := Button {
                    text: @tr("Cancel");
                    enabled: !root.busy;
                    clicked => { root.cancelled(); }
                    changed has-focus => {
                        if (self.has-focus) { root.revealed(self.absolute-position.y, self.height); }
                    }
                }
                form-submit := Button {
                    text: MasterTexts.submit(root.mode);
                    variant: ButtonVariant.primary;
                    enabled: !root.busy;
                    clicked => { root.submit(); }
                    changed has-focus => {
                        if (self.has-focus) { root.revealed(self.absolute-position.y, self.height); }
                    }
                }
            }
        }
    }
}

// The window that asks for the master password: once a session, when a sensitive item is first needed, and again
// after the idle time. The host shows it, reads `submitted` and answers with `problem` (and clears `password`); Esc
// or Cancel closes it without unlocking, and the item that asked for the library stays locked.
export component UnlockWindow inherits Window {
    title: @tr("Unlock Snipdeck");
    background: Theme.bg-app;
    min-width: 340px;
    preferred-width: 440px;
    preferred-height: root.wanted-height;
    out property <length> wanted-width: 440px;
    out property <length> wanted-height: content.preferred-height;

    in property <bool> dark: false;
    in property <MasterProblem> problem: MasterProblem.none;
    // Goes up each time the host wants the password field focused (the window shown, a wrong password).
    in property <int> focus-request: 0;
    // The host is working out the key (a moment, on purpose): the buttons wait and the status says so.
    in property <bool> busy: false;
    in-out property <string> password;
    // Goes up when a button that had the focus is disabled by `busy`: the field takes it.
    property <int> focus-bump: 0;
    changed busy => {
        if (root.busy && (unlock-cancel.has-focus || unlock-submit.has-focus)) {
            root.focus-bump += 1;
        }
    }
    callback submitted(password: string);
    callback cancelled();

    init => { Palette.dark = root.dark; }
    changed dark => { Palette.dark = root.dark; }

    function submit() {
        if (!root.busy) {
            root.submitted(root.password);
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (!root.busy) {
                    root.cancelled();
                }
                return accept;
            }
            return reject;
        }

        content := VerticalLayout {
            padding: Space.s4;
            spacing: Space.s3;
            alignment: start;
            accessible-role: groupbox;
            accessible-label: @tr("Unlock Snipdeck");
            Text {
                text: @tr("Unlock your sensitive items");
                color: Theme.text-primary;
                font-family: Fonts.sans;
                font-size: Type.lg;
                font-weight: Type.semibold;
                wrap: word-wrap;
                accessible-role: none;
            }
            Text {
                text: @tr("Enter your master password to use the sensitive items in your library. Your other items are always available.");
                color: Theme.text-secondary;
                font-family: Fonts.sans;
                font-size: Type.base;
                wrap: word-wrap;
                accessible-role: none;
            }
            TextField {
                text <=> root.password;
                read-only: root.busy;
                focus-request: root.focus-request + root.focus-bump;
                input-type: InputType.password;
                label: @tr("Master password");
                placeholder: @tr("Master password");
                error: MasterTexts.problem(root.problem, 8);
                accepted(t) => { root.submit(); }
            }
            HorizontalLayout {
                spacing: Space.s2;
                Text {
                    horizontal-stretch: 1;
                    text: root.busy ? MasterTexts.unlocking() : "";
                    color: Theme.text-secondary;
                    font-family: Fonts.sans;
                    font-size: Type.sm;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-live-region: polite;
                }
                unlock-cancel := Button {
                    text: @tr("Cancel");
                    enabled: !root.busy;
                    clicked => { root.cancelled(); }
                }
                unlock-submit := Button {
                    text: @tr("Unlock");
                    variant: ButtonVariant.primary;
                    enabled: !root.busy;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}
