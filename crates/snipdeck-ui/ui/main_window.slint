// The Main window (DESIGN.md §5 Main window, ADR-0008): the full manager. A sidebar (board switcher, system
// views, lists, tags), a toolbar that doubles as the title bar, and the item area (comfortable and compact rows,
// or a tile grid), with multi-select, a bulk-action bar, a context menu and a status line. It keeps the OS
// caption buttons (ADR-0008): the toolbar leaves `SystemLook.caption-inset` free at the top right and draws no
// close button; empty parts of it start the window drag.
//
// Data comes in as plain structs and models; every gesture leaves as a callback. Nothing here talks to the OS.
// Selection is the host's: the window reports `select-requested(index, mode)` for a click or a key and the host
// answers by writing `rows[i].selected` and `selected-count` (`snipdeck_ui::selection` does that in Rust).
//
// Keyboard (each region is one tab stop; arrows move inside it):
//   sidebar   Up / Down / Home / End move, Enter or Space opens the view, Menu or Shift+F10 the context menu,
//             Alt+Up / Alt+Down move a list (`list-reorder-requested`)
//   items     Up / Down (Left / Right in tiles) move and select, Shift extends, Ctrl+Space toggles, Ctrl+A all,
//             Enter uses, Shift+Enter copies, F2 or Ctrl+E edits, Ctrl+D duplicates, Ctrl+P pins, Delete deletes, Esc clears
//             the selection, Menu or Shift+F10 the context menu, hold Space reveals a sensitive item,
//             Alt+Up / Alt+Down move the row within its list (`item-reorder-requested`)
//   anywhere  Ctrl+F or / search, Ctrl+N new item, Ctrl+K (or Ctrl+Shift+P) the command palette, Ctrl+, Settings,
//             Ctrl+/ the keyboard shortcuts, F1 the user guide
import { ListView } from "std-widgets.slint";
import { Theme, Type, Space, Radius, Motion, Fonts, SystemLook, Palette, ListHue } from "theme.slint";
import { Icons } from "icons.slint";
import { RepaintNudge } from "components/repaint.slint";
import { Icon } from "components/icon.slint";
import { KeyCombo } from "components/keycap.slint";
import { ItemCard, ItemKind, ItemCardVariant } from "components/item-card.slint";
import { DeckEdge, DeckEdgePosition } from "components/deck-edge.slint";
import { OverlayScrollbar } from "components/scrollbar.slint";
import { SidebarItem, SidebarItemKind } from "components/sidebar-item.slint";
import { BoardSwitcher } from "components/board-switcher.slint";
import { SearchField } from "components/text_field.slint";
import { Button, ButtonVariant, ButtonSize } from "components/button.slint";
import { IconButton, IconButtonSize } from "components/icon-button.slint";
import { EmptyState, EmptyStateKind } from "components/empty_state.slint";
import { Toast, ToastKind, ToastPhase, Skeleton, SkeletonKind, Tooltip } from "components/feedback.slint";
import { Menu, MenuEntry } from "components/menu.slint";
import { SuggestDropdown, SuggestRow } from "components/suggest-dropdown.slint";
import { Dialog, DialogVariant } from "components/dialog.slint";
import { Chooser, ChoiceEntry } from "components/chooser.slint";
import { MenuTexts } from "menu_texts.slint";
import { GroupHeader } from "components/group-header.slint";
import { LabelChip } from "components/label-chip.slint";
import { QuickAdd } from "components/quick-add.slint";
import { CommandPalette, PaletteRow } from "components/command-palette.slint";
import { CommandTexts } from "command_texts.slint";
import { RecentRow, RecentText } from "panel.slint";

export { ChoiceEntry, PaletteRow }

// One item of the item area. `selected` is written by the host (see the file header).
export struct MainRow {
    kind: ItemKind,
    title: string,
    // In a search: the title is `mark-before` + `mark-text` + the rest, the preview (windowed to the match)
    // `preview-before` + `preview-match` + the rest, and `tag-hit` names a tag that matched when neither shows it.
    mark-before: string,
    mark-text: string,
    preview: string,
    preview-before: string,
    preview-match: string,
    tag-hit: string,
    // Stands in for a sensitive item's preview.
    masked-preview: string,
    // Mixed views (search, All items, Pinned, Recent): the list the item lives in, with its colour.
    list-name: string,
    list-color: color,
    // The item's colour label (-1 none, else 0 to 7 in the order of `ItemLabel`) and its name.
    label: int,
    label-name: string,
    image: image,
    pinned: bool,
    selected: bool,
    // A group's header takes the place of a card: `title` is its name, `group-count` its items, `group-collapsed`
    // whether they are hidden. `grouped`: the item sits under a header, so its card is indented.
    is-header: bool,
    group-count: int,
    group-collapsed: bool,
    grouped: bool,
}

// One chip of the colour-label filter row: `label` is 0 to 7 in the order blue, teal, green, amber, orange, red,
// violet, slate (the host's `ItemLabel`), `name` its name, `count` the items in the view that carry it.
export struct LabelChipEntry {
    label: int,
    name: string,
    count: int,
}

// What the sidebar has open. `list` and `tag` come with an index into `lists` / `tags`.
export enum MainSection { all, pinned, recent, trash, list, tag }
export enum MainView { comfortable, compact, tile }
// How a click or key changes the selection.
export enum SelectMode { replace, toggle, extend }
// What the context menu, the bulk bar and the shortcuts ask for. The host applies it to the selection when
// `selected-count` > 1, else to the row the index names.
export enum ItemAction { use, copy, edit, duplicate, pin, move, tag, paste-as, delete, restore, delete-forever }

// The pages the Help menu and its shortcuts open (the host's HelpTopic). "Show Panel" is not one: it has its own
// callback. Named so the menu's row order and the keys (F1, Ctrl+/) cannot drift apart from the host's mapping.
export enum HelpPage { troubleshoot, guide, about, shortcuts }

// A toolbar button that shows its words: a ghost button (h32, `type.base` 500) with an optional key combo or a caret
// after the label. Below the width `compact` is set by the window it is icon-only, with the same name for assistive
// technology and the window's tooltip.
component ToolbarButton inherits Rectangle {
    in property <string> label;
    // The spoken name, and the tooltip text of the icon-only form.
    in property <string> tooltip;
    in property <image> icon;
    in property <bool> caret: false;
    in property <[string]> keys;
    in property <bool> compact: false;
    in property <bool> active: false;
    in property <length> h: 32px;
    out property <bool> has-hover: touch.has-hover;
    out property <bool> has-focus: scope.has-focus;
    callback clicked();

    height: root.h;
    width: root.compact ? root.h : max(root.h, row.preferred-width);
    border-radius: Radius.md;
    background: touch.pressed ? Theme.bg-selected : touch.has-hover ? Theme.bg-hover : root.active ? Theme.bg-selected : transparent;
    forward-focus: scope;
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Motion.instant; easing: Motion.out; }

    row := HorizontalLayout {
        padding-left: root.compact ? 0px : Space.s2;
        padding-right: root.compact ? 0px : Space.s2;
        spacing: Space.s2;
        alignment: center;
        if root.compact: Icon {
            source: root.icon;
            size: Space.s5 * SystemLook.text-scale;
            tint: root.active ? Theme.accent-text : Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }
        if !root.compact: label-text := Text {
            text: root.label;
            color: Theme.text-primary;
            font-family: Fonts.sans;
            font-size: Type.base;
            font-weight: Type.medium;
            vertical-alignment: center;
        }
        if !root.compact && root.keys.length > 0: Rectangle {
            width: combo.min-width;
            combo := KeyCombo {
                keys: root.keys;
                y: (parent.height - self.height) / 2;
            }
        }
        if !root.compact && root.caret: Icon {
            source: Icons.caret-down;
            size: Space.s4 * SystemLook.text-scale;
            tint: Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }
    }

    // 2px ring, 2px offset (DESIGN.md §2).
    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-width: scope.has-focus ? 2px : 0px;
        border-color: Theme.focus-ring;
        border-radius: Radius.md + 2px;
        background: transparent;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

// One item card, mapped from a row.
component MainCard inherits ItemCard {
    in property <MainRow> data;

    pick-mode: true;
    numbered: false;
    keyboard-focusable: false;
    kind: root.data.kind;
    title: root.data.title;
    mark-before: root.data.mark-before;
    mark-text: root.data.mark-text;
    preview: root.data.preview;
    preview-before: root.data.preview-before;
    preview-match: root.data.preview-match;
    tag-hit: root.data.tag-hit;
    masked-preview: root.data.masked-preview;
    masked-hint: @tr("Hidden. Hold Space to reveal.");
    image: root.data.image;
    list-name: root.data.list-name;
    list-color: root.data.list-color;
    label: root.data.label;
    label-name: root.data.label-name;
    selected: root.data.selected;
}

// A group heading in the sidebar with an optional trailing action.
component SidebarHeading inherits Rectangle {
    in property <string> text;
    in property <image> action-icon;
    in property <string> action-label;
    callback action();
    height: max(Space.hit, Type.line-xs + Space.s2);
    // The heading names the group of rows below it for assistive technology.
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: Space.s2;
        padding-right: Space.s0-5;
        spacing: Space.s1;
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Fonts.sans;
            font-size: Type.xs;
            font-weight: Type.medium;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        if root.action-label != "": IconButton {
            scaled: true;
            size: IconButtonSize.sm;
            icon: root.action-icon;
            tooltip: root.action-label;
            own-tooltip: true;
            y: (parent.height - self.height) / 2;
            clicked => { root.action(); }
        }
    }
}

export component MainWindow inherits Window {
    title: @tr("Snipdeck");
    background: Theme.bg-app;
    min-width: 480px;
    min-height: 360px;
    preferred-width: root.wanted-width;
    preferred-height: root.wanted-height;

    // The size the window opens at; the host cuts it to the screen before the window exists.
    out property <length> wanted-width: 1100px;
    out property <length> wanted-height: 720px;

    // ---- State in -----------------------------------------------------------------------------
    in property <bool> dark: false;
    in property <string> board-name;
    in property <bool> board-menu-open: false;
    in property <[MenuEntry]> board-menu-entries;
    // The board menu's "Delete board…" confirmation (O52): the host sets `board-delete-open` after that row, and
    // nothing else opens (no board editor). `board-delete-count` is how many items go with the open board.
    in property <bool> board-delete-open: false;
    in property <int> board-delete-count;
    in property <[ChoiceEntry]> lists;
    in property <[ChoiceEntry]> tags;
    // Tags with a tick for those on the selected items (the host refreshes it on `item-action(tag, ...)`).
    in property <[ChoiceEntry]> tag-choices;
    in property <int> count-all: -1;
    in property <int> count-pinned: -1;
    in property <int> count-recent: -1;
    // Clipboard history is on: the Recent entries are listed in the Panel's clock tab, so this section points there.
    in property <bool> recent-on: false;
    // The library is locked behind a master password: Recent shows nothing (and collects nothing) until it is unlocked.
    in property <bool> recent-locked: false;
    // The longest the entries are kept, in days (the empty state names it).
    in property <int> recent-days: 7;
    // The Recent section's entries (newest first) and the lists "Save to…" offers. Empty in every other section.
    in property <[RecentRow]> recent-rows;
    in property <[ChoiceEntry]> recent-targets;
    in property <int> count-trash: -1;
    in property <[MainRow]> rows;
    // The colour labels the items in the view carry (the filter row), and the active filter (-1 none).
    in property <[LabelChipEntry]> label-chips;
    in property <int> label-filter: -1;
    in property <int> selected-count: 0;
    // True while the app loads: skeletons replace the empty state.
    in property <bool> loading: false;
    // The label of the card's use button and the menu's first entry ("Use"; "Copy" while nothing can be pasted into).
    in property <string> use-label: @tr("Use");
    // The use label copies (no paste target), so a card hides its separate Copy icon while the label shows.
    in property <bool> use-copies: false;
    // The sensitive row held revealed by the app (-1 = none).
    in property <int> revealed-index: -1;
    in property <int> trash-days: 30;
    in property <string> toast-text;
    in property <ToastKind> toast-kind: ToastKind.neutral;
    in property <ToastPhase> toast-phase: ToastPhase.hold;
    in property <string> toast-undo-label;
    in property <string> toast-edit-label;

    // ---- State both ways ----------------------------------------------------------------------
    // The host flips it to redraw the whole window (see `RepaintNudge`).
    in-out property <bool> repaint-flip: false;
    in-out property <MainSection> section: MainSection.all;
    // Which list or tag, when `section` is `list` or `tag`.
    in-out property <int> section-index: 0;
    in-out property <MainView> view: MainView.comfortable;
    in-out property <string> query <=> search.text;
    // The row the keyboard works on. The window moves it; the host resets it when the section changes.
    in-out property <int> cursor: 0;

    // ---- Gestures out -------------------------------------------------------------------------
    callback query-changed(string);
    // Search suggestions (slice 8): every edit asks the host for suggestions (`suggest-requested`: the text and the
    // caret as a byte offset); the host fills `suggestions`, takes the chosen row through `apply-suggestion` and
    // empties the list on Esc (`suggest-dismissed`).
    in property <[SuggestRow]> suggestions;
    // The search text `suggestions` were made for: rows for any other text are stale and hidden.
    in property <string> suggest-query;
    out property <bool> suggest-open: suggest.open;
    out property <int> suggest-current: suggest.current;
    callback suggest-requested(string, int);
    callback suggest-dismissed();
    callback suggest-chosen(int);
    callback section-selected(MainSection, int);
    callback view-changed(MainView);
    // The View menu's theme rows (0 System, 1 Light, 2 Dark): the host changes the setting and says so in a toast.
    in property <int> theme-index: 0;
    callback theme-chosen(index: int);
    // A label chip was chosen (0 to 7); -1 clears the filter. Choosing the active chip again also clears it.
    callback label-filter-requested(int);
    callback new-item-requested();
    // The quick-add box above an open list: Enter or [Create] (text, kind 0 Text / 1 Link / 2 Template, sensitive),
    // and "More options" (the full editor, prefilled with the text).
    callback quick-add-requested(string, int, bool);
    callback quick-add-full(string);
    // What a text looks like (0 Text, 1 Link, 2 Template), for the box's preselected kind.
    pure callback detect-kind(string) -> int;
    // Counts up to open the quick-add box and focus it (Ctrl+N in an open list).
    in-out property <int> quick-add-request: 0;
    // The box is open: it owns the typing keys (/, Ctrl+Z) like the search field does.
    property <bool> quick-open: false;
    // The box sits above the rows of an open list (not in a search, the Trash or a system view).
    property <bool> quick-add-shown: root.section == MainSection.list && !root.searching && !root.loading;
    // Ctrl+N: the quick-add box when a list is open, else the item editor.
    // The box owns the typing keys only while it is on screen.
    property <bool> quick-typing: root.quick-open && root.quick-add-shown;
    changed quick-add-shown => {
        if (!root.quick-add-shown && root.quick-open) {
            // The box's field had the focus and is gone with it: the items take it, so the window's keys keep working.
            root.quick-open = false;
            root.focus-items();
        }
    }
    function new-item() {
        if (root.quick-add-shown) {
            if (root.rows.length == 0) {
                // An empty list shows no collapsed row: open the box itself.
                root.quick-open = true;
            }
            root.quick-add-request += 1;
        } else {
            root.new-item-requested();
        }
    }
    // The empty deck's "Save from clipboard" and "Import…".
    callback add-from-clipboard();
    callback import-requested();
    callback select-requested(int, SelectMode);
    callback select-all-requested();
    callback clear-selection-requested();
    callback item-action(ItemAction, int);
    // The Recent section: copy an entry, remove it, save it to the n-th of `recent-targets` (all by entry id), or clear them all.
    callback recent-copied(int);
    callback recent-deleted(int);
    callback recent-saved(int, int);
    callback recent-cleared();
    callback recent-unlock-requested();
    callback move-chosen(int);
    // "Paste as…" picked choice `i` (in the order of the core `Transform::ALL`) for the row the chooser opened on.
    callback paste-as-chosen(int);
    callback tag-toggled(int, bool);
    callback reveal-requested(int, bool);
    callback settings-requested();
    // Ctrl+W: close the window like its X button does.
    callback close-requested();
    // "Show Panel": the toolbar button and the Help menu's last entry (the Panel may have been closed).
    callback panel-requested();
    // The configured Show/hide Panel hotkey ("Ctrl+Alt+Space"), empty while it is off; shown in the button's tooltip.
    in property <string> panel-hotkey;
    // The Panel is on screen: the toolbar button hides it (pressed, "Hide Panel") instead of showing it.
    in property <bool> panel-visible;
    // The open list's sort (0 Manual, 1 Most used, 2 Recently used); the heading's "Sort" menu changes it.
    in property <int> list-sort: 0;
    callback sort-chosen(int);
    // The sidebar's width in logical pixels at 100 % text size (200 to 320), and whether Ctrl+B or the toolbar
    // button folded it to the icon rail. The host remembers both; the window changes them as the user does.
    in-out property <int> sidebar-width: 232;
    in-out property <bool> sidebar-collapsed: false;
    callback sidebar-width-changed(int);
    callback sidebar-collapsed-changed(bool);
    // F1 asks for the guide, Ctrl+/ for the shortcuts, the Help menu for any of them.
    callback help-requested(HelpPage);
    // ---- Command palette: the host fills `palette-rows` (filtered for the query it is told about).
    in property <[PaletteRow]> palette-rows;
    in-out property <bool> palette-open: false;
    // The palette opened: the host sets the full list of commands.
    callback palette-opened();
    callback palette-query-changed(string);
    // The user ran the command with this id (`snipdeck-app`'s `Command` index).
    callback command-requested(int);
    callback add-list-requested();
    callback list-edit-requested(int);
    callback list-export-requested(int);
    callback list-delete-confirmed(int);
    callback manage-tags-requested();
    callback tag-delete-confirmed(int);
    callback empty-trash-confirmed();
    callback board-menu-requested();
    callback board-menu-activated(int);
    callback board-menu-dismissed();
    // The board delete confirmation: "Delete board", or Cancel / Esc / a click on the scrim.
    callback board-delete-confirmed();
    callback board-delete-dismissed();
    callback toast-undo();
    callback toast-edit();
    // Ctrl+V on the item list: make an item from the clipboard text.
    callback paste-create-requested();
    // Ctrl+C on the item list: copy the selected rows (the row under the cursor with none selected).
    callback copy-selection-requested(int);
    callback toast-hover-changed(hovered: bool);
    // Ctrl+Z / the Undo button: take back the latest step of the app-wide history.
    callback undo-requested();
    // Ctrl+Y, Ctrl+Shift+Z / the Redo button.
    callback redo-requested();
    // The history buttons: enabled while there is a step, named by what it would do ("Undo delete (Ctrl+Z)").
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <string> undo-tip: @tr("Undo last change");
    in property <string> redo-tip: @tr("Redo last change");
    // Pointer down on an empty part of the title bar: the host starts the OS window drag.
    callback drag-requested();
    callback title-double-clicked();
    // Alt+Up / Alt+Down in the item area: move the row at the cursor up (-1) or down (+1) within its list (a group
    // header moves its whole group).
    callback item-reorder-requested(int);
    // Groups, in a list in manual order. Ctrl+G groups the selected rows (else the row at the cursor); on a header,
    // Left folds, Right unfolds, Enter or a click does the other, F2 renames in place (`group-rename-requested`;
    // the host answers with `rename-row`), Delete deletes the group with its items.
    callback group-requested(int);
    callback group-toggled(int);
    callback group-collapsed-set(int, bool);
    callback group-renamed(int, string);
    callback group-rename-requested(int);
    callback group-rename-ended();
    callback group-ungroup-requested(int);
    callback group-delete-requested(int);
    // The header that should open its name for editing (the host counts requests in `rename-seq`).
    in property <int> rename-row: -1;
    in property <int> rename-seq: 0;
    // Some row is a group's header: a list with headers stays one column wide, so the tile view draws rows.
    in property <bool> has-groups: false;
    // The items the list holds, folded group members included (headers are not items); -1: count the rows.
    in property <int> list-total: -1;
    public pure function group-default-name() -> string { return @tr("Group"); }
    public pure function group-announcement(name: string, count: int) -> string {
        return @tr("group {}, {} item" | "group {}, {} items" % count, name, count);
    }
    // Alt+Up / Alt+Down in the sidebar on a list: its index in `lists`, then -1 or +1.
    callback list-reorder-requested(int, int);
    // Drag and drop (WCAG 2.5.7 gives the keyboard alternatives above and the item menu's Move to list). The payloads are
    // built and read by the host, and stay inside the window: a row's index, or a sidebar list's index in `lists`.
    pure callback row-payload(int) -> data-transfer;
    pure callback list-payload(int) -> data-transfer;
    pure callback payload-row(data-transfer) -> int;
    pure callback payload-list(data-transfer) -> int;
    // Row `from` was dropped on row `onto`.
    callback row-dropped(int, int);
    // Row `row` was dropped on sidebar list `list`.
    callback row-dropped-on-list(int, int);
    // Sidebar list `from` was dropped on sidebar list `onto`.
    callback list-dropped(int, int);
    // Rows can be dragged into a new place: the open list is in manual order and no search is running.
    in property <bool> rows-reorderable: false;
    // The open list sorts itself (no search): a drop still reaches the host, which offers manual order.
    in property <bool> reorder-offer: false;

    // ---- Public -------------------------------------------------------------------------------
    // Holds row `index` in its pulled (used) state for the card's 700ms.
    public function mark-used(index: int) {
        root.used-index = index;
        used-timer.running = true;
    }
    public function focus-search() {
        search.focus();
        search.select-all();
    }
    public function open-palette() {
        // Like Ctrl+K: nothing opens over a menu, a dialog or the palette itself (asking the host to
        // refill the rows of an open palette would leave the field's text and the rows apart).
        if (root.overlay-open) {
            return;
        }
        root.palette-open = true;
        root.palette-opened();
    }
    // The window is closing: nothing stays open in it (menus, chooser, palette, dialog) for the next time it shows.
    public function dismiss-overlays() {
        root.palette-open = false;
        root.confirm-shown = false;
        root.close-menus();
    }
    public function focus-items() {
        items-scope.focus();
    }
    out property <bool> items-focused: items-scope.has-focus;
    out property <bool> sidebar-focused: nav-scope.has-focus;
    out property <bool> search-focused: search.has-focus;
    out property <bool> rail: root.narrow;
    out property <int> columns: root.cols;
    out property <bool> confirm-open: root.confirm-shown;
    out property <bool> menu-open: item-menu-open || nav-menu-open || chooser-open || help-menu-open || view-menu-open || sort-menu-open || recent-menu-open || recent-save-open;

    // ---- Internals ----------------------------------------------------------------------------
    property <int> used-index: -1;
    property <bool> narrow: false;
    property <float> text-scale: SystemLook.text-scale;
    // One height for every toolbar control (the standard Button height).
    // Below 560px (at 100% text size) of item area the Commands and View buttons are icon-only (spec 3 Toolbar).
    property <bool> toolbar-compact: false;
    property <length> ctl-h: max(Space.s8 * SystemLook.text-scale, Type.line-base + Space.s2);
    property <length> bar-h: max(Space.s8 + Space.s3, Type.line-base + Space.s2 + Space.s3);
    // Below 720px the sidebar is a rail whatever was chosen; the chosen width and the collapsed flag apply above it.
    property <bool> auto-rail: false;
    property <length> sidebar-w: root.narrow ? Space.s12 * root.text-scale : root.sidebar-width * 1px + (root.text-scale - 1) * 96px;
    property <length> splitter-w: 8px;
    property <length> splitter-grab: 0px;
    property <bool> splitter-focused: false;
    property <length> pad: Space.s4;
    // The keyboard focus ring is drawn this far outside a card; the lists are inset by it so a scroll viewport never clips it.
    property <length> ring: Space.s1;
    property <int> n-lists: root.lists.length;
    property <int> n-tags: root.tags.length;
    property <int> nav-total: 4 + root.n-lists + root.n-tags;
    property <int> cur: root.rows.length == 0 ? -1 : min(max(root.cursor, 0), root.rows.length - 1);
    property <bool> tile: root.view == MainView.tile && !root.has-groups;
    property <bool> in-trash: root.section == MainSection.trash;
    property <bool> searching: root.query != "";
    property <bool> multi: root.selected-count > 1;
    property <int> nav-cursor: 0;
    property <bool> item-menu-open: false;
    property <length> item-menu-x: 0px;
    property <length> item-menu-y: 0px;
    property <int> item-menu-index: 0;
    property <bool> nav-menu-open: false;
    property <bool> help-menu-open: false;
    property <bool> view-menu-open: false;
    property <bool> sort-menu-open: false;
    // An empty image: a menu row without a check mark keeps its icon column.
    property <image> no-icon;
    property <length> nav-menu-x: 0px;
    property <length> nav-menu-y: 0px;
    property <int> nav-menu-flat: 0;
    property <bool> chooser-open: false;
    // The Recent entry menu and its "Save to…" chooser: the row they act on, and where they open.
    property <bool> recent-menu-open: false;
    property <bool> recent-save-open: false;
    property <int> recent-menu-row: 0;
    // The entry the open menu acts on, by id: the list can shift (a new copy, a search edit) while it is open.
    property <int> recent-menu-id: 0;
    property <length> recent-menu-x: 0px;
    property <length> recent-menu-y: 0px;
    // The Recent section lists entries (instead of the empty state).
    property <bool> recent-shown: root.section == MainSection.recent && root.recent-on && root.recent-rows.length > 0;
    // Roving focus in the Recent list: one tab stop (`items-scope`), the active row clamped to the list.
    property <int> recent-cursor: 0;
    property <int> rcur: root.recent-rows.length == 0 ? -1 : min(max(root.recent-cursor, 0), root.recent-rows.length - 1);
    function move-recent(to: int) {
        root.recent-cursor = min(max(to, 0), root.recent-rows.length - 1);
    }
    property <bool> chooser-tags: false;
    // The chooser holds the "Paste as…" choices.
    property <bool> chooser-paste: false;
    property <length> chooser-x: 0px;
    property <length> chooser-y: 0px;
    // What the confirmation dialog is asking: 0 none, 1 delete a list, 2 delete a tag, 3 empty the Trash,
    // 4 delete the selected items for good.
    property <int> confirm-kind: 0;
    property <int> confirm-target: 0;
    property <bool> confirm-shown: false;
    property <bool> overlay-open: root.recent-menu-open || root.recent-save-open || root.item-menu-open || root.nav-menu-open || root.help-menu-open || root.view-menu-open || root.sort-menu-open || root.chooser-open || root.board-menu-open || root.confirm-shown || root.board-delete-open || root.palette-open;

    init => {
        Palette.dark = root.dark;
        root.update-narrow();
    }
    changed dark => {
        Palette.dark = root.dark;
    }
    // Set from `changed` handlers, not bound to `root.width`: a window's width follows its layout.
    function update-narrow() {
        root.auto-rail = root.width < 720px;
        root.narrow = root.auto-rail || root.sidebar-collapsed;
        root.toolbar-compact = root.width - root.sidebar-w < 560px * root.text-scale;
    }
    changed width => {
        root.update-narrow();
    }
    changed text-scale => {
        root.update-narrow();
    }
    changed sidebar-collapsed => {
        root.update-narrow();
    }
    changed sidebar-width => {
        root.update-narrow();
    }
    // Ctrl+B and the toolbar button. Below 720px the rail is automatic and wins, so there is nothing to fold.
    function toggle-sidebar() {
        if (root.auto-rail) {
            return;
        }
        // The splitter goes away on the rail: the keys go to the list, not nowhere.
        if (root.splitter-focused) {
            items-scope.focus();
        }
        root.sidebar-collapsed = !root.sidebar-collapsed;
        root.sidebar-collapsed-changed(root.sidebar-collapsed);
    }
    // The sidebar's new width in logical pixels at 100 % text size, clamped; `commit` also tells the host.
    function set-sidebar-width(px: int, commit: bool) {
        root.sidebar-width = max(200, min(320, px));
        if (commit) {
            root.sidebar-width-changed(root.sidebar-width);
        }
    }

    used-timer := Timer {
        interval: 700ms;
        running: false;
        triggered => {
            self.running = false;
            root.used-index = -1;
        }
    }

    // ---- Navigation model: system views, then lists, then tags -------------------------------------
    pure function nav-section(flat: int) -> MainSection {
        return flat == 0 ? MainSection.all : flat == 1 ? MainSection.pinned : flat == 2 ? MainSection.recent
            : flat == 3 ? MainSection.trash : flat < 4 + root.n-lists ? MainSection.list : MainSection.tag;
    }
    pure function nav-index(flat: int) -> int {
        return flat < 4 ? 0 : flat < 4 + root.n-lists ? flat - 4 : flat - 4 - root.n-lists;
    }
    pure function flat-of(s: MainSection, index: int) -> int {
        return s == MainSection.all ? 0 : s == MainSection.pinned ? 1 : s == MainSection.recent ? 2
            : s == MainSection.trash ? 3 : s == MainSection.list ? 4 + index : 4 + root.n-lists + index;
    }
    property <int> nav-selected: root.flat-of(root.section, root.section-index);

    function open-section(flat: int) {
        root.nav-cursor = flat;
        root.section = root.nav-section(flat);
        root.section-index = root.nav-index(flat);
        root.cursor = 0;
        if (root.query != "") {
            root.query = "";
            root.query-changed("");
        }
        root.section-selected(root.section, root.section-index);
    }

    // Where the keys go back to when a menu, chooser or confirmation closes: the sidebar when it was opened there.
    property <bool> nav-origin: false;
    function restore-focus() {
        if (root.nav-origin) {
            nav-scope.focus();
        } else {
            items-scope.focus();
        }
    }

    function open-nav-menu(flat: int, x: length, y: length) {
        root.nav-origin = true;
        root.nav-menu-flat = flat;
        root.nav-menu-x = x;
        root.nav-menu-y = y;
        root.nav-menu-open = true;
    }

    property <[MenuEntry]> nav-entries: root.nav-section(root.nav-menu-flat) == MainSection.list ? [
        { text: @tr("Edit list…"), icon: Icons.pencil-simple },
        { text: @tr("Export as text"), icon: Icons.copy },
        { text: @tr("Delete list…"), icon: Icons.trash, destructive: true },
    ] : root.nav-section(root.nav-menu-flat) == MainSection.tag ? [
        { text: @tr("Manage tags…"), icon: Icons.tag },
        { text: @tr("Delete tag…"), icon: Icons.trash, destructive: true },
    ] : [
        { text: @tr("Empty Trash…"), icon: Icons.trash, destructive: true },
    ];

    function nav-menu-activated(i: int) {
        let s = root.nav-section(root.nav-menu-flat);
        let index = root.nav-index(root.nav-menu-flat);
        root.nav-menu-open = false;
        root.restore-focus();
        if (s == MainSection.list) {
            if (i == 0) {
                root.list-edit-requested(index);
            } else if (i == 1) {
                root.list-export-requested(index);
            } else {
                root.ask(1, index);
            }
        } else if (s == MainSection.tag) {
            if (i == 0) {
                root.manage-tags-requested();
            } else {
                root.ask(2, index);
            }
        } else {
            root.ask(3, 0);
        }
    }

    // ---- Confirmation ---------------------------------------------------------------------------
    function ask(kind: int, target: int) {
        root.confirm-kind = kind;
        root.confirm-target = target;
        root.confirm-shown = true;
    }
    property <string> confirm-title: root.confirm-kind == 1 ? @tr("Delete list “{}”?", root.lists[root.confirm-target].label)
        : root.confirm-kind == 2 ? @tr("Delete tag “{}”?", root.tags[root.confirm-target].label)
        : root.confirm-kind == 3 ? @tr("Empty the Trash?")
        : root.confirm-kind == 5 ? @tr("Clear recent history?")
        : @tr("Delete for good?");
    property <string> confirm-body: root.confirm-kind == 1
        ? @tr("The list and its {} items move to the Trash. You can restore them for {} days.", root.lists[root.confirm-target].count, root.trash-days)
        : root.confirm-kind == 2 ? @tr("The tag is removed from its items. The items themselves stay.")
        : root.confirm-kind == 3 ? @tr("Everything in the Trash is deleted for good. This can't be undone.")
        : root.confirm-kind == 5 ? @tr("All {} recent copies are removed. This can't be undone.", root.count-recent)
        : @tr("The selected items are deleted for good. This can't be undone.");
    property <string> confirm-ok: root.confirm-kind == 1 ? @tr("Delete list")
        : root.confirm-kind == 2 ? @tr("Delete tag")
        : root.confirm-kind == 3 ? @tr("Empty Trash")
        : root.confirm-kind == 5 ? @tr("Clear history") : @tr("Delete for good");
    function confirmed() {
        let kind = root.confirm-kind;
        let target = root.confirm-target;
        root.confirm-shown = false;
        if (kind == 1) {
            root.list-delete-confirmed(target);
        } else if (kind == 2) {
            root.tag-delete-confirmed(target);
        } else if (kind == 3) {
            root.empty-trash-confirmed();
        } else if (kind == 4) {
            root.item-action(ItemAction.delete-forever, target);
        } else if (kind == 5) {
            root.recent-cleared();
        }
    }

    // ---- Item actions ---------------------------------------------------------------------------
    // The pointer or the keyboard picked row `i`.
    // The keyboard ring on the cursor row shows only while the keyboard drives the list: a click that takes the focus
    // (`mouse-focus`) draws none, and the next key or Tab brings it back.
    property <bool> kbd-focus: false;
    property <bool> mouse-focus: false;
    function pick(i: int, shift: bool, control: bool) {
        root.cursor = i;
        root.mouse-focus = true;
        root.kbd-focus = false;
        items-scope.focus();
        root.select-requested(i, shift ? SelectMode.extend : control ? SelectMode.toggle : SelectMode.replace);
    }

    function move-cursor(delta: int, extend: bool) {
        if (root.rows.length > 0) {
            let next = min(max(root.cur + delta, 0), root.rows.length - 1);
            root.cursor = next;
            root.select-requested(next, extend ? SelectMode.extend : SelectMode.replace);
        }
    }

    // Runs an action on the selection (or on `index` when it is the only one).
    function act(action: ItemAction, index: int) {
        if (action == ItemAction.use || action == ItemAction.copy) {
            root.mark-used(index);
        }
        if (action == ItemAction.delete-forever) {
            root.ask(4, index);
        } else {
            root.item-action(action, index);
            if (action == ItemAction.move || action == ItemAction.tag || action == ItemAction.paste-as) {
                root.open-chooser(action == ItemAction.tag, action == ItemAction.paste-as, index);
            }
        }
    }

    function open-chooser(tags: bool, paste: bool, index: int) {
        root.chooser-tags = tags;
        root.chooser-paste = paste;
        root.chooser-x = min(max(root.item-menu-x, root.sidebar-w), max(root.sidebar-w, root.width - 240px));
        root.chooser-y = min(root.item-menu-y, max(0px, root.height - 300px));
        root.chooser-open = true;
    }

    function open-item-menu(index: int, x: length, y: length) {
        root.nav-origin = false;
        root.item-menu-index = index;
        root.item-menu-x = x;
        root.item-menu-y = y;
        root.item-menu-open = true;
    }

    function open-help-menu() {
        root.close-menus();
        root.nav-origin = true;
        root.help-menu-open = true;
    }

    function open-view-menu() {
        root.close-menus();
        root.nav-origin = false;
        root.view-menu-open = true;
    }

    property <length> sort-menu-x: 0px;
    property <length> sort-menu-y: 0px;
    function open-sort-menu(x: length, y: length) {
        root.close-menus();
        root.nav-origin = false;
        root.sort-menu-x = x;
        root.sort-menu-y = y;
        root.sort-menu-open = true;
    }

    function open-recent-menu(row: int, x: length, y: length) {
        root.nav-origin = false;
        root.recent-menu-row = row;
        root.recent-menu-id = root.recent-rows[row].id;
        root.recent-menu-x = x;
        root.recent-menu-y = y;
        root.recent-save-open = false;
        root.recent-menu-open = true;
    }

    function open-recent-save(row: int, x: length, y: length) {
        root.nav-origin = false;
        root.recent-menu-row = row;
        root.recent-menu-id = root.recent-rows[row].id;
        root.recent-menu-x = x;
        root.recent-menu-y = y;
        root.recent-menu-open = false;
        root.recent-save-open = true;
    }

    function close-menus() {
        root.recent-menu-open = false;
        root.recent-save-open = false;
        root.item-menu-open = false;
        root.nav-menu-open = false;
        root.help-menu-open = false;
        root.view-menu-open = false;
        root.sort-menu-open = false;
        root.chooser-open = false;
        root.restore-focus();
    }

    property <[MenuEntry]> group-entries: [
        { text: MenuTexts.group-rename(), icon: Icons.pencil-simple, shortcut: "F2" },
        { text: MenuTexts.group-ungroup(), icon: Icons.files },
        { separator: true },
        { text: MenuTexts.group-delete(), icon: Icons.trash, destructive: true, shortcut: "Del" },
    ];

    property <[MenuEntry]> item-entries: root.in-trash ? [
        { text: @tr("Restore"), icon: Icons.arrow-counter-clockwise },
        { separator: true },
        { text: @tr("Delete for good…"), icon: Icons.trash, destructive: true, shortcut: "Del" },
    ] : [
        { text: root.use-label, icon: Icons.arrow-bend-down-left, shortcut: "Enter", disabled: root.multi },
        { text: @tr("Copy"), icon: Icons.copy, shortcut: "Shift+Enter", disabled: root.multi },
        { text: MenuTexts.item-paste-as(), icon: Icons.text-t, disabled: root.multi || root.rows[root.item-menu-index].kind == ItemKind.image || root.rows[root.item-menu-index].kind == ItemKind.file },
        { separator: true },
        { text: @tr("Edit"), icon: Icons.pencil-simple, shortcut: "Ctrl+E", disabled: root.multi },
        { text: @tr("Duplicate"), icon: Icons.files, shortcut: "Ctrl+D" },
        { text: root.rows[root.item-menu-index].pinned && !root.multi ? @tr("Unpin") : @tr("Pin"), icon: Icons.push-pin, shortcut: "Ctrl+P" },
        { text: @tr("Move up"), icon: Icons.caret-up, shortcut: "Alt+Up", disabled: root.multi || !root.rows-reorderable || root.item-menu-index <= 0 },
        { text: @tr("Move down"), icon: Icons.caret-down, shortcut: "Alt+Down", disabled: root.multi || !root.rows-reorderable || root.item-menu-index >= root.rows.length - 1 },
        { text: @tr("Move to list…"), icon: Icons.folder },
        { text: @tr("Tags…"), icon: Icons.tag },
        { separator: true },
        { text: @tr("Move to Trash"), icon: Icons.trash, destructive: true, shortcut: "Del" },
    ];

    property <[ChoiceEntry]> paste-choices: [
        { label: MenuTexts.paste-as-plain(), count: -1 },
        { label: MenuTexts.paste-as-upper(), count: -1 },
        { label: MenuTexts.paste-as-lower(), count: -1 },
        { label: MenuTexts.paste-as-title(), count: -1 },
        { label: MenuTexts.paste-as-trimmed(), count: -1 },
        { label: MenuTexts.paste-as-slug(), count: -1 },
    ];

    function item-menu-activated(i: int) {
        let index = root.item-menu-index;
        root.item-menu-open = false;
        if (root.rows[index].is-header) {
            if (i == 0) {
                root.group-rename-requested(index);
            } else if (i == 1) {
                root.group-ungroup-requested(index);
            } else if (i == 3) {
                root.group-delete-requested(index);
            }
            if (i != 0) {
                items-scope.focus();
            }
            return;
        }
        if (root.in-trash) {
            root.act(i == 0 ? ItemAction.restore : ItemAction.delete-forever, index);
        } else if (i == 0) {
            root.act(ItemAction.use, index);
        } else if (i == 1) {
            root.act(ItemAction.copy, index);
        } else if (i == 2) {
            root.act(ItemAction.paste-as, index);
        } else if (i == 4) {
            root.act(ItemAction.edit, index);
        } else if (i == 5) {
            root.act(ItemAction.duplicate, index);
        } else if (i == 6) {
            root.act(ItemAction.pin, index);
        } else if (i == 7 || i == 8) {
            root.cursor = index;
            root.item-reorder-requested(i == 7 ? -1 : 1);
        } else if (i == 9) {
            root.act(ItemAction.move, index);
        } else if (i == 10) {
            root.act(ItemAction.tag, index);
        } else if (i == 12) {
            root.act(ItemAction.delete, index);
        }
        if (!root.chooser-open && !root.confirm-shown) {
            items-scope.focus();
        }
    }

    // ---- Scrolling the item area to the cursor ---------------------------------------------------
    property <length> edge-h: 10px;
    property <length> row-gap: root.view == MainView.comfortable ? Space.s1 : 0px;
    // The quiet rows sit 8px in from the item area's edge (the tiles, until they follow, keep `pad`).
    property <length> list-pad: Space.s2;
    property <length> avg-row-h: root.rows.length == 0 ? Space.hit : max(Space.hit, list.content-height / root.rows.length);
    property <int> page-rows: max(1, floor(list.height / root.avg-row-h) - 1);
    property <int> last-cur: 0;

    function reveal-list(y: length, h: length) {
        let top = root.cur == 0 ? 0px : root.edge-h;
        let bottom = root.cur == root.rows.length - 1 ? 0px : root.edge-h;
        if (root.cur == 0) {
            list.content-y = 0px;
        } else if (y + list.content-y < top) {
            list.content-y = top - y;
        } else if (y + h + list.content-y > list.height - bottom) {
            list.content-y = list.height - bottom - y - h;
        }
    }
    function reveal-grid(y: length, h: length) {
        let top = root.cur < root.cols ? 0px : root.edge-h;
        let bottom = root.cur >= root.rows.length - root.cols ? 0px : root.edge-h;
        if (root.cur < root.cols) {
            grid.content-y = 0px;
        } else if (y + grid.content-y < top) {
            grid.content-y = top - y;
        } else if (y + h + grid.content-y > grid.height - bottom) {
            grid.content-y = grid.height - bottom - y - h;
        }
    }
    // A jump of more than a page lands on a row the ListView has not instantiated yet: estimate its position
    // from the average row height; once the row exists, `reveal-*` places it exactly.
    changed cur => {
        let jump = abs(root.cur - root.last-cur) > root.page-rows;
        root.last-cur = root.cur;
        if (!root.tile && root.cur == 0) {
            list.content-y = 0px;
        } else if (!root.tile && root.cur > 0 && jump) {
            let centred = root.cur * root.avg-row-h - (list.height - root.avg-row-h) / 2;
            list.content-y = min(0px, max(list.height - list.content-height, -centred));
        }
    }

    // ---- Tile grid geometry -----------------------------------------------------------------------
    // Cards 6 apart; a card is at least 200 wide so the type tile sits inline with the title (spec 3, decision 7).
    property <length> tile-gap: 6px;
    property <length> tile-min-w: 200px * root.text-scale;
    property <int> cols: max(1, min(6, floor((grid.width - 2 * root.ring + root.tile-gap) / (root.tile-min-w + root.tile-gap))));
    // Only the visible one of the two lists builds rows.
    property <[MainRow]> list-model: root.tile ? [] : root.rows;
    property <int> grid-row-count: root.tile ? ceil(root.rows.length / root.cols) : 0;
    pure function tile-index(r: int, c: int) -> int {
        return r * root.cols + c;
    }
    property <length> tile-w: (grid.width - 2 * root.ring - (root.cols - 1) * root.tile-gap) / root.cols;
    // ---- Keyboard ---------------------------------------------------------------------------------
    pure function section-name() -> string {
        return root.searching ? @tr("Search results")
            : root.section == MainSection.all ? @tr("All items")
            : root.section == MainSection.pinned ? @tr("Pinned")
            : root.section == MainSection.recent ? @tr("Recent")
            : root.section == MainSection.trash ? @tr("Trash")
            : root.section == MainSection.list ? root.lists[root.section-index].label
            : root.tags[root.section-index].label;
    }

    pure function sort-name(sort: int) -> string {
        return sort == 1 ? @tr("Most used") : sort == 2 ? @tr("Recently used") : @tr("Manual");
    }

    // A suggestion was chosen: the word at the caret is replaced (the host computed the text and the new caret).
    public function apply-suggestion(text: string, caret: int) {
        root.query = text;
        search.set-cursor(caret);
        root.cursor = 0;
        root.query-changed(text);
    }

    root-scope := FocusScope {
        capture-key-pressed(event) => {
            if (root.overlay-open || search.composing) {
                return reject;
            }
            if (search.has-focus && suggest.handle-key(event)) {
                return accept;
            }
            if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                if ((event.text == "b" || event.text == "B") && !event.modifiers.shift) {
                    root.toggle-sidebar();
                    return accept;
                }
                if (event.text == "k" || event.text == "K" || (event.modifiers.shift && (event.text == "p" || event.text == "P"))) {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "/") {
                    root.help-requested(HelpPage.shortcuts);
                    return accept;
                }
                if (event.text == ",") {
                    root.settings-requested();
                    return accept;
                }
                if (event.text == "f" || event.text == "F") {
                    root.focus-search();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    if (event.modifiers.shift) {
                        root.add-list-requested();
                    } else {
                        root.new-item();
                    }
                    return accept;
                }
                if ((event.text == "w" || event.text == "W") && !event.modifiers.shift) {
                    root.close-requested();
                    return accept;
                }
                // A focused search field undoes its own typing.
                if ((event.text == "z" || event.text == "Z") && !event.modifiers.shift && !search.has-focus && !root.quick-typing) {
                    root.undo-requested();
                    return accept;
                }
                if ((((event.text == "z" || event.text == "Z") && event.modifiers.shift) || event.text == "y" || event.text == "Y") && !search.has-focus && !root.quick-typing) {
                    root.redo-requested();
                    return accept;
                }
            }
            if (event.text == Key.F1) {
                root.help-requested(HelpPage.guide);
                return accept;
            }
            if (event.text == "/" && !search.has-focus && !root.quick-typing && !event.modifiers.control && !event.modifiers.alt) {
                root.focus-search();
                return accept;
            }
            return reject;
        }

        RepaintNudge { flip: root.repaint-flip; }

        HorizontalLayout {
            // ======== Sidebar ====================================================================
            sidebar := Rectangle {
                width: root.sidebar-w;
                background: Theme.bg-app;
                accessible-role: AccessibleRole.list;
                accessible-label: @tr("Navigation");

                VerticalLayout {
                    // Board switcher, level with the toolbar.
                    Rectangle {
                        height: root.bar-h;
                        HorizontalLayout {
                            padding-left: root.narrow ? 0px : Space.s2;
                            padding-right: root.narrow ? 0px : Space.s2;
                            alignment: root.narrow ? center : start;
                            if !root.narrow: switcher := BoardSwitcher {
                                horizontal-stretch: 0;
                                board-name: root.board-name;
                                menu-open: root.board-menu-open;
                                a11y-label: @tr("Board: {}", root.board-name);
                                y: (parent.height - self.height) / 2;
                                menu-requested => { root.board-menu-requested(); }
                            }
                            if root.narrow: IconButton {
                                scaled: true;
                                icon: Icons.stack;
                                tooltip: @tr("Board: {}", root.board-name);
                                own-tooltip: true;
                                active: root.board-menu-open;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.board-menu-requested(); }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        nav-flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            interactive: false;
                            // As tall as the child: a viewport shorter than its child would centre the child in it.
                            content-height: max(self.height, nav-content.preferred-height);

                            nav-scope := FocusScope {
                                width: nav-flick.width;
                                height: max(nav-flick.height, nav-content.preferred-height);
                                focus-gained(reason) => {
                                    // Tab lands on the open view; a focus given back after a menu keeps the cursor.
                                    if (reason == FocusReason.tab-navigation) {
                                        root.nav-cursor = root.nav-selected;
                                    }
                                }
                                key-pressed(event) => {
                                    if (event.modifiers.alt && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                                        if (root.nav-cursor >= 4 && root.nav-cursor < 4 + root.n-lists) {
                                            let delta = event.text == Key.UpArrow ? -1 : 1;
                                            root.list-reorder-requested(root.nav-cursor - 4, delta);
                                            root.nav-cursor = min(max(root.nav-cursor + delta, 4), 3 + root.n-lists);
                                        }
                                        return accept;
                                    }
                                    if (event.text == Key.DownArrow) {
                                        root.nav-cursor = min(root.nav-cursor + 1, root.nav-total - 1);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        root.nav-cursor = max(root.nav-cursor - 1, 0);
                                        return accept;
                                    }
                                    if (event.text == Key.Home) {
                                        root.nav-cursor = 0;
                                        return accept;
                                    }
                                    if (event.text == Key.End) {
                                        root.nav-cursor = root.nav-total - 1;
                                        return accept;
                                    }
                                    if (event.text == Key.Return || event.text == " ") {
                                        root.open-section(root.nav-cursor);
                                        return accept;
                                    }
                                    if (event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10)) {
                                        if (root.nav-cursor >= 3) {
                                            root.open-nav-menu(root.nav-cursor, root.sidebar-w, root.bar-h + Space.s8);
                                        }
                                        return accept;
                                    }
                                    return reject;
                                }

                                nav-content := VerticalLayout {
                                    padding: Space.s2;
                                    padding-top: Space.s1;
                                    spacing: Space.s0-5;
                                    alignment: start;

                                    SidebarItem {
                                        kind: SidebarItemKind.system;
                                        icon: Icons.stack;
                                        label: @tr("All items");
                                        count: root.count-all;
                                        rail: root.narrow;
                                        selected: root.nav-selected == 0;
                                        keyboard-focusable: false;
                                        show-focus: nav-scope.has-focus && root.nav-cursor == 0;
                                        clicked => { root.open-section(0); }
                                    }
                                    SidebarItem {
                                        kind: SidebarItemKind.system;
                                        icon: Icons.push-pin;
                                        label: @tr("Pinned");
                                        count: root.count-pinned;
                                        rail: root.narrow;
                                        selected: root.nav-selected == 1;
                                        keyboard-focusable: false;
                                        show-focus: nav-scope.has-focus && root.nav-cursor == 1;
                                        clicked => { root.open-section(1); }
                                    }
                                    SidebarItem {
                                        kind: SidebarItemKind.system;
                                        icon: Icons.clock;
                                        label: @tr("Recent");
                                        count: root.count-recent;
                                        rail: root.narrow;
                                        selected: root.nav-selected == 2;
                                        keyboard-focusable: false;
                                        show-focus: nav-scope.has-focus && root.nav-cursor == 2;
                                        clicked => { root.open-section(2); }
                                    }
                                    SidebarItem {
                                        kind: SidebarItemKind.system;
                                        icon: Icons.trash;
                                        label: @tr("Trash");
                                        count: root.count-trash;
                                        rail: root.narrow;
                                        selected: root.nav-selected == 3;
                                        keyboard-focusable: false;
                                        show-focus: nav-scope.has-focus && root.nav-cursor == 3;
                                        clicked => { root.open-section(3); }
                                        context-menu-requested(x, y) => { root.open-nav-menu(3, root.sidebar-w, self.absolute-position.y + y); }
                                    }

                                    if !root.narrow: SidebarHeading {
                                        text: @tr("Lists");
                                        action-icon: Icons.plus;
                                        action-label: @tr("Add list");
                                        action => { root.add-list-requested(); }
                                    }
                                    if root.narrow: Rectangle {
                                        height: Space.s2;
                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            height: 1px;
                                            background: Theme.border-subtle;
                                        }
                                    }
                                    for entry[i] in root.lists: Rectangle {
                                    // The sidebar list being dragged over this one (-1 for a dragged row): the drop line
                                    // lands below this entry when coming from above, above it otherwise.
                                    property <int> list-from: -1;
                                        height: side-list.height;
                                        side-drop := DropArea {
                                            can-drop(event) => {
                                            list-from = root.payload-list(event.data);
                                                (root.payload-row(event.data) >= 0 && !root.in-trash) || (root.payload-list(event.data) >= 0 && root.payload-list(event.data) != i) ? DragAction.move : DragAction.none
                                            }
                                            dropped(event) => {
                                                if (root.payload-row(event.data) >= 0) {
                                                    root.row-dropped-on-list(root.payload-row(event.data), i);
                                                } else {
                                                    root.list-dropped(root.payload-list(event.data), i);
                                                }
                                                return DragAction.move;
                                            }

                                            DragArea {
                                                allow-move: true;
                                                data: root.list-payload(i);

                                                side-list := SidebarItem {
                                                    kind: SidebarItemKind.list;
                                                    label: entry.label;
                                                    count: entry.count;
                                                    mark-color: entry.color;
                                                    icon: entry.icon;
                                                    rail: root.narrow;
                                                    selected: root.nav-selected == 4 + i;
                                                drop-target: side-drop.has-drag && list-from < 0;
                                                    keyboard-focusable: false;
                                                    show-focus: nav-scope.has-focus && root.nav-cursor == 4 + i;
                                                    clicked => { root.open-section(4 + i); }
                                                    context-menu-requested(x, y) => { root.open-nav-menu(4 + i, root.sidebar-w, self.absolute-position.y + y); }
                                                }
                                            }
                                        }
                                    // The drop target of a list reorder: a 2px accent line where the dragged list would land.
                                    if side-drop.has-drag && list-from >= 0: list-drop-line := Rectangle {
                                        y: list-from < i ? parent.height - 2px : 0px;
                                        width: parent.width;
                                        height: 2px;
                                        background: Theme.accent;
                                    }
                                    }

                                    if !root.narrow: SidebarHeading {
                                        text: @tr("Tags");
                                        action-icon: Icons.gear;
                                        action-label: @tr("Manage tags");
                                        action => { root.manage-tags-requested(); }
                                    }
                                    if root.narrow && root.n-tags > 0: Rectangle {
                                        height: Space.s2;
                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            height: 1px;
                                            background: Theme.border-subtle;
                                        }
                                    }
                                    for entry[i] in root.tags: SidebarItem {
                                        kind: SidebarItemKind.tag;
                                        label: entry.label;
                                        count: entry.count;
                                        rail: root.narrow;
                                        selected: root.nav-selected == 4 + root.n-lists + i;
                                        keyboard-focusable: false;
                                        show-focus: nav-scope.has-focus && root.nav-cursor == 4 + root.n-lists + i;
                                        clicked => { root.open-section(4 + root.n-lists + i); }
                                        context-menu-requested(x, y) => { root.open-nav-menu(4 + root.n-lists + i, root.sidebar-w, self.absolute-position.y + y); }
                                    }
                                }
                            }
                        }

                        OverlayScrollbar {
                            content-y: nav-flick.content-y;
                            content-height: nav-flick.content-height;
                            visible-height: nav-flick.height;
                            scroll-to(y) => { nav-flick.content-y = y; }
                        }
                    }

                    // Settings, pinned to the foot of the sidebar.
                    Rectangle {
                        height: root.bar-h;
                        HorizontalLayout {
                            padding: Space.s2;
                            alignment: root.narrow ? center : start;
                            if !root.narrow: Button {
                                variant: ButtonVariant.ghost;
                                icon: Icons.gear;
                                text: @tr("Settings");
                                y: (parent.height - self.height) / 2;
                                clicked => { root.settings-requested(); }
                            }
                            if !root.narrow: Button {
                                variant: ButtonVariant.ghost;
                                icon: Icons.question;
                                text: @tr("Help");
                                y: (parent.height - self.height) / 2;
                                clicked => { root.open-help-menu(); }
                            }
                            if root.narrow: IconButton {
                                scaled: true;
                                icon: Icons.gear;
                                tooltip: @tr("Settings");
                                own-tooltip: true;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.settings-requested(); }
                            }
                            if root.narrow: IconButton {
                                scaled: true;
                                icon: Icons.question;
                                tooltip: @tr("Help");
                                own-tooltip: true;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.open-help-menu(); }
                            }
                        }
                    }
                }

                // The rule between the sidebar and the items.
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border-subtle;
                }

            }

            // ======== Content ====================================================================
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;

                // ---- Toolbar, which is also the title bar ------------------------------------
                Rectangle {
                    height: root.bar-h;

                    // Behind the controls: pressing anywhere else drags the window; a double click maximises.
                    TouchArea {
                        mouse-cursor: MouseCursor.default;
                        double-clicked => { root.title-double-clicked(); }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.drag-requested();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: SystemLook.caption-inset + Space.s2;
                        spacing: Space.s2;
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            // The same width whatever is typed: the field's own preferred width follows its text.
                            preferred-width: 360px * SystemLook.text-scale;
                            max-width: 360px * SystemLook.text-scale;
                            VerticalLayout {
                                alignment: center;
                                search := SearchField {
                                    expanded: suggest.open;
                                    placeholder: @tr("Search snippets");
                                    label: @tr("Search snippets");
                                    clear-label: @tr("Clear search");
                                    edited(text) => {
                                        root.cursor = 0;
                                        root.query-changed(text);
                                        root.suggest-requested(text, search.caret);
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            padding-right: Space.s1;
                            HorizontalLayout {
                                spacing: 0px;
                                panel-show := IconButton {
                                    scaled: true;
                                    side-override: root.ctl-h;
                                    icon: Icons.picture-in-picture;
                                    tooltip: root.panel-visible
                                        ? (root.panel-hotkey == "" ? @tr("Hide Panel") : @tr("Hide Panel ({})", root.panel-hotkey))
                                        : (root.panel-hotkey == "" ? @tr("Show Panel") : @tr("Show Panel ({})", root.panel-hotkey));
                                    active: root.panel-visible;
                                    own-tooltip: true;
                                    clicked => { root.panel-requested(); }
                                }
                                Rectangle {
                                    width: Space.s3;
                                    height: root.ctl-h;
                                    Rectangle {
                                        width: 1px;
                                        height: root.ctl-h * 0.6;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: Theme.border-subtle;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Space.s1;
                                    undo-button := IconButton {
                                        scaled: true;
                                        side-override: root.ctl-h;
                                        icon: Icons.arrow-counter-clockwise;
                                        tooltip: root.undo-tip;
                                        own-tooltip: true;
                                        enabled: root.can-undo;
                                        clicked => { root.undo-requested(); }
                                    }
                                    redo-button := IconButton {
                                        scaled: true;
                                        side-override: root.ctl-h;
                                        icon: Icons.arrow-clockwise;
                                        tooltip: root.redo-tip;
                                        own-tooltip: true;
                                        enabled: root.can-redo;
                                        clicked => { root.redo-requested(); }
                                    }
                                }
                                Rectangle {
                                    width: Space.s3;
                                    height: root.ctl-h;
                                    Rectangle {
                                        width: 1px;
                                        height: root.ctl-h * 0.6;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: Theme.border-subtle;
                                    }
                                }
                                commands-button := ToolbarButton {
                                    h: root.ctl-h;
                                    compact: root.toolbar-compact;
                                    icon: Icons.keyboard;
                                    label: @tr("Commands");
                                    keys: ["Ctrl", "K"];
                                    tooltip: @tr("Commands (Ctrl+K)");
                                    clicked => { root.open-palette(); }
                                }
                                Rectangle {
                                    width: Space.s3;
                                    height: root.ctl-h;
                                    Rectangle {
                                        width: 1px;
                                        height: root.ctl-h * 0.6;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: Theme.border-subtle;
                                    }
                                }
                                view-button := ToolbarButton {
                                    h: root.ctl-h;
                                    compact: root.toolbar-compact;
                                    icon: Icons.rows;
                                    label: @tr("View");
                                    caret: true;
                                    tooltip: @tr("View");
                                    active: root.view-menu-open;
                                    clicked => { root.open-view-menu(); }
                                }
                                Rectangle {
                                    width: Space.s3;
                                    height: root.ctl-h;
                                    Rectangle {
                                        width: 1px;
                                        height: root.ctl-h * 0.6;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: Theme.border-subtle;
                                    }
                                }
                                segmented := Rectangle {
                                    width: seg-row.preferred-width;
                                    height: root.ctl-h;
                                    background: Theme.bg-surface;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    border-radius: Radius.md + Space.s0-5;
                                    seg-row := HorizontalLayout {
                                        padding: Space.s0-5;
                                        spacing: Space.s0-5;
                                view-comfortable := IconButton {
                                    scaled: true;
                                    side-override: root.ctl-h - 2 * Space.s0-5;
                                    icon: Icons.rows;
                                    tooltip: @tr("Comfortable view");
                                    active: root.view == MainView.comfortable;
                                    accessible-checkable: true;
                                    accessible-checked: root.view == MainView.comfortable;
                                    clicked => {
                                        root.view = MainView.comfortable;
                                        root.view-changed(MainView.comfortable);
                                    }
                                }
                                view-compact := IconButton {
                                    scaled: true;
                                    side-override: root.ctl-h - 2 * Space.s0-5;
                                    icon: Icons.list-bullets;
                                    tooltip: @tr("Compact view");
                                    active: root.view == MainView.compact;
                                    accessible-checkable: true;
                                    accessible-checked: root.view == MainView.compact;
                                    clicked => {
                                        root.view = MainView.compact;
                                        root.view-changed(MainView.compact);
                                    }
                                }
                                view-tile := IconButton {
                                    scaled: true;
                                    side-override: root.ctl-h - 2 * Space.s0-5;
                                    icon: Icons.squares-four;
                                    tooltip: @tr("Tile view");
                                    active: root.view == MainView.tile;
                                    accessible-checkable: true;
                                    accessible-checked: root.view == MainView.tile;
                                    clicked => {
                                        root.view = MainView.tile;
                                        root.view-changed(MainView.tile);
                                    }
                                }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            Button {
                                horizontal-stretch: 0;
                                variant: ButtonVariant.primary;
                                icon: Icons.plus;
                                text: @tr("New item");
                                clicked => { root.new-item-requested(); }
                            }
                        }
                    }
                }

                // ---- Heading: where the user is -----------------------------------------------
                Rectangle {
                    height: max(Space.s8, Type.line-lg + Space.s2);
                    HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad;
                        spacing: Space.s2;
                        if !root.auto-rail: sidebar-toggle := IconButton {
                            horizontal-stretch: 0;
                            scaled: true;
                            side-override: root.ctl-h;
                            icon: root.sidebar-collapsed ? Icons.caret-double-right : Icons.caret-double-left;
                            tooltip: root.sidebar-collapsed ? @tr("Expand sidebar (Ctrl+B)") : @tr("Collapse sidebar (Ctrl+B)");
                            own-tooltip: true;
                            active: root.sidebar-collapsed;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.toggle-sidebar(); }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.section-name();
                            font-family: Fonts.sans;
                            font-size: Type.lg;
                            font-weight: Type.semibold;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: AccessibleRole.text;
                            accessible-label: root.section-name();
                        }
                        if root.section == MainSection.list && !root.searching: sort-button := ToolbarButton {
                            horizontal-stretch: 0;
                            h: root.ctl-h;
                            icon: Icons.rows;
                            label: @tr("Sort: {}", root.sort-name(root.list-sort));
                            tooltip: @tr("Sort by: {}", root.sort-name(root.list-sort));
                            caret: true;
                            active: root.sort-menu-open;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.open-sort-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
                        }
                        if root.in-trash && root.rows.length > 0: Button {
                            horizontal-stretch: 0;
                            variant: ButtonVariant.danger;
                            icon: Icons.trash;
                            text: @tr("Empty Trash…");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.ask(3, 0); }
                        }
                    }
                }

                // ---- Colour-label filter ----------------------------------------------------------
                if root.label-chips.length > 0 || root.label-filter >= 0: Rectangle {
                    height: Space.hit + Space.s2;
                    accessible-role: AccessibleRole.groupbox;
                    accessible-label: @tr("Filter by colour label");
                    HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad;
                        padding-bottom: Space.s1;
                        spacing: Space.s1;
                        alignment: start;
                        for chip in root.label-chips: LabelChip {
                            y: (parent.height - self.height) / 2;
                            text: chip.name;
                            hue: [ListHue.blue, ListHue.teal, ListHue.green, ListHue.amber, ListHue.orange, ListHue.red, ListHue.violet, ListHue.slate][chip.label];
                            count: chip.count;
                            selected: chip.label == root.label-filter;
                            clicked => { root.label-filter-requested(chip.label == root.label-filter ? -1 : chip.label); }
                        }
                        if root.label-filter >= 0: Button {
                            variant: ButtonVariant.ghost;
                            text: @tr("Clear filter");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.label-filter-requested(-1); }
                        }
                        if root.label-filter >= 0: Text {
                            text: @tr("{n} item" | "{n} items" % (root.list-total >= 0 ? root.list-total : root.rows.length));
                            font-family: Fonts.sans;
                            font-size: Type.sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // ---- Quick add (an open list) -----------------------------------------------------
                if root.quick-add-shown && (root.rows.length > 0 || root.quick-open): HorizontalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad;
                    padding-bottom: Space.s1;
                    QuickAdd {
                        expanded <=> root.quick-open;
                        list-name: root.section-name();
                        show-more: true;
                        open-request: root.quick-add-request;
                        detect-kind(t) => { root.detect-kind(t) }
                        create(t, k, s) => { root.quick-add-requested(t, k, s); }
                        full-editor(t) => { root.quick-add-full(t); }
                        cancelled => { root.focus-items(); }
                    }
                }

                // ---- The items --------------------------------------------------------------------
                deck := Rectangle {
                    vertical-stretch: 1;
                    min-height: Space.s12;
                    clip: true;

                    items-scope := FocusScope {
                        width: parent.width;
                        height: parent.height;

                        changed has-focus => {
                            if (self.has-focus) {
                                if (root.mouse-focus) {
                                    root.mouse-focus = false;
                                } else {
                                    root.kbd-focus = true;
                                }
                            }
                        }
                        key-pressed(event) => {
                            root.mouse-focus = false;
                            root.kbd-focus = true;
                            let shift = event.modifiers.shift;
                            let ctrl = event.modifiers.control || event.modifiers.meta;
                            if (event.modifiers.alt && !event.modifiers.control && !event.modifiers.shift
                                && !root.in-trash && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                                root.item-reorder-requested(event.text == Key.UpArrow ? -1 : 1);
                                return accept;
                            }
                            if (root.recent-shown && !event.modifiers.alt && !ctrl) {
                                // Recent list: Up/Down/Home/End/PageUp/PageDown move the active row, Enter or Space
                                // copies it, Delete removes it, Menu or Shift+F10 opens its menu, Right "Save to…".
                                let last = root.recent-rows.length - 1;
                                if (event.text == Key.DownArrow) { root.move-recent(root.rcur + 1); return accept; }
                                if (event.text == Key.UpArrow) { root.move-recent(root.rcur - 1); return accept; }
                                if (event.text == Key.PageDown) { root.move-recent(root.rcur + root.page-rows); return accept; }
                                if (event.text == Key.PageUp) { root.move-recent(root.rcur - root.page-rows); return accept; }
                                if (event.text == Key.Home) { root.move-recent(0); return accept; }
                                if (event.text == Key.End) { root.move-recent(last); return accept; }
                                if (event.text == Key.Return || event.text == " ") {
                                    root.recent-copied(root.recent-rows[root.rcur].id);
                                    return accept;
                                }
                                if (event.text == Key.Delete) {
                                    root.recent-deleted(root.recent-rows[root.rcur].id);
                                    return accept;
                                }
                                if (event.text == Key.Menu || (shift && event.text == Key.F10)) {
                                    root.open-recent-menu(root.rcur, root.sidebar-w + root.pad * 2, root.bar-h * 2 + Space.s8);
                                    return accept;
                                }
                                if (event.text == Key.RightArrow) {
                                    root.open-recent-save(root.rcur, root.sidebar-w + root.pad * 2, root.bar-h * 2 + Space.s8);
                                    return accept;
                                }
                                return reject;
                            }
                            if (ctrl && !event.modifiers.alt && !shift && !root.in-trash && !root.recent-shown && (event.text == "v" || event.text == "V")) {
                                root.paste-create-requested();
                                return accept;
                            }
                            if (event.modifiers.alt || root.rows.length == 0) {
                                return reject;
                            }
                            if (ctrl && !shift && !root.in-trash && (event.text == "g" || event.text == "G")) {
                                root.group-requested(root.cur);
                                return accept;
                            }
                            // A group's header: Left folds it, Right unfolds it, Enter does the other, F2 renames it, Delete
                            // deletes the group (its items go to the Trash with an Undo).
                            if (!ctrl && !shift && root.cur >= 0 && root.rows[root.cur].is-header) {
                                if (event.text == Key.LeftArrow) { root.group-collapsed-set(root.cur, true); return accept; }
                                if (event.text == Key.RightArrow) { root.group-collapsed-set(root.cur, false); return accept; }
                                if (event.text == Key.Return) { root.group-toggled(root.cur); return accept; }
                                if (event.text == Key.F2) { root.group-rename-requested(root.cur); return accept; }
                                if (event.text == Key.Delete) { root.group-delete-requested(root.cur); return accept; }
                            }
                            if (ctrl) {
                                if (!shift && !root.in-trash && !root.recent-shown && (event.text == "c" || event.text == "C")) {
                                    root.copy-selection-requested(root.cur);
                                    return accept;
                                }
                                if (event.text == "a" || event.text == "A") {
                                    root.select-all-requested();
                                    return accept;
                                }
                                if (event.text == " ") {
                                    root.select-requested(root.cur, SelectMode.toggle);
                                    return accept;
                                }
                                if (!root.in-trash && (event.text == "e" || event.text == "E")) {
                                    root.act(ItemAction.edit, root.cur);
                                    return accept;
                                }
                                if (!root.in-trash && (event.text == "p" || event.text == "P")) {
                                    root.act(ItemAction.pin, root.cur);
                                    return accept;
                                }
                                if (!root.in-trash && (event.text == "d" || event.text == "D")) {
                                    root.act(ItemAction.duplicate, root.cur);
                                    return accept;
                                }
                                return reject;
                            }
                            if (event.text == Key.DownArrow) {
                                root.move-cursor(root.tile ? root.cols : 1, shift);
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.move-cursor(root.tile ? -root.cols : -1, shift);
                                return accept;
                            }
                            if (root.tile && event.text == Key.RightArrow) {
                                root.move-cursor(1, shift);
                                return accept;
                            }
                            if (root.tile && event.text == Key.LeftArrow) {
                                root.move-cursor(-1, shift);
                                return accept;
                            }
                            if (event.text == Key.PageDown) {
                                root.move-cursor(root.page-rows * (root.tile ? root.cols : 1), shift);
                                return accept;
                            }
                            if (event.text == Key.PageUp) {
                                root.move-cursor(-root.page-rows * (root.tile ? root.cols : 1), shift);
                                return accept;
                            }
                            if (event.text == Key.Home) {
                                root.move-cursor(-root.rows.length, shift);
                                return accept;
                            }
                            if (event.text == Key.End) {
                                root.move-cursor(root.rows.length, shift);
                                return accept;
                            }
                            if (event.text == Key.Return) {
                                if (root.in-trash) {
                                    root.act(ItemAction.restore, root.cur);
                                } else {
                                    root.act(shift ? ItemAction.copy : ItemAction.use, root.cur);
                                }
                                return accept;
                            }
                            if (event.text == Key.F2 && !root.in-trash) {
                                root.act(ItemAction.edit, root.cur);
                                return accept;
                            }
                            if (event.text == Key.Delete) {
                                root.act(root.in-trash ? ItemAction.delete-forever : ItemAction.delete, root.cur);
                                return accept;
                            }
                            if (event.text == Key.Escape) {
                                if (root.selected-count > 0) {
                                    root.clear-selection-requested();
                                    return accept;
                                }
                                return reject;
                            }
                            if (event.text == Key.Menu || (shift && event.text == Key.F10)) {
                                root.open-item-menu(root.cur, root.sidebar-w + root.pad * 2, root.bar-h * 2 + Space.s8);
                                return accept;
                            }
                            // Keyboard reveal: hold Space (a sensitive item only).
                            if (event.text == " " && root.cur >= 0 && root.rows[root.cur].kind == ItemKind.sensitive) {
                                root.reveal-requested(root.cur, true);
                                return accept;
                            }
                            return reject;
                        }
                        key-released(event) => {
                            if (event.text == " " && root.cur >= 0 && root.rows[root.cur].kind == ItemKind.sensitive) {
                                root.reveal-requested(root.cur, false);
                                return accept;
                            }
                            return reject;
                        }
                    }

                    // ---- Rows (comfortable and compact) -----------------------------------------
                    Rectangle {
                        visible: !root.tile;
                        // The item area's fill: the rows are quiet, with no outline of their own.
                        Rectangle {
                            visible: root.rows.length > 0;
                            background: Theme.bg-surface;
                        }
                        list := ListView {
                            x: root.list-pad - root.ring;
                            y: 0px;
                            width: parent.width - 2 * root.list-pad + 2 * root.ring;
                            height: parent.height;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            accessible-label: @tr("Snippets");
                            visible: root.rows.length > 0;

                            for row[i] in root.list-model: Rectangle {
                                property <bool> is-cursor: i == root.cur;
                                // The row being dragged over this one: a drop lands after it when coming from above.
                                property <int> row-from: -1;
                                height: (row.is-header ? Space.hit : card.preferred-height) + root.row-gap + (i == root.rows.length - 1 ? 2 * root.ring : 0px);

                                init => {
                                    if (self.is-cursor) { root.reveal-list(self.y, self.height); }
                                }
                                changed is-cursor => {
                                    if (self.is-cursor) { root.reveal-list(self.y, self.height); }
                                }
                                changed y => {
                                    if (self.is-cursor) { root.reveal-list(self.y, self.height); }
                                }

                                row-drop := DropArea {
                                    enabled: root.rows-reorderable || root.reorder-offer;
                                    can-drop(event) => {
                                        row-from = root.payload-row(event.data);
                                        row-from >= 0 && row-from != i ? DragAction.move : DragAction.none
                                    }
                                    dropped(event) => {
                                        root.row-dropped(root.payload-row(event.data), i);
                                        return DragAction.move;
                                    }

                                    DragArea {
                                        allow-move: !root.in-trash;
                                        data: root.row-payload(i);

                                        // A group's header takes the place of a card.
                                        if row.is-header: GroupHeader {
                                            x: root.ring;
                                            y: root.ring;
                                            width: parent.width - 2 * root.ring;
                                            height: Space.hit - 2 * root.ring;
                                            name: row.title;
                                            collapsed: row.group-collapsed;
                                            count-text: @tr("{} item" | "{} items" % row.group-count, row.group-count);
                                            a11y-label: root.group-announcement(row.title, row.group-count);
                                            rename-label: @tr("Group name");
                                            selected: i == root.cur && items-scope.has-focus && root.kbd-focus;
                                            rename-request: root.rename-row == i ? root.rename-seq : 0;
                                            toggled => { root.cursor = i; root.group-toggled(i); }
                                            renamed(text) => { root.group-renamed(i, text); }
                                            rename-ended => { root.group-rename-ended(); items-scope.focus(); }
                                            menu-requested(x, y) => {
                                                root.cursor = i;
                                                root.open-item-menu(i, self.absolute-position.x + x, self.absolute-position.y + y);
                                            }
                                        }

                                        card := MainCard {
                                            visible: !row.is-header;
                                            x: root.ring + (row.grouped ? Space.s3 : 0px);
                                            y: root.ring;
                                            width: parent.width - 2 * root.ring - (row.grouped ? Space.s3 : 0px);
                                            height: self.preferred-height;
                                            variant: root.view == MainView.compact ? ItemCardVariant.compact : ItemCardVariant.comfortable;
                                            data: row;
                                            // Use first (Restore in the Trash), then Copy (not when Use already copies), Edit, More.
                                            use-action: true;
                                            use-glyph: root.in-trash ? Icons.arrow-counter-clockwise : Icons.arrow-bend-down-left;
                                            use-tip: root.in-trash ? @tr("Restore") : @tr("{} (Enter)", root.use-label);
                                            copy-action: !(root.use-copies && !root.in-trash);
                                            edit-action: !root.in-trash;
                                            show-actions: row.selected;
                                            actions-hidden: root.selected-count > 1;
                                            show-focus: i == root.cur && items-scope.has-focus && root.kbd-focus;
                                            revealed: i == root.revealed-index;
                                            pulling: i == root.used-index;
                                            use => {
                                                root.cursor = i;
                                                root.act(root.in-trash ? ItemAction.restore : ItemAction.use, i);
                                            }
                                            copy => { root.act(ItemAction.copy, i); }
                                            edit => { root.act(ItemAction.edit, i); }
                                            tip(text, cx, bottom, on) => { root.card-tip-set(text, cx, bottom, on); }
                                            picked(shift, control) => { root.pick(i, shift, control); }
                                            context-menu-requested(x, y) => {
                                                if (!row.selected) {
                                                    root.pick(i, false, false);
                                                }
                                                root.open-item-menu(i, self.absolute-position.x + x, self.absolute-position.y + y);
                                            }
                                            reveal-requested(on) => { root.reveal-requested(i, on); }
                                        }
                                    }
                                }
                                // The drop target: a 2px accent line where the dragged row would land: below this row when it
                                // comes from above, above it otherwise.
                                Rectangle {
                                    visible: row-drop.has-drag;
                                    x: root.ring;
                                    y: row-from >= 0 && row-from < i ? card.y + card.height - 1px : 0px;
                                    width: parent.width - 2 * root.ring;
                                    height: 2px;
                                    background: Theme.accent;
                                }
                            }
                        }

                        list-bar := OverlayScrollbar {
                            content-y: list.content-y;
                            content-height: list.content-height;
                            visible-height: list.height;
                            enabled: list.visible;
                            scroll-to(y) => { list.content-y = y; }
                        }
                        if root.rows.length > 0 && list.content-y < -1px: DeckEdge {
                            position: DeckEdgePosition.top;
                            x: root.pad;
                            y: Space.s1;
                            width: parent.width - 2 * root.pad;
                        }
                        if root.rows.length > 0 && list.content-height + list.content-y > list.height + 1px: DeckEdge {
                            position: DeckEdgePosition.bottom;
                            x: root.pad;
                            y: parent.height - self.height;
                            width: parent.width - 2 * root.pad;
                        }
                    }

                    // ---- Tiles ---------------------------------------------------------------------
                    Rectangle {
                        visible: root.tile;
                        grid := ListView {
                            x: root.pad - root.ring;
                            y: 0px;
                            width: parent.width - 2 * root.pad + 2 * root.ring;
                            height: parent.height;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            accessible-label: @tr("Snippets");
                            visible: root.rows.length > 0;

                            for r in root.grid-row-count: Rectangle {
                                property <bool> has-cursor: floor(root.cur / root.cols) == r;
                                // Each cell reports the height its card needs; a grid row takes its tallest card (min 96).
                                property <[length]> need: [0px, 0px, 0px, 0px, 0px, 0px];
                                height: max(self.need[0], self.need[1], self.need[2], self.need[3], self.need[4], self.need[5]) + root.tile-gap + (r == root.grid-row-count - 1 ? 2 * root.ring : 0px);

                                init => {
                                    if (self.has-cursor) { root.reveal-grid(self.y, self.height); }
                                }
                                changed has-cursor => {
                                    if (self.has-cursor) { root.reveal-grid(self.y, self.height); }
                                }
                                changed y => {
                                    if (self.has-cursor) { root.reveal-grid(self.y, self.height); }
                                }

                                for c in root.cols: Rectangle {
                                    x: root.ring + c * (root.tile-w + root.tile-gap);
                                    y: root.ring;
                                    width: root.tile-w;
                                    height: parent.height - root.tile-gap - (r == root.grid-row-count - 1 ? 2 * root.ring : 0px);
                                    property <length> need: root.tile-index(r, c) < root.rows.length ? tile-probe.preferred-height : 0px;
                                    init => { parent.need[c] = self.need; }
                                    changed need => { parent.need[c] = self.need; }
                                    tile-probe := MainCard {
                                        visible: false;
                                        y: -2000px;
                                        width: parent.width;
                                        variant: ItemCardVariant.tile;
                                        inline-tile: true;
                                        data: root.rows[root.tile-index(r, c)];
                                    }
                                    if root.tile-index(r, c) < root.rows.length: tile-drop := DropArea {
                                        // The tile being dragged over this one: a drop lands after it when coming from before.
                                        property <int> tile-from: -1;
                                        enabled: root.rows-reorderable || root.reorder-offer;
                                        can-drop(event) => {
                                            tile-from = root.payload-row(event.data);
                                            tile-from >= 0 && tile-from != root.tile-index(r, c) ? DragAction.move : DragAction.none
                                        }
                                        dropped(event) => {
                                            root.row-dropped(root.payload-row(event.data), root.tile-index(r, c));
                                            return DragAction.move;
                                        }

                                    DragArea {
                                        allow-move: !root.in-trash;
                                        data: root.row-payload(root.tile-index(r, c));
                                    tile-card := MainCard {
                                        width: parent.width;
                                        height: parent.height;
                                        variant: ItemCardVariant.tile;
                                        data: root.rows[root.tile-index(r, c)];
                                        inline-tile: true;
                                        // Use first (Restore in the Trash), then Copy (not when Use already copies), Edit, More.
                                        use-action: true;
                                        use-glyph: root.in-trash ? Icons.arrow-counter-clockwise : Icons.arrow-bend-down-left;
                                        use-tip: root.in-trash ? @tr("Restore") : @tr("{} (Enter)", root.use-label);
                                        copy-action: !(root.use-copies && !root.in-trash);
                                        edit-action: !root.in-trash;
                                        show-actions: root.rows[root.tile-index(r, c)].selected;
                                        actions-hidden: root.selected-count > 1;
                                        tip(text, cx, bottom, on) => { root.card-tip-set(text, cx, bottom, on); }
                                        edit => { root.act(ItemAction.edit, root.tile-index(r, c)); }
                                        show-focus: root.tile-index(r, c) == root.cur && items-scope.has-focus && root.kbd-focus;
                                        revealed: root.tile-index(r, c) == root.revealed-index;
                                        pulling: root.tile-index(r, c) == root.used-index;
                                        use => {
                                            root.cursor = root.tile-index(r, c);
                                            root.act(root.in-trash ? ItemAction.restore : ItemAction.use, root.tile-index(r, c));
                                        }
                                        copy => { root.act(ItemAction.copy, root.tile-index(r, c)); }
                                        picked(shift, control) => { root.pick(root.tile-index(r, c), shift, control); }
                                        context-menu-requested(x, y) => {
                                            if (!root.rows[root.tile-index(r, c)].selected) {
                                                root.pick(root.tile-index(r, c), false, false);
                                            }
                                            root.open-item-menu(root.tile-index(r, c), self.absolute-position.x + x, self.absolute-position.y + y);
                                        }
                                        reveal-requested(on) => { root.reveal-requested(root.tile-index(r, c), on); }
                                    }
                                    }
                                    // The drop target: a 2px accent bar where the dragged tile would land: after this tile when it
                                    // comes from before, ahead of it otherwise.
                                    Rectangle {
                                        visible: tile-drop.has-drag;
                                        x: tile-drop.tile-from >= 0 && tile-drop.tile-from < root.tile-index(r, c) ? parent.width - 2px : 0px;
                                        width: 2px;
                                        height: parent.height;
                                        background: Theme.accent;
                                    }
                                    }
                                }
                            }
                        }

                        grid-bar := OverlayScrollbar {
                            content-y: grid.content-y;
                            content-height: grid.content-height;
                            visible-height: grid.height;
                            enabled: grid.visible;
                            scroll-to(y) => { grid.content-y = y; }
                        }
                        if root.rows.length > 0 && grid.content-y < -1px: DeckEdge {
                            position: DeckEdgePosition.top;
                            x: root.pad;
                            y: Space.s1;
                            width: parent.width - 2 * root.pad;
                        }
                        if root.rows.length > 0 && grid.content-height + grid.content-y > grid.height + 1px: DeckEdge {
                            position: DeckEdgePosition.bottom;
                            x: root.pad;
                            y: parent.height - self.height;
                            width: parent.width - 2 * root.pad;
                        }
                    }

                    if root.loading && !root.tile: VerticalLayout {
                        x: root.pad;
                        y: Space.s1;
                        width: parent.width - 2 * root.pad;
                        alignment: start;
                        for n in [0, 1, 2, 3, 4, 5, 6, 7]: Skeleton {
                            kind: SkeletonKind.row;
                            label: n == 0 ? @tr("Loading") : "";
                        }
                    }
                    if root.loading && root.tile: HorizontalLayout {
                        x: root.pad;
                        y: Space.s1;
                        width: parent.width - 2 * root.pad;
                        height: 120px * SystemLook.text-scale;
                        spacing: root.tile-gap;
                        alignment: start;
                        for n in [0, 1, 2]: Skeleton {
                            kind: SkeletonKind.tile;
                            width: (parent.width - 2 * root.tile-gap) / 3;
                            label: n == 0 ? @tr("Loading") : "";
                        }
                    }

                    // ---- The Recent inbox: a read-only list of what was copied, with Copy, Save to… and Remove ----
                    if root.recent-shown: VerticalLayout {
                        x: root.pad;
                        width: parent.width - 2 * root.pad;
                        height: parent.height;
                        spacing: Space.s2;
                        HorizontalLayout {
                            alignment: end;
                            Button {
                                variant: ButtonVariant.ghost;
                                icon: Icons.trash;
                                text: @tr("Clear recent history");
                                clicked => { root.ask(5, 0); }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            rlist := ListView {
                                width: parent.width;
                                height: parent.height;
                                accessible-label: @tr("Recent copies");
                                for entry[i] in root.recent-rows: Rectangle {
                                    property <bool> is-active: i == root.rcur;
                                    function reveal() {
                                        if (root.rcur == 0) {
                                            rlist.content-y = 0px;
                                        } else if (self.y + rlist.content-y < 0px) {
                                            rlist.content-y = -self.y;
                                        } else if (self.y + self.height + rlist.content-y > rlist.height) {
                                            rlist.content-y = rlist.height - self.y - self.height;
                                        }
                                    }
                                    height: rcard.preferred-height + root.row-gap + (i == root.recent-rows.length - 1 ? 2 * root.ring : 0px);
                                    init => {
                                        if (self.is-active) { self.reveal(); }
                                    }
                                    changed is-active => {
                                        if (self.is-active) { self.reveal(); }
                                    }
                                    changed y => {
                                        if (self.is-active) { self.reveal(); }
                                    }
                                    rcard := ItemCard {
                                        x: root.ring;
                                        y: root.ring;
                                        width: parent.width - 2 * root.ring;
                                        height: self.preferred-height;
                                        keyboard-focusable: false;
                                        selected: i == root.rcur;
                                        show-focus: i == root.rcur && items-scope.has-focus;
                                        variant: root.view == MainView.compact ? ItemCardVariant.compact : ItemCardVariant.comfortable;
                                        kind: entry.kind;
                                        image: entry.image;
                                        title: entry.preview;
                                        preview: entry.app == "" ? RecentText.ago(entry.age-minutes) : entry.app + " · " + RecentText.ago(entry.age-minutes);
                                        use => {
                                            root.recent-cursor = i;
                                            root.recent-copied(entry.id);
                                        }
                                        copy => {
                                            root.recent-cursor = i;
                                            root.recent-copied(entry.id);
                                        }
                                        double-clicked => {
                                            root.recent-cursor = i;
                                            root.open-recent-save(i, self.absolute-position.x + Space.s6, self.absolute-position.y + self.height);
                                        }
                                        context-menu-requested(x, y) => {
                                            root.recent-cursor = i;
                                            root.open-recent-menu(i, self.absolute-position.x + x, self.absolute-position.y + y);
                                        }
                                    }
                                }
                            }

                            rlist-bar := OverlayScrollbar {
                                content-y: rlist.content-y;
                                content-height: rlist.content-height;
                                visible-height: rlist.height;
                                scroll-to(y) => { rlist.content-y = y; }
                            }
                        }
                    }

                    if root.rows.length == 0 && !root.loading && !root.recent-shown: EmptyState {
                        quiet: true;
                        x: root.pad;
                        width: parent.width - 2 * root.pad;
                        height: parent.height;
                        kind: root.searching ? EmptyStateKind.search
                            : root.section == MainSection.recent || root.in-trash || root.section == MainSection.tag ? EmptyStateKind.inbox
                            : EmptyStateKind.list;
                        heading: root.searching ? @tr("No matches")
                            : root.section == MainSection.all ? @tr("No snippets yet")
                            : root.section == MainSection.pinned ? @tr("Nothing pinned")
                            : root.section == MainSection.recent ? (root.recent-locked ? @tr("Recent copies are locked") : root.recent-on ? @tr("Nothing copied yet") : @tr("No recent items"))
                            : root.in-trash ? @tr("The Trash is empty")
                            : root.section == MainSection.list ? @tr("This list is empty")
                            : @tr("No items with this tag");
                        body: root.searching ? @tr("Nothing matches “{}”.", root.query)
                            : root.section == MainSection.all ? @tr("Save what you paste often.")
                            : root.section == MainSection.pinned ? @tr("Pin the snippets you use most to keep them one click away.")
                            : root.section == MainSection.recent ? (root.recent-locked ? @tr("Unlock your library to see recent copies. Nothing is collected while it is locked.") : root.recent-on ? @tr("Text you copy appears here, newest first, until you clear it or it is older than {} days.", root.recent-days) : @tr("Turn on clipboard history in Settings to collect what you copy."))
                            : root.in-trash ? @tr("Deleted items stay here for {} days before they are removed.", root.trash-days)
                            : root.section == MainSection.list ? @tr("Add a snippet, or move items here from another list.")
                            : @tr("Tag a snippet to see it here.");
                        action-keys: !root.searching && root.section == MainSection.list ? ["Ctrl", "N"] : [];
                        action-keys-label: @tr("Control N");
                        secondary-keys: !root.searching && root.section == MainSection.all ? ["Ctrl", "N"] : [];
                        secondary-keys-label: @tr("Control N");
                        action-text: root.searching ? ""
                            : root.section == MainSection.all ? @tr("Save from clipboard")
                            : root.section == MainSection.list ? @tr("New item")
                            : root.section == MainSection.recent && root.recent-locked ? @tr("Unlock")
                            : root.section == MainSection.recent && !root.recent-on ? @tr("Open Settings") : "";
                        secondary-text: !root.searching && root.section == MainSection.all ? @tr("New item") : "";
                        tertiary-text: !root.searching && root.section == MainSection.all ? @tr("Import…") : "";
                        secondary => { root.new-item-requested(); }
                        tertiary => { root.import-requested(); }
                        action => {
                            if (root.section == MainSection.all && !root.searching) {
                                root.add-from-clipboard();
                            } else if (root.section == MainSection.recent && root.recent-locked) {
                                root.recent-unlock-requested();
                            } else if (root.section == MainSection.recent) {
                                root.settings-requested();
                            } else {
                                root.new-item();
                            }
                        }
                    }

                    if root.toast-text != "": Toast {
                        text: root.toast-text;
                        kind: root.toast-kind;
                        phase: root.toast-phase;
                        undo-label: root.toast-undo-label;
                        edit-label: root.toast-edit-label;
                        width: min(self.preferred-width, 480px, parent.width - 2 * root.pad);
                        height: self.preferred-height;
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - Space.s2;
                        undo => { root.toast-undo(); }
                        edit => { root.toast-edit(); }
                        hover-changed(h) => { root.toast-hover-changed(h); }
                    }
                }

                // ---- Bulk-action bar: appears with two or more items selected --------------------
                if root.multi: Rectangle {
                    height: max(Space.s8 + Space.s2, Type.line-base + Space.s4);
                    background: Theme.bg-surface;
                    accessible-role: groupbox;
                    accessible-label: @tr("{} selected", root.selected-count);

                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                    HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad;
                        spacing: Space.s2;
                        Text {
                            horizontal-stretch: 0;
                            text: @tr("{} selected", root.selected-count);
                            font-family: Fonts.sans;
                            font-size: Type.base;
                            font-weight: Type.medium;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if !root.in-trash: Button {
                            horizontal-stretch: 0;
                            icon: Icons.folder;
                            text: @tr("Move");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.act(ItemAction.move, root.cur); }
                        }
                        if !root.in-trash: Button {
                            horizontal-stretch: 0;
                            icon: Icons.tag;
                            text: @tr("Tag");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.act(ItemAction.tag, root.cur); }
                        }
                        if !root.in-trash: Button {
                            horizontal-stretch: 0;
                            icon: Icons.push-pin;
                            text: @tr("Pin");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.act(ItemAction.pin, root.cur); }
                        }
                        if !root.in-trash: Button {
                            horizontal-stretch: 0;
                            variant: ButtonVariant.danger;
                            icon: Icons.trash;
                            text: @tr("Move to Trash");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.act(ItemAction.delete, root.cur); }
                        }
                        if root.in-trash: Button {
                            horizontal-stretch: 0;
                            icon: Icons.arrow-counter-clockwise;
                            text: @tr("Restore");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.act(ItemAction.restore, root.cur); }
                        }
                        if root.in-trash: Button {
                            horizontal-stretch: 0;
                            variant: ButtonVariant.danger;
                            icon: Icons.trash;
                            text: @tr("Delete for good…");
                            y: (parent.height - self.height) / 2;
                            clicked => { root.act(ItemAction.delete-forever, root.cur); }
                        }
                        IconButton {
                            scaled: true;
                            horizontal-stretch: 0;
                            icon: Icons.x;
                            tooltip: @tr("Clear selection");
                            own-tooltip: true;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.clear-selection-requested(); }
                        }
                    }
                }

                // ---- Status line -----------------------------------------------------------------
                Rectangle {
                    height: max(Space.s8, Type.line-sm + Space.s3);
                    accessible-role: AccessibleRole.text;
                    accessible-label: root.selected-count > 0 ? @tr("{} selected", root.selected-count) : root.status-text;
                    accessible-live-region: polite;

                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                    HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad;
                        spacing: Space.s2;
                        Text {
                            horizontal-stretch: 1;
                            text: root.status-text;
                            font-family: Fonts.sans;
                            font-size: Type.sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        if root.in-trash: Text {
                            horizontal-stretch: 0;
                            text: @tr("Items are removed after {} days.", root.trash-days);
                            font-family: Fonts.sans;
                            font-size: Type.sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
            }
        }

        // The splitter: an 8px strip straddling the sidebar's edge (4px each side), above the layout so it never sits under a sidebar control. Drag it, or focus it and press Left / Right
        // (8px a step). It is not there on the rail.
        if !root.narrow: splitter := Rectangle {
            x: root.sidebar-w - root.splitter-w / 2;
            width: root.splitter-w;
            height: parent.height;
            background: transparent;
            forward-focus: splitter-scope;

            // The line that shows it can be grabbed (hover or drag) and, in the focus colour, that it has focus.
            Rectangle {
                x: (parent.width - self.width) / 2;
                width: splitter-scope.has-focus ? 3px : 2px;
                background: splitter-scope.has-focus ? Theme.focus-ring : splitter-touch.pressed ? Theme.accent-text : Theme.border-strong;
                opacity: (splitter-scope.has-focus || splitter-touch.has-hover || splitter-touch.pressed) ? 1 : 0;
                animate opacity { duration: Motion.instant; easing: Motion.out; }
            }
            splitter-touch := TouchArea {
                mouse-cursor: MouseCursor.col-resize;
                pointer-event(event) => {
                    if (event.button != PointerEventButton.left) {
                        return;
                    }
                    if (event.kind == PointerEventKind.down) {
                        // How far the pointer is from the sidebar's edge, so the edge does not jump to it.
                        root.splitter-grab = root.sidebar-w - (self.absolute-position.x + self.mouse-x);
                    } else if (event.kind == PointerEventKind.up) {
                        root.sidebar-width-changed(root.sidebar-width);
                    }
                }
                moved => {
                    if (self.pressed) {
                        let edge = self.absolute-position.x + self.mouse-x + root.splitter-grab;
                        root.set-sidebar-width(((edge - (root.text-scale - 1) * 96px) / 1px).round(), false);
                    }
                }
            }
            splitter-scope := FocusScope {
                accessible-role: AccessibleRole.slider;
                accessible-label: @tr("Sidebar width");
                accessible-value: root.sidebar-width;
                accessible-value-minimum: 200;
                accessible-value-maximum: 320;
                accessible-value-step: 8;
                accessible-action-increment => { root.set-sidebar-width(root.sidebar-width + 8, true); }
                accessible-action-decrement => { root.set-sidebar-width(root.sidebar-width - 8, true); }
                changed has-focus => { root.splitter-focused = self.has-focus; }
                key-pressed(event) => {
                    if (event.text == Key.LeftArrow) {
                        root.set-sidebar-width(root.sidebar-width - 8, true);
                        return accept;
                    }
                    if (event.text == Key.RightArrow) {
                        root.set-sidebar-width(root.sidebar-width + 8, true);
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }

    // The bulk bar already says how many are selected; the line shows the count of items and announces the selection.
    // While searching it counts the matches and names the board they were found in.
    property <string> status-text: root.searching
        ? (root.rows.length == 0 ? @tr("No matches in {}", root.board-name)
            : @tr("{n} match in {}" | "{n} matches in {}" % root.rows.length, root.board-name))
        : @tr("{n} item" | "{n} items" % root.rows.length);

    // Keeps the sidebar's cursor row in view. The row's place follows from the row heights, not from measuring
    // the element (a measurement taken before the first layout would scroll the sidebar away).
    property <length> nav-row-h: max(Space.hit, Type.line-base + Space.s2) + Space.s0-5;
    property <length> nav-head-h: (root.narrow ? Space.s2 : max(Space.hit, Type.line-xs + Space.s2)) + Space.s0-5;
    changed nav-cursor => {
        let y = Space.s1 + root.nav-cursor * root.nav-row-h + (root.nav-cursor >= 4 ? root.nav-head-h : 0px)
            + (root.nav-cursor >= 4 + root.n-lists ? root.nav-head-h : 0px);
        if (y + nav-flick.content-y < 0px) {
            nav-flick.content-y = -y;
        } else if (y + root.nav-row-h + nav-flick.content-y > nav-flick.height) {
            nav-flick.content-y = nav-flick.height - y - root.nav-row-h;
        }
    }

    // ---- Tooltips for the icon-only toolbar buttons (500ms rest, instant between buttons) -----------
    property <string> tip: root.toolbar-compact && (commands-button.has-hover || commands-button.has-focus) ? @tr("Commands (Ctrl+K)")
        : root.toolbar-compact && (view-button.has-hover || view-button.has-focus) ? @tr("View")
        : view-comfortable.has-hover || view-comfortable.has-focus ? @tr("Comfortable view")
        : view-compact.has-hover || view-compact.has-focus ? @tr("Compact view")
        : view-tile.has-hover || view-tile.has-focus ? @tr("Tile view") : root.card-tip;
    property <bool> toolbar-tip: (root.toolbar-compact && (commands-button.has-hover || commands-button.has-focus || view-button.has-hover || view-button.has-focus)) || view-comfortable.has-hover || view-comfortable.has-focus
        || view-compact.has-hover || view-compact.has-focus || view-tile.has-hover || view-tile.has-focus;
    property <length> tip-x: root.toolbar-compact && (commands-button.has-hover || commands-button.has-focus) ? commands-button.absolute-position.x
        : root.toolbar-compact && (view-button.has-hover || view-button.has-focus) ? view-button.absolute-position.x
        : view-comfortable.has-hover || view-comfortable.has-focus ? view-comfortable.absolute-position.x
        : view-compact.has-hover || view-compact.has-focus ? view-compact.absolute-position.x
        : view-tile.has-hover || view-tile.has-focus ? view-tile.absolute-position.x : root.card-tip-cx;
    // A row action's tooltip (Use, Copy, Edit, More): the card reports it, centred under the button.
    property <string> card-tip;
    property <length> card-tip-cx;
    property <length> card-tip-bottom;
    function card-tip-set(text: string, cx: length, bottom: length, on: bool) {
        if (on) {
            root.card-tip = text;
            root.card-tip-cx = cx;
            root.card-tip-bottom = bottom;
        } else if (text == root.card-tip) {
            root.card-tip = "";
        }
    }
    property <length> list-scroll: list.content-y;
    changed rows => { root.card-tip = ""; }
    changed list-scroll => { root.card-tip = ""; }
    property <bool> tip-open: false;
    changed tip => {
        if (root.tip == "") {
            root.tip-open = false;
            tip-timer.running = false;
        } else if (!root.tip-open) {
            tip-timer.running = true;
        }
    }
    tip-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.tip-open = root.tip != "";
        }
    }
    if root.tip != "": Tooltip {
        text: root.tip;
        open: root.tip-open;
        x: root.toolbar-tip ? min(root.tip-x, root.width - self.preferred-width - Space.s2)
            : min(max(Space.s2, root.tip-x - self.width / 2), root.width - self.width - Space.s2);
        y: root.toolbar-tip ? root.bar-h - Space.s1 : root.card-tip-bottom + Space.s1;
        width: self.preferred-width;
        height: self.preferred-height;
    }

    // ---- Overlays: a scrim that dismisses on click, then the menu --------------------------------
    if root.board-menu-open: TouchArea {
        clicked => { root.board-menu-dismissed(); }
    }
    suggest := SuggestDropdown {
        x: search.absolute-position.x;
        y: search.absolute-position.y + search.box-height + Space.s0-5;
        width: search.width;
        label: @tr("Search suggestions");
        rows: root.suggestions;
        active: search.has-focus && root.query != "" && root.suggest-query == root.query;
        chosen(i) => { root.suggest-chosen(i); }
        dismissed => { root.suggest-dismissed(); }
    }

    if root.board-menu-open: Menu {
        x: Space.s2;
        y: root.bar-h - Space.s1;
        entries: root.board-menu-entries;
        label: @tr("Boards");
        icons: false;
        init => { self.focus-menu(); }
        activated(i) => { root.board-menu-activated(i); }
        dismissed => { root.board-menu-dismissed(); }
    }

    if root.item-menu-open || root.nav-menu-open || root.help-menu-open || root.view-menu-open || root.sort-menu-open || root.chooser-open || root.recent-menu-open || root.recent-save-open: TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.close-menus();
            }
        }
    }
    if root.recent-menu-open: Menu {
        x: max(0px, min(root.recent-menu-x, root.width - self.width - Space.s2));
        y: max(0px, min(root.recent-menu-y, root.height - self.height - Space.s2));
        entries: [
            { text: @tr("Save to…"), icon: Icons.folder },
            { text: @tr("Copy"), icon: Icons.copy },
            { text: @tr("Remove from Recent"), icon: Icons.trash, destructive: true },
        ];
        label: @tr("Recent entry actions");
        init => { self.focus-menu(); }
        activated(i) => {
            root.recent-menu-open = false;
            if (i == 0) {
                root.recent-save-open = true;
            } else if (i == 1) {
                root.recent-copied(root.recent-menu-id);
                root.restore-focus();
            } else {
                root.recent-deleted(root.recent-menu-id);
                root.restore-focus();
            }
        }
        dismissed => { root.close-menus(); }
    }
    if root.recent-save-open: Chooser {
        x: max(0px, min(root.recent-menu-x, root.width - self.width - Space.s2));
        y: max(0px, min(root.recent-menu-y, root.height - self.height - Space.s2));
        width: min(240px, root.width - 2 * Space.s2);
        entries: root.recent-targets;
        label: @tr("Save to…");
        empty-text: @tr("No lists yet");
        init => {
            self.current = 0;
            self.focus-chooser();
        }
        chosen(i) => {
            root.recent-save-open = false;
            root.recent-saved(root.recent-menu-id, i);
            root.restore-focus();
        }
        dismissed => { root.close-menus(); }
    }
    if root.item-menu-open: Menu {
        x: max(0px, min(root.item-menu-x, root.width - self.width - Space.s2));
        y: max(0px, min(root.item-menu-y, root.height - self.height - Space.s2));
        entries: root.rows[root.item-menu-index].is-header ? root.group-entries : root.item-entries;
        label: @tr("Item actions");
        init => {
            self.current = 0;
            self.focus-menu();
        }
        activated(i) => { root.item-menu-activated(i); }
        dismissed => { root.close-menus(); }
    }
    if root.nav-menu-open: Menu {
        x: max(0px, min(root.nav-menu-x, root.width - self.width - Space.s2));
        y: max(0px, min(root.nav-menu-y, root.height - self.height - Space.s2));
        entries: root.nav-entries;
        label: @tr("Actions");
        init => {
            self.current = 0;
            self.focus-menu();
        }
        activated(i) => { root.nav-menu-activated(i); }
        dismissed => { root.close-menus(); }
    }
    if root.help-menu-open: Menu {
        x: Space.s2;
        y: max(0px, root.height - root.bar-h - self.height);
        entries: [
            { text: @tr("Troubleshoot…") },
            { text: @tr("User guide"), shortcut: "F1" },
            { text: @tr("About Snipdeck") },
            { text: @tr("Show Panel"), shortcut: root.panel-hotkey },
            { text: @tr("Keyboard shortcuts"), shortcut: "Ctrl+/" },
        ];
        label: @tr("Help");
        icons: false;
        init => {
            self.current = 0;
            self.focus-menu();
        }
        activated(i) => {
            root.close-menus();
            // The row order is the `entries` list above.
            if (i == 0) {
                root.help-requested(HelpPage.troubleshoot);
            } else if (i == 1) {
                root.help-requested(HelpPage.guide);
            } else if (i == 2) {
                root.help-requested(HelpPage.about);
            } else if (i == 3) {
                root.panel-requested();
            } else {
                root.help-requested(HelpPage.shortcuts);
            }
        }
        dismissed => { root.close-menus(); }
    }
    if root.view-menu-open: Menu {
        x: max(0px, min(view-button.absolute-position.x, root.width - self.width - Space.s2));
        y: root.bar-h - Space.s1;
        entries: [
            { text: @tr("Theme: System"), icon: root.theme-index == 0 ? Icons.check : root.no-icon },
            { text: @tr("Theme: Light"), icon: root.theme-index == 1 ? Icons.check : root.no-icon },
            { text: @tr("Theme: Dark"), icon: root.theme-index == 2 ? Icons.check : root.no-icon },
            { separator: true },
            { text: @tr("Main list density: Comfortable"), icon: root.view == MainView.comfortable ? Icons.check : root.no-icon },
            { text: @tr("Main list density: Compact"), icon: root.view == MainView.compact ? Icons.check : root.no-icon },
        ];
        label: @tr("View");
        init => {
            self.current = root.theme-index;
            self.focus-menu();
        }
        activated(i) => {
            root.close-menus();
            // The row order is the `entries` list above (the separator is row 3). A density row
            // is the same choice as the row-style buttons in the toolbar.
            if (i < 3) {
                root.theme-chosen(i);
            } else if (i == 4) {
                root.view = MainView.comfortable;
                root.view-changed(MainView.comfortable);
            } else if (i == 5) {
                root.view = MainView.compact;
                root.view-changed(MainView.compact);
            }
        }
        dismissed => { root.close-menus(); }
    }
    if root.sort-menu-open: Menu {
        x: max(0px, min(root.sort-menu-x, root.width - self.width - Space.s2));
        y: root.sort-menu-y;
        entries: [
            { text: @tr("Manual"), icon: root.list-sort == 0 ? Icons.check : root.no-icon },
            { text: @tr("Most used"), icon: root.list-sort == 1 ? Icons.check : root.no-icon },
            { text: @tr("Recently used"), icon: root.list-sort == 2 ? Icons.check : root.no-icon },
        ];
        label: @tr("Sort by");
        init => {
            self.current = root.list-sort;
            self.focus-menu();
        }
        activated(i) => {
            root.close-menus();
            root.sort-chosen(i);
        }
        dismissed => { root.close-menus(); }
    }
    if root.chooser-open: Chooser {
        x: root.chooser-x;
        y: root.chooser-y;
        width: 240px * SystemLook.text-scale;
        multi: root.chooser-tags;
        entries: root.chooser-paste ? root.paste-choices : root.chooser-tags ? root.tag-choices : root.lists;
        label: root.chooser-paste ? MenuTexts.item-paste-as() : root.chooser-tags ? @tr("Tags") : @tr("Move to list");
        empty-text: root.chooser-tags ? @tr("No tags yet") : @tr("No lists yet");
        init => {
            self.current = 0;
            self.focus-chooser();
        }
        chosen(i) => {
            if (root.chooser-paste) {
                root.chooser-open = false;
                root.paste-as-chosen(i);
                items-scope.focus();
            } else if (root.chooser-tags) {
                root.tag-toggled(i, !root.tag-choices[i].checked);
            } else {
                root.chooser-open = false;
                root.move-chosen(i);
                items-scope.focus();
            }
        }
        dismissed => { root.close-menus(); }
    }

    if root.palette-open: CommandPalette {
        width: root.width;
        height: root.height;
        rows: root.palette-rows;
        title: CommandTexts.palette-title;
        placeholder: CommandTexts.palette-placeholder;
        init => { self.focus-field(); }
        query-changed(text) => { root.palette-query-changed(text); }
        chosen(id) => {
            root.palette-open = false;
            root.restore-focus();
            root.command-requested(id);
        }
        dismissed => {
            root.palette-open = false;
            root.restore-focus();
        }
    }

    // The board delete confirmation, the only thing "Delete board…" shows.
    Dialog {
        title: @tr("Delete board “{}”?", root.board-name);
        body: @tr("Its lists and {} items move to the Trash. You can restore them for {} days.", root.board-delete-count, root.trash-days);
        variant: DialogVariant.destructive;
        open: root.board-delete-open;
        dismissed => { root.board-delete-dismissed(); }
        closed => { root.restore-focus(); }
        Button {
            text: @tr("Cancel");
            clicked => { root.board-delete-dismissed(); }
        }
        Button {
            variant: ButtonVariant.danger;
            text: @tr("Delete board");
            clicked => { root.board-delete-confirmed(); }
        }
    }

    // Last, so it sits on top and traps the pointer.
    confirm := Dialog {
        title: root.confirm-title;
        body: root.confirm-body;
        variant: DialogVariant.destructive;
        open: root.confirm-shown;
        dismissed => { root.confirm-shown = false; }
        closed => {
            root.confirm-kind = 0;
            root.restore-focus();
        }
        Button {
            text: @tr("Cancel");
            clicked => { root.confirm-shown = false; }
        }
        Button {
            variant: ButtonVariant.danger;
            text: root.confirm-ok;
            clicked => { root.confirmed(); }
        }
    }
}
