// The sentences of the Settings import preview: why an import cannot go ahead, and the "Will not be imported" list.
// The warnings are built from the importers' reports in Rust, which cannot reach the translation catalogs, so the app calls
// these functions (`snipdeck_app::wording::import_warning_text`) and gets the sentence in the
// language selected for the UI. One function per warning; the file or item is an argument.
export global ImportTexts {
    // The name the importers give an entry that has no title of its own (the n-th clip).
    pure public function clip-name(number: int) -> string {
        return @tr("Clip {}", number);
    }
    pure public function newer-minor-version(found: string) -> string {
        return @tr("This file was made by a newer Snipdeck (format {}), so anything this version does not know was left out.", found);
    }
    pure public function unknown-entries(count: int) -> string {
        return @tr("{} file in this archive is not known to this version and was left out." | "{} files in this archive are not known to this version and were left out." % count, count);
    }
    pure public function unreferenced-assets(count: int) -> string {
        return @tr("{} picture or file that no snippet uses was left out." | "{} pictures or files that no snippet uses were left out." % count, count);
    }
    pure public function sensitive-need-key(count: int) -> string {
        return @tr("{} sensitive item is encrypted with a key this library does not have and was skipped." | "{} sensitive items are encrypted with a key this library does not have and were skipped." % count, count);
    }
    pure public function cannot-decrypt(title: string) -> string {
        return @tr("The sensitive item \"{}\" cannot be unlocked with this computer's key and was skipped.", title);
    }
    pure public function sensitive-omitted-by-export(count: int) -> string {
        return @tr("{} sensitive item was left out when this file was made." | "{} sensitive items were left out when this file was made." % count, count);
    }
    pure public function board-limit(total: int, limit: int) -> string {
        return @tr("You would have {} boards, and the Free plan includes {}.", total, limit);
    }
    pure public function lossy-text(name: string) -> string {
        return @tr("{} is not valid UTF-8, so characters that could not be read were replaced.", name);
    }
    pure public function too-large(name: string, size: string) -> string {
        return @tr("{} is {}, over the 5 MB limit for text, and was skipped.", name, size);
    }
    pure public function empty(name: string) -> string {
        return @tr("{} is empty and was skipped.", name);
    }
    pure public function unreadable(name: string) -> string {
        return @tr("{} could not be read and was skipped.", name);
    }
    pure public function symlink-skipped(name: string) -> string {
        return @tr("{} is a link to somewhere else and was not followed.", name);
    }
    pure public function non-text-skipped(count: int) -> string {
        return @tr("{} item that is not text (a picture or file) was skipped." | "{} items that are not text (pictures or files) were skipped." % count, count);
    }
    pure public function truncated() -> string {
        return @tr("The import stopped early because the source is bigger than Snipdeck reads in one go.");
    }

    // What an importer changed or left out of one snippet or file (`Note` in snipdeck-portable). `label` is the
    // snippet or file the note is about; `tokens` and `triggers` are the source's own text, listed as written.
    pure public function note-unmapped-variables(label: string, tokens: string) -> string {
        return @tr("{}: {} has no Snipdeck equivalent and was left as written.", label, tokens);
    }
    pure public function note-unmapped-espanso-variables(label: string, tokens: string) -> string {
        return @tr("{}: {} (a shell, script or random variable, or one Snipdeck does not know) has no Snipdeck equivalent and was left as written.", label, tokens);
    }
    pure public function note-variables-do-not-fit(label: string) -> string {
        return @tr("{}: its variables cannot be one Snipdeck template together (for example two cursor marks), so it was kept as plain text.", label);
    }
    pure public function note-trigger-only-one(label: string, triggers: string) -> string {
        return @tr("{}: {} was not kept as a trigger, because a snippet has one trigger.", label, triggers);
    }
    pure public function note-trigger-needs-separator(label: string, triggers: string) -> string {
        return @tr("{}: {} was not kept as a trigger, because it fires after a separator and a Snipdeck trigger does not wait for one.", label, triggers);
    }
    pure public function note-trigger-bad-shape(label: string, triggers: string) -> string {
        return @tr("{}: {} was not kept as a trigger, because a trigger has no spaces and at most 32 characters.", label, triggers);
    }
    pure public function note-disabled-file(name: string) -> string {
        return @tr("{} is turned off in Espanso (its name starts with an underscore) and was skipped.", name);
    }
    pure public function note-not-a-match(what: string) -> string {
        return @tr("{}: this entry is not a match and was skipped.", what);
    }
    pure public function note-regex-trigger-only(what: string) -> string {
        return @tr("{}: its only trigger is a regular expression, which Snipdeck cannot use, so it was skipped.", what);
    }
    pure public function note-no-trigger(what: string) -> string {
        return @tr("{}: it has no trigger and was skipped.", what);
    }
    pure public function note-markup-kept(what: string) -> string {
        return @tr("{}: its Markdown or HTML text is kept as written.", what);
    }
    pure public function note-no-text(what: string) -> string {
        return @tr("{}: it has no text (a picture or other content) and was skipped.", what);
    }
    pure public function note-date-format(what: string, format: string) -> string {
        return @tr("{}: Snipdeck does not know the date format {}, so it was left as written.", what, format);
    }
    pure public function note-form-field(what: string, name: string) -> string {
        return @tr("{}: the form field {} has no Snipdeck equivalent and was left as written.", what, name);
    }
    pure public function note-columns-cut(file: string) -> string {
        return @tr("{}: some rows have more than 256 columns, and the extra columns were ignored.", file);
    }
    pure public function note-trigger-taken(title: string, trigger: string) -> string {
        return @tr("{}: the trigger {} is already used by another snippet, so it was imported without it.", title, trigger);
    }
    pure public function note-trigger-overlap(title: string, trigger: string, others: string) -> string {
        return @tr("{}: the trigger {} and {} start alike, so the shorter one fires first.", title, trigger, others);
    }
    pure public function note-title-cut(count: int, title: int, source: int) -> string {
        return @tr("{} item had a title or source app longer than {} or {} characters, and it was cut." | "{} items had a title or source app longer than {} or {} characters, and it was cut." % count, count, title, source);
    }

    // Why an import could not be previewed. Shown in place of the counts.
    pure public function problem-unreadable() -> string {
        return @tr("Snipdeck couldn't open that. Check that it still exists.");
    }
    pure public function problem-not-snipdeck() -> string {
        return @tr("That isn't a Snipdeck file, or it is damaged.");
    }
    pure public function problem-not-ditto() -> string {
        return @tr("That isn't a Ditto database.");
    }
    pure public function problem-not-copyq() -> string {
        return @tr("That isn't a CopyQ export.");
    }
    pure public function problem-not-folder() -> string {
        return @tr("Snipdeck couldn't read that folder.");
    }
    pure public function problem-not-espanso() -> string {
        return @tr("That isn't an Espanso configuration.");
    }
    pure public function problem-not-beeftext() -> string {
        return @tr("That isn't a Beeftext export.");
    }
    pure public function problem-not-textexpander() -> string {
        return @tr("That isn't a TextExpander CSV export.");
    }
    pure public function problem-not-phraseexpress() -> string {
        return @tr("That isn't a PhraseExpress CSV export.");
    }
    pure public function problem-too-new() -> string {
        return @tr("That file is from a newer Snipdeck. Update Snipdeck to import it.");
    }
    pure public function problem-failed() -> string {
        return @tr("Couldn't import that.");
    }
    pure public function problem-history-off() -> string {
        return @tr("Windows clipboard history is turned off. Turn it on in Windows Settings > System > Clipboard, copy some text, then try again.");
    }
    pure public function problem-history-unavailable() -> string {
        return @tr("Windows did not let Snipdeck read the clipboard history on this PC.");
    }
    pure public function problem-history-empty() -> string {
        return @tr("The Windows clipboard history has no text in it yet. Copy some text, then try again.");
    }
    // The name of the clipboard-history source: the import preview's heading and its choice.
    pure public function history-name() -> string {
        return @tr("Windows clipboard history");
    }
}
