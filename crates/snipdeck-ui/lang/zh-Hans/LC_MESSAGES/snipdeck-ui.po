msgid "(new ID)"
msgstr "(新ID)"

msgid "+{} more"
msgstr "另有 {} 项"

msgid ".snipdeck file"
msgstr ".snipdeck 文件"

msgid "100 %"
msgstr "100%"

msgid "125 %"
msgstr "125%"

msgid "150 %"
msgstr "150%"

msgid "175 %"
msgstr "175%"

msgid "A PNG picture. Snipdeck keeps its own copy."
msgstr "PNG 图片。Snipdeck 会保存自己的副本。"

msgid "A Panel that a shortcut or the tray showed hides after a paste or copy. A pinned Panel stays, and a docked one folds back to its edge."
msgstr "通过快捷键或托盘显示的面板会在粘贴或复制后隐藏。已置顶的面板会保持显示，已停靠的面板会收回到边缘。"

msgid "A Supporter feature. Adds a password on top of Windows' own protection for your sensitive items. Asked for when you first use a sensitive item and again after {} minutes without use."
msgstr "Supporter 功能。在 Windows 自身保护之上，为你的敏感片段添加密码。首次使用敏感片段时要求输入，此后若 {} 分钟未使用，再次使用时也会要求输入。"

msgid "A docked Panel opens at its edge. Set Dock to Floating to choose where it opens."
msgstr "已停靠的面板会在其边缘打开。将“停靠到”设为“浮动”，即可选择它的打开位置。"

msgid "A link can't contain spaces or line breaks."
msgstr "链接不能包含空格或换行。"

msgid "A link needs a scheme such as https://"
msgstr "链接需要包含协议，例如 https://"

msgid "A master password is on and your sensitive items are locked."
msgstr "已开启主密码，敏感片段已锁定。"

msgid "A master password is on. Snipdeck asks for it when you first use a sensitive item and again after {} minutes without use."
msgstr "已开启主密码。首次使用敏感片段时，Snipdeck 会要求输入，此后若 {} 分钟未使用，再次使用时也会要求输入。"

msgid "A master password is part of Supporter."
msgstr "主密码是 Supporter 的功能之一。"

msgid "A master password locks the whole deck."
msgstr "主密码可以锁定整个卡组。"

msgid "A new random ID each time"
msgstr "每次生成新的随机ID"

msgid "A one-character trigger fires every time you type it, even inside words. Two or more characters are safer."
msgstr "单个字符的触发词每次输入都会触发，连单词中间也不例外。使用两个或更多字符更安全。"

msgid "A small window you can drag anywhere."
msgstr "可以拖到任意位置的小窗口。"

msgid "A smiley tab next to Recent with emoji, kaomoji and icons to paste. Turn it off to hide the tab and its Ctrl+K command."
msgstr "“最近”旁边的笑脸标签页，提供可粘贴的表情符号、颜文字和图标。关闭后将隐藏该标签页及其 Ctrl+K 命令。"

msgid "A strip of your snippets beside the app you are working in. Click one to paste it there."
msgstr "在你正在使用的应用旁边显示的片段栏。点击其中一条，即可粘贴到该应用。"

msgid "A tag with that name already exists."
msgstr "已存在同名标签。"

msgid "A tick box; the text inside is pasted only when ticked"
msgstr "一个复选框；仅在勾选时才粘贴其中的文本"

msgid "A title can have at most {} characters."
msgstr "标题最多 {} 个字符。"

msgid "A title can't contain line breaks or control characters."
msgstr "标题不能包含换行或控制字符。"

msgid "A trigger is 1 to 32 characters with no spaces."
msgstr "触发词为 1 到 32 个字符，不含空格。"

msgid "About"
msgstr "关于"

msgid "About Snipdeck"
msgstr "关于 Snipdeck"

msgid "Above"
msgstr "上方"

msgid "Accent colour"
msgstr "强调色"

msgid "Actions"
msgstr "操作"

msgid "Activate"
msgstr "激活"

msgid "Activities"
msgstr "活动"

msgid "Add"
msgstr "添加"

msgid "Add a snippet, or move items here from another list."
msgstr "添加片段，或从其他列表移动到这里。"

msgid "Add a snippet… (Enter to save)"
msgstr "添加片段…(按 Enter 保存)"

msgid "Add list"
msgstr "添加列表"

msgid "Add some text, or cancel."
msgstr "添加一些文本，或取消。"

msgid "Add to list"
msgstr "添加到列表"

msgid "Add to paste stack"
msgstr "添加到粘贴堆栈"

msgid "Add to “{}”"
msgstr "添加到“{}”"

msgid "Add {} or {} to a snippet."
msgstr "在片段中加入 {} 或 {}。"

msgid "Added to {}"
msgstr "已添加到 {}"

msgid "Added to {}. Some were skipped: folders, and files that are empty, too large or unreadable."
msgstr "已添加到 {}。部分内容已跳过：文件夹，以及为空、太大或无法读取的文件。"

msgid "Adds a password on top of Windows' own protection for your sensitive items. Asked for when you first use a sensitive item and again after {} minutes without use."
msgstr "在 Windows 自身保护之上，为你的敏感片段添加密码。首次使用敏感片段时要求输入，此后若 {} 分钟未使用，再次使用时也会要求输入。"

msgid "Adds a text snippet to {}"
msgstr "向 {} 添加文本片段"

msgid "After a paste or copy"
msgstr "粘贴或复制后"

msgid "After you type the start of a trigger, a small hint at the text cursor offers the snippet. Press Tab to insert it; any other key carries on as usual."
msgstr "输入触发词的开头后，文本光标处会出现一个小提示，推荐对应的片段。按 Tab 键插入；按其他任何键则照常输入。"

msgid "All"
msgstr "全部"

msgid "All commands…"
msgstr "所有命令…"

msgid "All items"
msgstr "所有片段"

msgid "All {n} item moves to the Trash. You can restore it for {} days."
msgid_plural "All {n} items move to the Trash. You can restore them for {} days."
msgstr[0] "{n} 个项目将移入回收站。{} 天内可以恢复。"

msgid "All {} recent copies are removed. This can't be undone."
msgstr "将删除全部 {} 条最近复制的内容。此操作无法撤销。"

msgid "Also forget the encryption key"
msgstr "同时忘记加密密钥"

msgid "Also keep what I copy?"
msgstr "同时保留我复制的内容？"

msgid "Alt 1 to 9"
msgstr "Alt 1 到 9"

msgid "Alt+{}"
msgstr "Alt+{}"

msgid "Always shown"
msgstr "始终显示"

msgid "Amber"
msgstr "琥珀色"

msgid "An Image item holds a PNG picture. Choose a PNG file, or add this one as a File."
msgstr "图片片段保存的是 PNG 图片。请选择 PNG 文件，或将此文件添加为“文件”片段。"

msgid "An item is open in the editor, so the pasted text was not added. Close it, then paste again."
msgstr "编辑器中已打开一个项目，所以粘贴的文本没有添加。请先关闭它，再重新粘贴。"

msgid "Angry"
msgstr "生气"

msgid "Animals"
msgstr "动物"

msgid "Animals & Nature"
msgstr "动物与自然"

msgid "Another program already uses {}."
msgstr "其他程序已在使用 {}。"

msgid "Another snippet already uses this trigger."
msgstr "另一个片段已使用此触发词。"

msgid "Anywhere in Windows"
msgstr "Windows 中的任何位置"

msgid "Appearance"
msgstr "外观"

msgid "Appears when you type"
msgstr "输入时出现"

msgid "Apply the new name"
msgstr "应用新名称"

msgid "As many as you like, of every kind."
msgstr "每种类型均可添加任意数量。"

msgid "Asks for a date, today if left empty"
msgstr "询问日期，留空则为今天"

msgid "Asks for a value each time"
msgstr "每次都询问值"

msgid "Asks for text over several lines"
msgstr "询问多行文本"

msgid "Asks you to pick one of the options"
msgstr "让你从选项中选择一项"

msgid "At least {} characters. A few unrelated words make a good password."
msgstr "至少 {} 个字符。几个无关的单词组合起来是个不错的密码。"

msgid "At the mouse"
msgstr "鼠标位置"

msgid "At the text cursor"
msgstr "文本光标处"

msgid "Back"
msgstr "上一步"

msgid "Back up now"
msgstr "立即备份"

msgid "Backed up"
msgstr "已备份"

msgid "Backup of {}, {}"
msgstr "{} 的备份（{}）"

msgid "Backups and your data"
msgstr "备份与你的数据"

msgid "Backups to keep"
msgstr "保留的备份数"

msgid "Backups, export, light and dark, 7 languages"
msgstr "备份、导出、浅色和深色主题、7 种语言"

msgid "Beeftext export"
msgstr "Beeftext 导出文件"

msgid "Below"
msgstr "下方"

msgid "Blue"
msgstr "蓝色"

msgid "Board name"
msgstr "看板名称"

msgid "Board saved"
msgstr "看板已保存"

msgid "Board: {}"
msgstr "看板：{}"

msgid "Board: {}, list: {}"
msgstr "看板：{}，列表：{}"

msgid "Boards"
msgstr "看板"

msgid "Boards and lists"
msgstr "看板和列表"

msgid "Bottom edge"
msgstr "底边"

msgid "Bring in items from a Snipdeck file or another clipboard manager. You see what will be added before anything is written."
msgstr "从 Snipdeck 文件或其他剪贴板管理器导入片段。写入前可先查看将要添加的内容。"

msgid "Bring up the panel, open the picker, save the clipboard or paste the next item from any app."
msgstr "在任何应用中，都可以呼出面板、打开选择器、保存剪贴板内容或粘贴下一项。"

msgid "Brings the panel up beside the app you are working in."
msgstr "在你正在使用的应用旁边显示面板。"

msgid "Browse for a file"
msgstr "浏览文件"

msgid "Browse…"
msgstr "浏览…"

msgid "Built on"
msgstr "构建日期"

msgid "Cancel"
msgstr "取消"

msgid "Cancel the test of {}"
msgstr "取消 {} 的测试"

msgid "Captured items keep their kind."
msgstr "捕获的片段保留其类型。"

msgid "Cards"
msgstr "卡片"

msgid "Change master password"
msgstr "更改主密码"

msgid "Change password"
msgstr "更改密码"

msgid "Change these in Settings."
msgstr "请在设置中更改。"

msgid "Changes apply at once."
msgstr "更改立即生效。"

msgid "Change…"
msgstr "更改…"

msgid "Check again"
msgstr "重新检查"

msgid "Check for updates"
msgstr "检查更新"

msgid "Checks"
msgstr "检查项"

msgid "Choose a file, or cancel."
msgstr "请选择文件，或取消。"

msgid "Choose comfortable rows, compact rows or tiles."
msgstr "可选择舒适行、紧凑行或磁贴。"

msgid "Choose one to add it where the cursor is. It is filled in when you use the item."
msgstr "选择一项，将其添加到光标所在位置。使用该片段时会填入内容。"

msgid "Choose tags"
msgstr "选择标签"

msgid "Choose what to import"
msgstr "选择要导入的内容"

msgid "Clear"
msgstr "清除"

msgid "Clear filter"
msgstr "清除筛选"

msgid "Clear history"
msgstr "清除历史"

msgid "Clear list"
msgstr "清空列表"

msgid "Clear list “{}”?"
msgstr "清空列表“{}”？"

msgid "Clear list…"
msgstr "清空列表…"

msgid "Clear recent history"
msgstr "清除最近记录"

msgid "Clear recent history?"
msgstr "要清除最近的历史记录吗？"

msgid "Clear search"
msgstr "清除搜索"

msgid "Clear selection"
msgstr "清除选择"

msgid "Clear the clipboard after copying a sensitive item"
msgstr "复制敏感片段后清除剪贴板"

msgid "Clear the clipboard later"
msgstr "稍后清除剪贴板"

msgid "Clear the clipboard sooner"
msgstr "尽快清除剪贴板"

msgid "Clear the search"
msgstr "清除搜索"

msgid "Clear the search, then close"
msgstr "先清除搜索，然后关闭"

msgid "Clear the shortcut for {}"
msgstr "清除 {} 的快捷键"

msgid "Click"
msgstr "点击"

msgid "Click copies"
msgstr "点击为复制"

msgid "Click or Enter pastes. Shift+click or Shift+Enter copies."
msgstr "点击或按 Enter 粘贴。Shift+点击或 Shift+Enter 为复制。"

msgid "Click pastes into {} · Shift+click copies"
msgstr "点击粘贴到 {} · Shift+点击为复制"

msgid "Click to copy."
msgstr "点击复制。"

msgid "Click to paste into {}. Shift+click copies."
msgstr "点击粘贴到 {}。Shift+点击为复制。"

msgid "Clip {}"
msgstr "剪贴 {}"

msgid "Clipboard clear time"
msgstr "剪贴板清除时间"

msgid "Close"
msgstr "关闭"

msgid "Close panel (Esc)"
msgstr "关闭面板 (Esc)"

msgid "Close search"
msgstr "关闭搜索"

msgid "Close the tag list"
msgstr "关闭标签列表"

msgid "Close the window"
msgstr "关闭窗口"

msgid "Code"
msgstr "代码"

msgid "Collapse sidebar (Ctrl+B)"
msgstr "折叠侧边栏 (Ctrl+B)"

msgid "Colour"
msgstr "颜色"

msgid "Colour label"
msgstr "颜色标签"

msgid "Comfortable"
msgstr "舒适"

msgid "Comfortable view"
msgstr "舒适视图"

msgid "Command palette (every action)"
msgstr "命令面板（所有操作）"

msgid "Commands"
msgstr "命令"

msgid "Commands (Ctrl+K)"
msgstr "命令（Ctrl+K）"

msgid "Commands in the Main window"
msgstr "主窗口中的命令"

msgid "Compact"
msgstr "紧凑"

msgid "Compact view"
msgstr "紧凑视图"

msgid "Content"
msgstr "内容"

msgid "Control Enter"
msgstr "Ctrl Enter"

msgid "Control N"
msgstr "Ctrl N"

msgid "Copied"
msgstr "已复制"

msgid "Copied. Nothing in {} can take text right now."
msgstr "已复制。{} 当前无法接收文本。"

msgid "Copied. Pasting into {} is turned off."
msgstr "已复制。已关闭粘贴到 {} 的功能。"

msgid "Copied. The window you were using went away."
msgstr "已复制。你正在使用的窗口已关闭。"

msgid "Copied. {} runs as administrator, so Snipdeck can't paste into it."
msgstr "已复制。{} 以管理员身份运行，Snipdeck 无法粘贴到其中。"

msgid "Copy"
msgstr "复制"

msgid "Copy PNG"
msgstr "复制 PNG"

msgid "Copy SVG"
msgstr "复制 SVG"

msgid "Copy all"
msgstr "全部复制"

msgid "Copy diagnostic report"
msgstr "复制诊断报告"

msgid "Copy selected item"
msgstr "复制所选片段"

msgid "Copy something, then save it from the Panel."
msgstr "先复制一些内容，然后在面板中保存。"

msgid "Copy something, then save it here."
msgstr "先复制一些内容，然后保存到这里。"

msgid "Copy the item"
msgstr "复制该片段"

msgid "Copy the result"
msgstr "复制结果"

msgid "CopyQ export"
msgstr "CopyQ 导出"

msgid "Couldn't change the Windows start-up entry."
msgstr "无法更改 Windows 开机启动项。"

msgid "Couldn't clear old items out of the Trash. Check the disk has room, then restart Snipdeck to try again."
msgstr "无法清除回收站中的旧项目。请检查磁盘空间，然后重启 Snipdeck 重试。"

msgid "Couldn't erase everything. Quit Snipdeck and try again."
msgstr "无法全部删除。请退出 Snipdeck 后重试。"

msgid "Couldn't export your library. Check the disk has room, then try again."
msgstr "无法导出你的资料库。请检查磁盘空间，然后重试。"

msgid "Couldn't export your library: it is locked. Unlock it, then try again."
msgstr "无法导出你的资料库：资料库已锁定。请先解锁，然后重试。"

msgid "Couldn't export your library: the disk is full. Free up some space, then try again."
msgstr "无法导出你的资料库：磁盘已满。请释放一些空间，然后重试。"

msgid "Couldn't export your library: the folder can't be written to. Check it isn't read-only or in use, then try again."
msgstr "无法导出你的资料库：无法写入该文件夹。请检查它是否为只读或正被占用，然后重试。"

msgid "Couldn't import that."
msgstr "无法导入该内容。"

msgid "Couldn't import that. Choose the file again, or try another one."
msgstr "无法导入。请重新选择文件，或换一个文件。"

msgid "Couldn't import that: it isn't a file Snipdeck can read, or it is damaged. Choose a .snipdeck export."
msgstr "无法导入：Snipdeck 无法读取该文件，或文件已损坏。请选择 .snipdeck 导出文件。"

msgid "Couldn't import that: it was made by a newer Snipdeck. Update Snipdeck, then try again."
msgstr "无法导入：该文件由更新版本的 Snipdeck 创建。请更新 Snipdeck，然后重试。"

msgid "Couldn't import that: the disk is full. Free up some space, then try again."
msgstr "无法导入：磁盘已满。请释放一些空间，然后重试。"

msgid "Couldn't import that: the file is in use by another program or can't be read. Close the program using it, then try again."
msgstr "无法导入：文件正被其他程序占用或无法读取。请关闭占用它的程序，然后重试。"

msgid "Couldn't import that: your library is locked. Unlock it, then try again."
msgstr "无法导入：你的资料库已锁定。请先解锁，然后重试。"

msgid "Couldn't make a backup. Check the disk has room, then use Back up now in Settings."
msgstr "无法创建备份。请检查磁盘空间，然后使用“设置”中的“立即备份”。"

msgid "Couldn't make a backup: the backup file is in use or can't be written. Close other programs using your Snipdeck folder, then use Back up now in Settings."
msgstr "无法创建备份：备份文件正被占用或无法写入。请关闭其他占用 Snipdeck 文件夹的程序，然后使用“设置”中的“立即备份”。"

msgid "Couldn't make a backup: the disk is full. Free up some space, then use Back up now in Settings."
msgstr "无法创建备份：磁盘已满。请释放一些空间，然后使用“设置”中的“立即备份”。"

msgid "Couldn't make a backup: your library is locked. Unlock it, then use Back up now in Settings."
msgstr "无法创建备份：你的资料库已锁定。请先解锁，然后使用“设置”中的“立即备份”。"

msgid "Couldn't make that change. Try again, or restart Snipdeck if it keeps happening."
msgstr "无法完成此更改。请重试；如果问题持续出现，请重启 Snipdeck。"

msgid "Couldn't make that change: the disk is full. Free up some space, then try again."
msgstr "无法完成此更改：磁盘已满。请释放一些空间，然后重试。"

msgid "Couldn't make that change: your library file is in use by another program. Close that program, then try again."
msgstr "无法完成此更改：你的资料库文件正被其他程序占用。请关闭该程序，然后重试。"

msgid "Couldn't make that change: your library is locked. Unlock it, then try again."
msgstr "无法完成此更改：你的资料库已锁定。请先解锁，然后重试。"

msgid "Couldn't make today's backup. Check the disk has room, then use Back up now in Settings."
msgstr "无法创建今天的备份。请检查磁盘空间，然后使用“设置”中的“立即备份”。"

msgid "Couldn't make today's backup: the backup file is in use or can't be written. Close other programs using your Snipdeck folder, then use Back up now in Settings."
msgstr "无法创建今天的备份：备份文件正被占用或无法写入。请关闭其他占用 Snipdeck 文件夹的程序，然后使用“设置”中的“立即备份”。"

msgid "Couldn't make today's backup: the disk is full. Free up some space, then use Back up now in Settings."
msgstr "无法创建今天的备份：磁盘已满。请释放一些空间，然后使用“设置”中的“立即备份”。"

msgid "Couldn't open that window."
msgstr "无法打开该窗口。"

msgid "Couldn't open the encryption key. Nothing was saved."
msgstr "无法打开加密密钥。未保存任何内容。"

msgid "Couldn't open the folder."
msgstr "无法打开文件夹。"

msgid "Couldn't open the log folder."
msgstr "无法打开日志文件夹。"

msgid "Couldn't open this item."
msgstr "无法打开此片段。"

msgid "Couldn't open your email app."
msgstr "无法打开你的邮件应用。"

msgid "Couldn't reach the clipboard. Another app may be using it."
msgstr "无法访问剪贴板。可能有其他应用正在使用它。"

msgid "Couldn't refresh the list on screen. Close and reopen the window to see the change."
msgstr "无法刷新屏幕上的列表。请关闭并重新打开窗口以查看更改。"

msgid "Couldn't rename the tag."
msgstr "无法重命名标签。"

msgid "Couldn't reopen your library. Restart Snipdeck. Your files have not been changed."
msgstr "无法重新打开你的库。请重启 Snipdeck。你的文件没有被改动。"

msgid "Couldn't restore that backup. Choose another backup, or try again."
msgstr "无法还原该备份。请选择其他备份，或重试。"

msgid "Couldn't restore that backup: a file is in use by another program. Close it, then try again."
msgstr "无法还原该备份：有文件正被其他程序占用。请关闭它，然后重试。"

msgid "Couldn't restore that backup: it isn't a Snipdeck backup, or it is damaged. Choose another backup."
msgstr "无法还原该备份：它不是 Snipdeck 备份，或已损坏。请选择其他备份。"

msgid "Couldn't restore that backup: it was made by a newer Snipdeck. Update Snipdeck, then try again."
msgstr "无法还原该备份：它由更新版本的 Snipdeck 创建。请更新 Snipdeck，然后重试。"

msgid "Couldn't restore that backup: the disk is full. Free up some space, then try again."
msgstr "无法还原该备份：磁盘已满。请释放一些空间，然后重试。"

msgid "Couldn't restore that backup: your library is locked. Unlock it, then try again."
msgstr "无法还原该备份：你的资料库已锁定。请先解锁，然后重试。"

msgid "Couldn't save a draft of what you typed."
msgstr "无法保存你输入内容的草稿。"

msgid "Couldn't save this item. Nothing was changed."
msgstr "无法保存此片段。未做任何更改。"

msgid "Couldn't save your settings. Snipdeck will try again."
msgstr "无法保存你的设置。Snipdeck 将再次尝试。"

msgid "Couldn't start the screenshot tool."
msgstr "无法启动截图工具。"

msgid "Couldn't use this item. Try again, or restart Snipdeck if it keeps happening."
