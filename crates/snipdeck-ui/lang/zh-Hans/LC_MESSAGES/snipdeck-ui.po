msgstr "无法导出你的资料库。"

msgid "Couldn't import that."
msgstr "无法导入该内容。"

msgid "Couldn't make a backup."
msgstr "无法创建备份。"

msgid "Couldn't open that window."
msgstr "无法打开该窗口。"

msgid "Couldn't open the encryption key. Nothing was saved."
msgstr "无法打开加密密钥。未保存任何内容。"

msgid "Couldn't open the folder."
msgstr "无法打开文件夹。"

msgid "Couldn't open the log folder."
msgstr "无法打开日志文件夹。"

