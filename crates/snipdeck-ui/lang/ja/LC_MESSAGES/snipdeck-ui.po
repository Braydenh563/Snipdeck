msgid ".snipdeck file"
msgstr ".snipdeck ファイル"

msgid "100 %"
msgstr "100%"

msgid "125 %"
msgstr "125%"

msgid "150 %"
msgstr "150%"

msgid "175 %"
msgstr "175%"

msgid "A PNG picture. Snipdeck keeps its own copy."
msgstr "PNG画像。Snipdeckが独自のコピーを保存します。"

msgid "A Supporter feature. Adds a password on top of Windows' own protection for your sensitive items. Asked for when you first use a sensitive item and again after {} minutes without use."
msgstr "Supporter の機能です。機密スニペットを Windows の保護に加えてパスワードで守ります。機密スニペットを初めて使うときと、{}分間使わなかった後に入力を求めます。"

msgid "A link can't contain spaces or line breaks."
msgstr "リンクに空白や改行を含めることはできません。"

msgid "A link needs a scheme such as https://"
msgstr "リンクには https:// のようなスキームが必要です"

msgid "A list keeps related snippets together, like replies or addresses."
msgstr "リストには、返信文や住所など関連するスニペットをまとめておけます。"

msgid "A master password is on and your sensitive items are locked."
msgstr "マスターパスワードが有効で、機密スニペットはロックされています。"

msgid "A master password is on. Snipdeck asks for it when you first use a sensitive item and again after {} minutes without use."
msgstr "マスターパスワードが有効です。機密スニペットを初めて使うときと、{}分間使わなかった後に Snipdeck が入力を求めます。"

msgid "A master password is part of Supporter."
msgstr "マスターパスワードは Supporter に含まれます。"

msgid "A strip of your snippets beside the app you are working in. Click one to paste it there."
msgstr "作業中のアプリの横に、スニペットを並べた帯が表示されます。クリックすると、そのアプリに貼り付けます。"

msgid "A tag with that name already exists."
msgstr "その名前のタグは既に存在します。"

msgid "A title can have at most {} characters."
msgstr "タイトルは最大 {} 文字までです。"

msgid "A title can't contain line breaks or control characters."
msgstr "タイトルに改行や制御文字を含めることはできません。"

msgid "About"
msgstr "バージョン情報"

msgid "About Snipdeck"
msgstr "Snipdeck について"

msgid "Above"
msgstr "上"

msgid "Accent colour"
msgstr "アクセントカラー"

msgid "Actions"
msgstr "操作"

msgid "Activate"
msgstr "有効にする"

msgid "Add"
msgstr "追加"

msgid "Add a snippet, or move items here from another list."
msgstr "ここにスニペットを追加するか、別のリストから移動します。"

msgid "Add a snippet… (Enter to save)"
msgstr "スニペットを追加… (Enterで保存)"

msgid "Add list"
msgstr "リストを追加"

msgid "Add some text, or cancel."
msgstr "テキストを追加するか、キャンセルしてください。"

msgid "Add to paste stack"
msgstr "貼り付けスタックに追加"

msgid "Adds a password on top of Windows' own protection for your sensitive items. Asked for when you first use a sensitive item and again after {} minutes without use."
msgstr "機密スニペットを Windows の保護に加えてパスワードで守ります。機密スニペットを初めて使うときと、{}分間使わなかった後に入力を求めます。"

msgid "All"
msgstr "すべて"

msgid "All commands…"
msgstr "すべてのコマンド…"

msgid "All items"
msgstr "すべてのスニペット"

msgid "All {} recent copies are removed. This can't be undone."
msgstr "{}件の最近のコピーを削除します。元に戻せません。"

msgid "Also forget the encryption key"
msgstr "暗号化キーも削除する"

msgid "Alt 1 to 9"
msgstr "Alt 1～9"

msgid "Alt+{}"
msgstr "Alt+{}"

msgid "Amber"
msgstr "アンバー"

msgid "An Image item holds a PNG picture. Choose a PNG file, or add this one as a File."
msgstr "画像のスニペットには PNG 画像が入ります。PNG ファイルを選ぶか、これをファイルとして追加してください。"

msgid "Another program already uses {}."
msgstr "別のプログラムが {} を既に使用しています。"

msgid "Anywhere in Windows"
msgstr "Windows のどこでも"

msgid "Appearance"
msgstr "外観"

msgid "Apply the new name"
msgstr "新しい名前を適用"

msgid "As many as you like, of every kind."
msgstr "すべての種類を、必要なだけ。"

msgid "Asks for a value each time"
msgstr "毎回値を尋ねる"

msgid "Asks you to pick one of the options"
msgstr "オプションから1つ選択を求めます"

msgid "At least {} characters. A few unrelated words make a good password."
msgstr "{}文字以上。関係のない単語をいくつか組み合わせると、良いパスワードになります。"

msgid "Back"
msgstr "戻る"

msgid "Back up now"
msgstr "今すぐバックアップ"

msgid "Backed up"
msgstr "バックアップ済み"

msgid "Backup of {}, {}"
msgstr "{} のバックアップ（{}）"

msgid "Backups and your data"
msgstr "バックアップとデータ"

msgid "Backups to keep"
msgstr "保持するバックアップ数"

msgid "Backups, export, light and dark, 7 languages"
msgstr "バックアップ、エクスポート、ライト／ダークテーマ、7言語"

msgid "Below"
msgstr "下"

msgid "Blue"
msgstr "青"

msgid "Board name"
msgstr "ボード名"

msgid "Board saved"
msgstr "ボードを保存しました"

msgid "Board: {}"
msgstr "ボード: {}"

msgid "Boards"
msgstr "ボード"

msgid "Bottom edge"
msgstr "下端"

msgid "Bring in items from a Snipdeck file or another clipboard manager. You see what will be added before anything is written."
msgstr "Snipdeck ファイルや別のクリップボード管理ツールからスニペットを取り込みます。書き込み前に、追加される内容を確認できます。"

msgid "Bring up the panel, open the picker, save the clipboard or paste the next item from any app."
msgstr "どのアプリからでも、パネルの表示、ピッカーの起動、クリップボードの保存、次の項目の貼り付けができます。"

msgid "Brings the panel up beside the app you are working in."
msgstr "作業中のアプリの横にパネルを表示します。"

msgid "Browse for a file"
msgstr "ファイルを参照"

msgid "Browse…"
msgstr "参照…"

msgid "Built on"
msgstr "ビルド日"

msgid "Cancel"
msgstr "キャンセル"

msgid "Captured items keep their kind."
msgstr "キャプチャしたスニペットは種類を保持します。"

msgid "Change master password"
msgstr "マスターパスワードを変更"

msgid "Change password"
msgstr "パスワードを変更"

msgid "Change these in Settings."
msgstr "これらは設定で変更できます。"

msgid "Changes apply at once."
msgstr "変更はすぐに適用されます。"

msgid "Change…"
msgstr "変更…"

msgid "Check again"
msgstr "もう一度確認"

msgid "Check for updates"
msgstr "更新を確認"

msgid "Checks"
msgstr "確認項目"

msgid "Choose a file, or cancel."
msgstr "ファイルを選ぶか、キャンセルしてください。"

msgid "Choose one to add it at the end of the text. It is filled in when you use the item."
msgstr "選んだものがテキストの末尾に追加されます。スニペットを使うときに値が入力されます。"

msgid "Choose tags"
msgstr "タグを選択"

msgid "Choose what to import"
msgstr "取り込む内容を選択"

msgid "Clear"
msgstr "クリア"

msgid "Clear filter"
msgstr "フィルターをクリア"

msgid "Clear history"
msgstr "履歴を消去"

msgid "Clear recent history"
msgstr "最近の履歴を消去"

msgid "Clear recent history?"
msgstr "最近の履歴を消去しますか？"

msgid "Clear search"
msgstr "検索をクリア"

msgid "Clear selection"
msgstr "選択を解除"

msgid "Clear the clipboard after copying a sensitive item"
msgstr "機密スニペットをコピーした後、クリップボードを消去"

msgid "Clear the clipboard later"
msgstr "クリップボードを消去するまでの時間を長くする"

msgid "Clear the clipboard sooner"
msgstr "クリップボードを消去するまでの時間を短くする"

msgid "Clear the search, then close"
msgstr "検索をクリアしてから閉じる"

msgid "Clear the shortcut for {}"
msgstr "{} のショートカットを消去"

msgid "Click"
msgstr "クリック"

msgid "Click to copy."
msgstr "クリックでコピー。"

msgid "Click to paste into {}. Shift+click copies."
msgstr "クリックで{}に貼り付け。Shift+クリックでコピー。"

msgid "Clip {}"
msgstr "クリップ {}"

msgid "Clipboard clear time"
msgstr "クリップボードの消去時間"

msgid "Clipboard history"
msgstr "クリップボード履歴"

msgid "Close"
msgstr "閉じる"

msgid "Close panel (Esc)"
msgstr "パネルを閉じる (Esc)"

msgid "Close the tag list"
msgstr "タグ一覧を閉じる"

msgid "Close the window"
msgstr "ウィンドウを閉じる"

msgid "Code"
msgstr "コード"

msgid "Colour"
msgstr "色"

msgid "Colour label"
msgstr "カラーラベル"

msgid "Comfortable"
msgstr "ゆったり"

msgid "Comfortable view"
msgstr "ゆったり表示"

msgid "Command palette (every action)"
msgstr "コマンドパレット（すべての操作）"

msgid "Commands"
msgstr "コマンド"

msgid "Commands (Ctrl+K)"
msgstr "コマンド (Ctrl+K)"

msgid "Commands in the Main window"
msgstr "メインウィンドウのコマンド"

msgid "Compact"
msgstr "コンパクト"

msgid "Compact view"
msgstr "コンパクト表示"

msgid "Content"
msgstr "内容"

msgid "Control Enter"
msgstr "Ctrl Enter"

msgid "Copied"
msgstr "コピーしました"

msgid "Copied. Nothing in {} can take text right now."
msgstr "コピーしました。{}は今テキストを受け付けられません。"

msgid "Copied. Pasting into {} is turned off."
msgstr "コピーしました。{}への貼り付けはオフになっています。"

msgid "Copied. The window you were using went away."
msgstr "コピーしました。使用中だったウィンドウは閉じられました。"

msgid "Copied. {} runs as administrator, so Snipdeck can't paste into it."
msgstr "コピーしました。{}は管理者として実行されているため、Snipdeck は貼り付けできません。"

msgid "Copies to clipboard"
msgstr "クリップボードにコピーされます"

msgid "Copy"
msgstr "コピー"

msgid "Copy all"
msgstr "すべてコピー"

msgid "Copy diagnostic report"
msgstr "診断レポートをコピー"

msgid "Copy selected item"
msgstr "選択したスニペットをコピー"

msgid "Copy something, then save it from the Panel."
msgstr "何かをコピーしてから、パネルで保存できます。"

msgid "Copy something, then save it here from the clipboard."
msgstr "何かをコピーしてから、クリップボードからここに保存できます。"

msgid "Copy the item"
msgstr "スニペットをコピー"

msgid "Copy the result"
msgstr "結果をコピー"

msgid "Copy without pasting"
msgstr "貼り付けずにコピー"

msgid "CopyQ export"
msgstr "CopyQ エクスポート"

msgid "Couldn't change the Windows start-up entry."
msgstr "Windows のスタートアップ項目を変更できませんでした。"

msgid "Couldn't clear old items out of the Trash. Check the disk has room, then restart Snipdeck to try again."
msgstr "ゴミ箱の古い項目を削除できませんでした。ディスクの空き容量を確認し、Snipdeck を再起動してもう一度お試しください。"

msgid "Couldn't erase everything. Quit Snipdeck and try again."
msgstr "すべて削除できませんでした。Snipdeck を終了してから、もう一度お試しください。"

msgid "Couldn't export your library. Check the disk has room, then try again."
msgstr "ライブラリをエクスポートできませんでした。ディスクの空き容量を確認し、もう一度お試しください。"

msgid "Couldn't export your library: it is locked. Unlock it, then try again."
msgstr "ライブラリをエクスポートできませんでした。ロックされています。ロックを解除して、もう一度お試しください。"

msgid "Couldn't export your library: the disk is full. Free up some space, then try again."
msgstr "ライブラリをエクスポートできませんでした。ディスクがいっぱいです。空き容量を確保して、もう一度お試しください。"

msgid "Couldn't export your library: the folder can't be written to. Check it isn't read-only or in use, then try again."
msgstr "ライブラリをエクスポートできませんでした。フォルダーに書き込めません。読み取り専用や使用中でないか確認して、もう一度お試しください。"

msgid "Couldn't import that."
msgstr "取り込めませんでした。"

msgid "Couldn't import that. Choose the file again, or try another one."
msgstr "取り込めませんでした。ファイルを選び直すか、別のファイルをお試しください。"

msgid "Couldn't import that: it isn't a file Snipdeck can read, or it is damaged. Choose a .snipdeck export."
msgstr "取り込めませんでした。Snipdeck で読み取れないファイルか、破損しています。.snipdeck のエクスポートファイルを選んでください。"

msgid "Couldn't import that: it was made by a newer Snipdeck. Update Snipdeck, then try again."
msgstr "取り込めませんでした。新しいバージョンの Snipdeck で作成されたファイルです。Snipdeck を更新して、もう一度お試しください。"

msgid "Couldn't import that: the disk is full. Free up some space, then try again."
msgstr "取り込めませんでした。ディスクがいっぱいです。空き容量を確保して、もう一度お試しください。"

msgid "Couldn't import that: the file is in use by another program or can't be read. Close the program using it, then try again."
msgstr "取り込めませんでした。ファイルが他のプログラムで使用中か、読み取れません。そのプログラムを閉じて、もう一度お試しください。"

msgid "Couldn't import that: your library is locked. Unlock it, then try again."
msgstr "取り込めませんでした。ライブラリがロックされています。ロックを解除して、もう一度お試しください。"

msgid "Couldn't make a backup. Check the disk has room, then use Back up now in Settings."
msgstr "バックアップを作成できませんでした。ディスクの空き容量を確認し、設定の「今すぐバックアップ」をお使いください。"

msgid "Couldn't make a backup: the backup file is in use or can't be written. Close other programs using your Snipdeck folder, then use Back up now in Settings."
msgstr "バックアップを作成できませんでした。バックアップファイルが使用中か、書き込めません。Snipdeck のフォルダーを使っている他のプログラムを閉じ、設定の「今すぐバックアップ」をお使いください。"

msgid "Couldn't make a backup: the disk is full. Free up some space, then use Back up now in Settings."
msgstr "バックアップを作成できませんでした。ディスクがいっぱいです。空き容量を確保し、設定の「今すぐバックアップ」をお使いください。"

msgid "Couldn't make a backup: your library is locked. Unlock it, then use Back up now in Settings."
msgstr "バックアップを作成できませんでした。ライブラリがロックされています。ロックを解除し、設定の「今すぐバックアップ」をお使いください。"

msgid "Couldn't make that change. Try again, or restart Snipdeck if it keeps happening."
msgstr "変更できませんでした。もう一度お試しください。繰り返す場合は Snipdeck を再起動してください。"

msgid "Couldn't make that change: the disk is full. Free up some space, then try again."
msgstr "変更できませんでした。ディスクがいっぱいです。空き容量を確保して、もう一度お試しください。"

msgid "Couldn't make that change: your library file is in use by another program. Close that program, then try again."
msgstr "変更できませんでした。ライブラリのファイルが他のプログラムで使用中です。そのプログラムを閉じて、もう一度お試しください。"

msgid "Couldn't make that change: your library is locked. Unlock it, then try again."
msgstr "変更できませんでした。ライブラリがロックされています。ロックを解除して、もう一度お試しください。"

msgid "Couldn't make today's backup. Check the disk has room, then use Back up now in Settings."
msgstr "今日のバックアップを作成できませんでした。ディスクの空き容量を確認し、設定の「今すぐバックアップ」をお使いください。"

msgid "Couldn't make today's backup: the backup file is in use or can't be written. Close other programs using your Snipdeck folder, then use Back up now in Settings."
msgstr "今日のバックアップを作成できませんでした。バックアップファイルが使用中か、書き込めません。Snipdeck のフォルダーを使っている他のプログラムを閉じ、設定の「今すぐバックアップ」をお使いください。"

msgid "Couldn't make today's backup: the disk is full. Free up some space, then use Back up now in Settings."
msgstr "今日のバックアップを作成できませんでした。ディスクがいっぱいです。空き容量を確保し、設定の「今すぐバックアップ」をお使いください。"

msgid "Couldn't open that window."
msgstr "そのウィンドウを開けませんでした。"

msgid "Couldn't open the encryption key. Nothing was saved."
msgstr "暗号化キーを開けませんでした。何も保存されていません。"

msgid "Couldn't open the folder."
msgstr "フォルダーを開けませんでした。"

msgid "Couldn't open the log folder."
msgstr "ログフォルダーを開けませんでした。"

msgid "Couldn't open this item."
msgstr "このスニペットを開けませんでした。"

msgid "Couldn't open your email app."
msgstr "メールアプリを開けませんでした。"

msgid "Couldn't reach the clipboard. Another app may be using it."
msgstr "クリップボードにアクセスできませんでした。別のアプリが使用中の可能性があります。"

msgid "Couldn't refresh the list on screen. Close and reopen the window to see the change."
msgstr "画面の一覧を更新できませんでした。変更を確認するには、ウィンドウを閉じてもう一度開いてください。"

msgid "Couldn't rename the tag."
msgstr "タグの名前を変更できませんでした。"

msgid "Couldn't reopen your library. Restart Snipdeck. Your files have not been changed."
msgstr "ライブラリを再び開けませんでした。Snipdeck を再起動してください。ファイルは変更されていません。"

msgid "Couldn't restore that backup. Choose another backup, or try again."
msgstr "バックアップを復元できませんでした。別のバックアップを選ぶか、もう一度お試しください。"

msgid "Couldn't restore that backup: a file is in use by another program. Close it, then try again."
msgstr "バックアップを復元できませんでした。ファイルが他のプログラムで使用中です。閉じてから、もう一度お試しください。"

msgid "Couldn't restore that backup: it isn't a Snipdeck backup, or it is damaged. Choose another backup."
msgstr "バックアップを復元できませんでした。Snipdeck のバックアップではないか、破損しています。別のバックアップを選んでください。"

msgid "Couldn't restore that backup: it was made by a newer Snipdeck. Update Snipdeck, then try again."
msgstr "バックアップを復元できませんでした。新しいバージョンの Snipdeck で作成されたものです。Snipdeck を更新して、もう一度お試しください。"

msgid "Couldn't restore that backup: the disk is full. Free up some space, then try again."
msgstr "バックアップを復元できませんでした。ディスクがいっぱいです。空き容量を確保して、もう一度お試しください。"

msgid "Couldn't restore that backup: your library is locked. Unlock it, then try again."
msgstr "バックアップを復元できませんでした。ライブラリがロックされています。ロックを解除して、もう一度お試しください。"

msgid "Couldn't save a draft of what you typed."
msgstr "入力中の内容の下書きを保存できませんでした。"

msgid "Couldn't save this item. Nothing was changed."
msgstr "このスニペットを保存できませんでした。何も変更されていません。"

msgid "Couldn't save your settings. Snipdeck will try again."
msgstr "設定を保存できませんでした。Snipdeck が再試行します。"

msgid "Couldn't start the screenshot tool."
msgstr "スクリーンショットのツールを起動できませんでした。"

msgid "Couldn't use this item. Try again, or restart Snipdeck if it keeps happening."
msgstr "このスニペットを使用できませんでした。もう一度お試しください。繰り返す場合は Snipdeck を再起動してください。"

msgid "Couldn't use this item: the disk is full. Free up some space, then try again."
msgstr "このスニペットを使用できませんでした。ディスクがいっぱいです。空き容量を確保して、もう一度お試しください。"

msgid "Couldn't use this item: your library file is in use by another program. Close that program, then try again."
msgstr "このスニペットを使用できませんでした。ライブラリのファイルが他のプログラムで使用中です。そのプログラムを閉じて、もう一度お試しください。"

msgid "Couldn't use this item: your library is locked. Unlock it, then try again."
msgstr "このスニペットを使用できませんでした。ライブラリがロックされています。ロックを解除して、もう一度お試しください。"

msgid "Couldn't write to your library. Check that the disk has room."
msgstr "ライブラリに書き込めませんでした。ディスクに空きがあるか確認してください。"

msgid "Create"
msgstr "作成"

msgid "Create (Enter)"
msgstr "作成 (Enter)"

msgid "Create item"
msgstr "項目を作成"

msgid "Ctrl+Shift+V"
msgstr "Ctrl+Shift+V"

msgid "Ctrl+V"
msgstr "Ctrl+V"

msgid "Current password"
msgstr "現在のパスワード"

msgid "Daily backups, a plain zip export, and your choice of theme."
msgstr "毎日のバックアップ、シンプルな zip エクスポート、テーマの選択。"

msgid "Dark"
msgstr "ダーク"

msgid "Database rebuilt: {} items restored, {} recovered."
msgstr "データベースを再構築しました。{} 件を復元、{} 件を回復しました。"

msgid "Database rebuilt: {} items restored. Newer items could not be read."
msgstr "データベースを再構築しました。{} 件を復元しました。新しい項目は読み取れませんでした。"

msgid "Date and time in a format you choose"
msgstr "任意の形式の日付と時刻"

msgid "Delete"
msgstr "削除"

msgid "Delete board"
msgstr "ボードを削除"

msgid "Delete board “{}”?"
msgstr "ボード「{}」を削除しますか?"

msgid "Delete board…"
msgstr "ボードを削除…"

msgid "Delete for good"
msgstr "完全に削除"

msgid "Delete for good?"
msgstr "完全に削除しますか？"

msgid "Delete for good…"
msgstr "完全に削除…"

msgid "Delete list"
msgstr "リストを削除"

msgid "Delete list “{}”?"
msgstr "リスト「{}」を削除しますか？"

msgid "Delete list…"
msgstr "リストを削除…"

msgid "Delete tag"
msgstr "タグを削除"

msgid "Delete tag {}"
msgstr "タグ {} を削除"

msgid "Delete tag “{}”?"
msgstr "タグ「{}」を削除しますか？"

msgid "Delete tag…"
msgstr "タグを削除…"

msgid "Delete this board?"
msgstr "このボードを削除しますか？"

msgid "Delete this list?"
msgstr "このリストを削除しますか？"

msgid "Delete this tag?"
